<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Download your own file from Firebase Console › Project settings › Your apps (iOS)
  and save it as Sismik/GoogleService-Info.plist (git-ignored).
  Kendi dosyanızı Firebase Console › Proje ayarları › Uygulamalarınız (iOS) bölümünden
  indirip Sismik/GoogleService-Info.plist olarak kaydedin (git tarafından yok sayılır).
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_FIREBASE_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.example.sismik</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
