    "detailmap.aftershocks.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana depremden sonra %lld km'lik artçı alanında kaydedilenler; aynı depremin ajans kopyaları bir kez sayılır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded in the %lld km aftershock zone after the mainshock; agency copies of the same quake count once."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Hauptbeben im %lld-km-Nachbebenbereich erfasst; Kopien verschiedener Dienste zählen einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registradas en la zona de réplicas de %lld km tras el sismo principal; las copias de distintas agencias cuentan una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrées dans la zone de répliques de %lld km après le choc principal ; les copies d'agences comptent une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrate nell'area di repliche di %lld km dopo la scossa principale; le copie delle agenzie contano una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本震後、%lld km の余震域で記録された地震。機関ごとの重複は1回として数えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зафиксированы в зоне афтершоков %lld км после основного толчка; копии разных служб считаются один раз."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسجَّلة ضمن نطاق الهزات الارتدادية البالغ %lld كم بعد الزلزال الرئيسي؛ تُحتسب نسخ الوكالات مرة واحدة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταγεγραμμένοι στη ζώνη μετασεισμών %lld km μετά τον κύριο σεισμό· τα αντίγραφα υπηρεσιών μετρούν μία φορά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registradas na zona de réplicas de %lld km após o terremoto principal; cópias de agências contam uma vez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tercatat di zona gempa susulan %lld km setelah gempa utama; salinan dari lembaga berbeda dihitung sekali."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본진 이후 %lld km 여진 구역에서 기록된 지진. 기관별 중복은 한 번만 셉니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主震后在 %lld 公里余震区内记录的地震；各机构的重复记录只计一次。"
          }
        }
      }
    },
    "detailmap.aftershocks.info" : {
