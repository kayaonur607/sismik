    "places.editor.mapFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب الخريطة لتحديد المركز، واستخدم شريط التمرير لتحديد نصف القطر. تبتعد الخريطة كلما زاد نصف القطر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe die Karte, um das Zentrum festzulegen, und nutze den Schieberegler für den Radius. Wenn der Radius vergrößert wird, zoomt die Karte heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan the map to set the center, and use the slider to set the radius. The map zooms out as the radius increases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el mapa para fijar el centro y usa el deslizador para el radio. El mapa se aleja a medida que el radio aumenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la carte pour définir le centre et utilisez le curseur pour le rayon. La carte zoome en arrière à mesure que le rayon augmente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la mappa per impostare il centro e usa lo slider per il raggio. La mappa si allontana all'aumentare del raggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップを移動して中心を設定し、スライダーで半径を指定します。半径が大きくなるとマップがズームアウトします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте карту, чтобы задать центр, и используйте ползунок для радиуса. Карта отдаляется по мере увеличения радиуса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritayı kaydırarak merkezi, kaydırıcıyla yarıçapı belirle. Yarıçap büyüdükçe harita geri çekilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακίνησε τον χάρτη για να ορίσεις το κέντρο και χρησιμοποίησε το ρυθμιστικό για την ακτίνα. Ο χάρτης απομακρύνεται όσο μεγαλώνει η ακτίνα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o mapa para definir o centro e use o controle deslizante para o raio. O mapa se afasta conforme o raio aumenta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser peta untuk menentukan pusat, dan gunakan penggeser untuk radius. Peta memperkecil saat radius bertambah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도를 움직여 중심을 정하고 슬라이더로 반경을 정하세요. 반경이 커지면 지도가 축소됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动地图设定中心，用滑块设定半径。半径增大时地图会缩小。"
          }
        }
      }
    },
