    "safety.after.exit.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد توقف الهزة، غادر بهدوء عبر السلالم (لا تستخدم المصعد أبداً)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlassen Sie das Gebäude nach dem Beben ruhig über die Treppe (kein Aufzug)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the shaking ends, calmly move to an open area without using the elevator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando termine la sacudida, baja por las escaleras hacia un área despejada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez le bâtiment calmement par les escaliers (jamais d'ascenseur)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A scosse terminate, esci con calma usando le scale (mai l'ascensore)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揺れが収まったら慌てず階段を使って屋外の安全な場所へ（エレベーター使用厳禁）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После толчков спокойно выходите по лестнице (не пользуйтесь лифтом)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarsıntı bitince asansörü kullanmadan, sakin şekilde açık alana çık."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν σταματήσει η δόνηση, πήγαινε ήρεμα σε ανοιχτό χώρο χωρίς να χρησιμοποιήσεις ασανσέρ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o tremor parar, vá com calma para uma área aberta sem usar o elevador."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat guncangan berhenti, pindahlah dengan tenang ke area terbuka tanpa memakai lift."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흔들림이 멈추면 엘리베이터를 쓰지 말고 침착하게 넓은 곳으로 이동하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "震动停止后，不要乘电梯，冷静地前往空旷地带。"
          }
        }
      }
    },
