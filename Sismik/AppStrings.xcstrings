    "If you see damage, smell gas, or receive an official evacuation instruction, follow local authorities." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لاحظت أضرارًا أو شممت رائحة غاز أو تلقيت أمر إخلاء رسمي، فاتبع تعليمات السلطات المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Schäden siehst, Gas riechst oder eine offizielle Evakuierungsanweisung erhältst, folge den örtlichen Behörden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you see damage, smell gas, or receive an official evacuation instruction, follow local authorities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ves daños, hueles gas o recibes una orden oficial de evacuación, sigue las indicaciones de las autoridades locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu constates des dégâts, sens du gaz ou reçois un ordre d'évacuation officiel, suis les consignes des autorités locales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vedi danni, senti odore di gas o ricevi un ordine ufficiale di evacuazione, segui le indicazioni delle autorità locali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "損傷が見られる、ガスのにおいがする、または公式の避難指示が出た場合は、地元当局の指示に従ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы видите повреждения, чувствуете запах газа или получили официальное указание об эвакуации, следуйте указаниям местных властей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasar görüyorsan, gaz kokusu alıyorsan veya resmî tahliye çağrısı varsa yerel yetkililerin yönlendirmesini izle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεις ζημιές, μυρίσεις αέριο ή λάβεις επίσημη εντολή εκκένωσης, ακολούθησε τις τοπικές αρχές."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vir danos, sentir cheiro de gás ou receber uma ordem oficial de evacuação, siga as autoridades locais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika melihat kerusakan, mencium bau gas, atau menerima perintah evakuasi resmi, ikuti arahan otoritas setempat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피해가 보이거나 가스 냄새가 나거나 공식 대피 지시를 받으면 현지 당국의 안내를 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若看到损坏、闻到燃气味或收到官方疏散指令，请听从当地政府安排。"
          }
        }
      }
    },
