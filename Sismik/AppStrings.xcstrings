    "ob2.alerts.critical.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزلزال الذي يتجاوز عتبتك يتخطى الوضع الصامت بصوت الإنذار الذي تختاره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Beben über deiner Schwelle umgeht den Stummmodus mit dem Alarmton deiner Wahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quake above your threshold breaks through silent mode with the alarm sound you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sismo por encima de tu umbral ignora el modo silencio con el sonido que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un séisme au-dessus de votre seuil passe outre le silencieux avec l'alarme choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terremoto oltre la tua soglia supera il silenzioso con l'allarme che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しきい値を超える地震は、選んだアラーム音で消音モードを越えて鳴ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Землетрясение выше порога звучит даже в бесшумном режиме выбранным сигналом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirlediğin eşiği aşan deprem sessiz modu aşar ve seçtiğin alarm sesiyle çalar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας σεισμός πάνω από το όριό σου παρακάμπτει τη σίγαση με τον ήχο συναγερμού που επιλέγεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um terremoto acima do seu limite ignora o modo silencioso com o alarme que você escolher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gempa di atas ambang batasmu menembus mode senyap dengan suara alarm pilihanmu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기준을 넘는 지진은 선택한 알람 소리로 무음 모드를 뚫고 울립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过你设定阈值的地震会以你选择的警报声突破静音模式。"
          }
        }
      }
    },
