    "detail.noticeText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق Sismik ليس نظام إنذار مبكر. في حالات الطوارئ حافظ على هدوئك وتواصل مع فرق الإنقاذ للطوارئ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik ist kein Frühwarnsystem. Bleiben Sie im Notfall ruhig und wenden Sie sich an die Notfalldienste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik is not an early warning system. In case of emergency, please stay calm and contact 112 Emergency Call Center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik no es un sistema de alerta temprana. En caso de emergencia, mantén la calma y contacta a los servicios de emergencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik n'est pas un système d'alerte précoce. En cas d'urgence, restez calme et contactez les secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik non è un sistema di allarme rapido. In caso di emergenza, mantieni la calma e contatta i soccorsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismikは緊急地震速報ではありません。緊急時は慌てず身を守り、公的救急機関へ通報してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik не является системой раннего предупреждения. В экстренной ситуации сохраняйте спокойствие и обратитесь в службу спасения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik bir erken uyarı sistemi değildir. Acil durumlarda lütfen sakin kalarak 112 Acil Çağrı Merkezi ile iletişime geçin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sismik δεν είναι σύστημα έγκαιρης προειδοποίησης. Σε έκτακτη ανάγκη, μείνε ψύχραιμος και κάλεσε το 112."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sismik não é um sistema de alerta antecipado. Em emergência, mantenha a calma e ligue para o 112."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik bukan sistem peringatan dini. Dalam keadaan darurat, tetap tenang dan hubungi 112."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik은 조기 경보 시스템이 아닙니다. 비상시에는 침착하게 112 긴급 센터에 연락하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik 不是地震预警系统。紧急情况下请保持冷静并拨打 112。"
          }
        }
      }
    },
