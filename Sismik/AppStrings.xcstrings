    "paywall.demo.digest.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقع هذا الأسبوع 12 زلزالًا قرب أماكنك. الأقوى: M3.4 على بعد 38 كم من العائلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Woche 12 Erdbeben nahe deinen Orten. Das stärkste: M3,4, 38 km von Familie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 earthquakes near your saved places this week. Largest: M3.4, 38 km from Family."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta semana hubo 12 sismos cerca de tus lugares. El mayor: M3,4, a 38 km de Familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 séismes près de vos lieux cette semaine. Le plus fort : M3,4, à 38 km de Famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 terremoti vicino ai tuoi luoghi questa settimana. Il più forte: M3,4, a 38 km da Famiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週、登録した場所の近くで12回の地震。最大はM3.4、実家から38 km。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этой неделе рядом с вашими местами: 12 землетрясений. Сильнейшее: M3,4, 38 км от «Семья»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı yerlerinin yakınında bu hafta 12 deprem oldu. En büyüğü M3.4, Annemler yerine 38 km."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 σεισμοί κοντά στις τοποθεσίες σου αυτή την εβδομάδα. Μεγαλύτερος: M3,4, 38 km από Οικογένεια."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 terremotos perto dos seus lugares esta semana. Maior: M3,4, a 38 km de Família."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 gempa di dekat tempatmu minggu ini. Terbesar: M3,4, 38 km dari Keluarga."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 저장한 장소 근처에서 지진 12회. 최대: M3.4, 가족에서 38 km."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本周你保存的地点附近发生 12 次地震。最大：M3.4，距家人 38 公里。"
