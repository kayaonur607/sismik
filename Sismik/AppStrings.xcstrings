    "ob3.welcome.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dünyadaki depremleri resmî ajanslardan anında gör, yerlerin için doğru bildirimi al ve o an ne yapacağını bil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See quakes worldwide from official agencies the moment they're published, get the right alerts for your places and know what to do in the moment."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh Erdbeben weltweit sofort von offiziellen Stellen, erhalte passende Warnungen für deine Orte und wisse im Ernstfall, was zu tun ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve los sismos del mundo al instante desde agencias oficiales, recibe las alertas justas para tus lugares y sabe qué hacer en ese momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois les séismes du monde entier dès leur publication par les agences officielles, reçois les bonnes alertes pour tes lieux et sache quoi faire sur le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi subito i terremoti nel mondo dalle agenzie ufficiali, ricevi gli avvisi giusti per i tuoi luoghi e sai cosa fare in quel momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界の地震を公式機関の発表と同時に確認し、あなたの場所に合った通知を受け取り、その瞬間に何をすべきかがわかります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите землетрясения по всему миру сразу от официальных агентств, получайте точные уведомления для своих мест и знайте, что делать в этот момент."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد زلازل العالم فور نشرها من الوكالات الرسمية، واحصل على التنبيهات المناسبة لأماكنك، واعرف ما يجب فعله في تلك اللحظة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες τους σεισμούς παγκοσμίως από επίσημους φορείς μόλις δημοσιευτούν, λάβε τις σωστές ειδοποιήσεις για τα μέρη σου και μάθε τι να κάνεις εκείνη τη στιγμή."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja terremotos do mundo todo assim que as agências oficiais publicam, receba os alertas certos para seus lugares e saiba o que fazer na hora."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat gempa di seluruh dunia langsung dari lembaga resmi, dapatkan peringatan yang tepat untuk tempatmu, dan tahu apa yang harus dilakukan saat itu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전 세계 지진을 공식 기관 발표 즉시 확인하고, 내 장소에 맞는 알림을 받고, 그 순간 무엇을 해야 할지 알 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一时间查看官方机构发布的全球地震，为你的地点获取准确提醒，并知道当下该做什么。"
          }
        }
      }
    },
