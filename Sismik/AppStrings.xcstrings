    "places.felt.level.3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evde, özellikle üst katlarda bazı kişiler hisseder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felt by some people indoors, especially on upper floors."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
