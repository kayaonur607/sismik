        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύνοψη της τρέχουσας σεισμικής δραστηριότητας σε %@ με επιστημονικές παραμέτρους."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuma a atividade sísmica atual em %@ com parâmetros científicos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
