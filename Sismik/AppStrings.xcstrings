    "Konumunu acil durum ekipleriyle paylaşabilmek için iOS Ayarlar'dan Sismik'e izin vermelisin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمشاركة موقعك مع فرق الطوارئ، يجب عليك السماح لـ Sismik من إعدادات iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Ihren Standort mit Rettungskräften zu teilen, müssen Sie Sismik in den iOS-Einstellungen zulassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant location permission to Sismik in iOS Settings to share coordinates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para compartir tu ubicación con los equipos de emergencia, debes permitir el acceso a Sismik en los Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour partager votre position avec les équipes de secours, vous devez autoriser Sismik dans les Réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per condividere la tua posizione con i soccorritori, devi autorizzare Sismik nelle Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急救助隊と位置情報を共有するには、iOSの設定からSismikへのアクセスを許可する必要があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы поделиться своей геопозицией со спасательными службами, необходимо разрешить доступ приложению Sismik в настройках iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunu acil durum ekipleriyle paylaşabilmek için iOS Ayarlar'dan Sismik'e izin vermelisin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε άδεια τοποθεσίας στο Sismik στις Ρυθμίσεις του iOS για να μοιραστείς συντεταγμένες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda permissão de localização ao Sismik nos Ajustes do iOS para compartilhar coordenadas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan izin lokasi ke Sismik di Pengaturan iOS untuk membagikan koordinat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌표를 공유하려면 iOS 설정에서 Sismik에 위치 권한을 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iOS 设置中授予 Sismik 定位权限以分享坐标。"
          }
        }
      }
    },
