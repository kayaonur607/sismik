    "MMI published by %@ or a verified USGS ShakeMap is shown for this event. No estimate is derived from location, distance, or magnitude." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض MMI المنشورة بواسطة %@ أو ShakeMap معتمدة من USGS لهذا الحدث. لا يتم استنتاج أي تقدير من الموقع أو المسافة أو القوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Ereignis wird die von %@ oder einer verifizierten USGS ShakeMap veröffentlichte MMI angezeigt. Es wird keine Schätzung aus Standort, Entfernung oder Stärke abgeleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MMI published by %@ or a verified USGS ShakeMap is shown for this event. No estimate is derived from location, distance, or magnitude."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra la MMI publicada por %@ o un ShakeMap verificado del USGS para este evento. No se deriva ninguna estimación de la ubicación, distancia o magnitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intensité MMI publiée par %@ ou un ShakeMap vérifié de l'USGS est affichée pour cet événement. Aucune estimation n'est calculée à partir de l'emplacement, de la distance ou de la magnitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questo evento viene mostrata la MMI pubblicata da %@ o uno ShakeMap USGS verificato. Nessuna stima viene ricavata da posizione, distanza o magnitudo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この地震には%@または検証済みのUSGS ShakeMapにより公開されたMMIが表示されます。位置、距離、規模からの推定値は作成されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого события отображается MMI, опубликованная %@ или проверенной USGS ShakeMap. Оценка по местоположению, расстоянию или магнитуде не производится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu olay için %@ veya doğrulanmış USGS ShakeMap tarafından yayımlanan MMI gösterilir. Konum, uzaklık veya büyüklükten tahmin üretilmez."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για αυτό το συμβάν εμφανίζεται MMI από %@ ή από επαληθευμένο USGS ShakeMap. Δεν γίνεται εκτίμηση από τοποθεσία, απόσταση ή μέγεθος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para este evento é mostrado o MMI publicado por %@ ou por um ShakeMap verificado do USGS. Não há estimativa a partir de local, distância ou magnitude."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk kejadian ini ditampilkan MMI dari %@ atau ShakeMap USGS terverifikasi. Tidak ada perkiraan dari lokasi, jarak, atau magnitudo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이벤트에는 %@ 또는 검증된 USGS ShakeMap이 발표한 MMI를 표시합니다. 위치, 거리, 규모로 추정하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此事件显示 %@ 或经验证的 USGS ShakeMap 发布的 MMI，不根据位置、距离或震级推算。"
          }
        }
      }
    },
