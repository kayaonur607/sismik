    "Cihazın Konum Servisleri kapalı. Ayarlar > Gizlilik ve Güvenlik > Konum Servisleri'nden açabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمات الموقع بالجهاز مغلقة. يمكنك تفعيلها من الإعدادات > الخصوصية والأمن > خدمات الموقع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ortungsdienste des Geräts sind deaktiviert. Sie können sie unter Einstellungen > Datenschutz & Sicherheit > Ortungsdienste aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location Services are disabled. Turn them on in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios de localización del dispositivo están desactivados. Puedes activarlos en Ajustes > Privacidad y seguridad > Localización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les services de localisation de l'appareil sont désactivés. Vous pouvez les activer dans Réglages > Confidentialité et sécurité > Service de localisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi di localizzazione del dispositivo sono disattivati. Puoi attivarli in Impostazioni > Privacy e sicurezza > Localizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの位置情報サービスがオフになっています。「設定」>「プライバシーとセキュリティ」>「位置情報サービス」からオンにできます。"
          }
