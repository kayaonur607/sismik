    "premiumPreview.map.feature.density.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depremlerin kümelendiği bölgeleri ısı katmanıyla gör; en hareketli yerler bir bakışta"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See where earthquakes cluster with a heat layer; the most active areas at a glance"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh mit einer Wärmeebene, wo sich Erdbeben häufen – die aktivsten Gebiete auf einen Blick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve con una capa de calor dónde se agrupan los terremotos; las zonas más activas de un vistazo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois où les séismes se concentrent grâce à une couche de chaleur ; les zones les plus actives en un coup d'œil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi dove si concentrano i terremoti con un livello di calore; le zone più attive a colpo d'occhio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒートレイヤーで地震が集中する地域を表示。最も活発な場所がひと目でわかります"
