    "places.teaser.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات فورية للمنزل أو العمل أو مدينة العائلة، بنصف قطر وعتبة قوة مخصصة لكل مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofortige Benachrichtigungen für Zuhause, Arbeit oder den Wohnort der Familie – jeweils mit individuellem Radius und Magnitude-Schwellenwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instant notifications for home, work, or family locations, each with custom radius and magnitude thresholds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificaciones instantáneas para el hogar, el trabajo o la ciudad de tu familia, con un radio y umbral de magnitud personalizados para cada lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications instantanées pour la maison, le travail ou la ville de votre famille, avec un rayon et un seuil de magnitude personnalisés pour chaque lieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifiche istantanee per casa, lavoro o la città della tua famiglia, con raggio e soglia di magnitudo personalizzati per ciascun luogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅、職場、ご家族の街など、場所ごとに設定した半径とマグニチュードの閾値で即座に通知。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мгновенные уведомления для дома, работы или города вашей семьи — с индивидуальным радиусом и порогом магнитуды для каждого места."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev, iş ya da ailenin bulunduğu şehir; her yer için ayrı yarıçap ve büyüklük eşiğiyle anında bildirim."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άμεσες ειδοποιήσεις για σπίτι, δουλειά ή οικογένεια, με δική τους ακτίνα και όριο μεγέθους."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificações instantâneas para casa, trabalho ou família, cada uma com raio e limite de magnitude próprios."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi instan untuk rumah, kantor, atau keluarga, masing-masing dengan radius dan ambang magnitudo sendiri."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집, 직장, 가족 위치별로 반경과 규모 기준을 정해 즉시 알림."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为家、工作地点或家人所在地提供即时通知，各有独立的半径和震级阈值。"
          }
        }
      }
    },
