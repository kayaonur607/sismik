    "ob2.list.response.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد زلزال قوي قريب يفتح التطبيق على الاتصال بالطوارئ ومنطقة التجمع وقائمة المهام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem starken Beben in der Nähe öffnet die App mit Notruf, Sammelplatz und Checkliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a strong quake nearby, the app opens with emergency call, assembly area and a checklist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un sismo fuerte cerca, la app abre con llamada de emergencia, punto de encuentro y lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un fort séisme proche, l'app s'ouvre sur l'appel d'urgence, le point de rassemblement et une liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un forte terremoto vicino, l'app si apre con chiamata d'emergenza, area di raccolta e checklist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くで強い地震があると、緊急通報・避難場所・やることリストの画面で開きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сильного землетрясения рядом приложение открывается с вызовом, пунктом сбора и списком дел."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınında güçlü deprem olursa uygulama 112, toplanma alanı ve yapılacaklarla açılır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από ισχυρό σεισμό κοντά σου, η εφαρμογή ανοίγει με κλήση έκτακτης ανάγκης, χώρο συγκέντρωσης και λίστα ενεργειών."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após um terremoto forte por perto, o app abre com chamada de emergência, ponto de encontro e uma lista de tarefas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah gempa kuat di dekatmu, aplikasi terbuka dengan panggilan darurat, titik kumpul, dan daftar tindakan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처에서 강한 지진이 나면 앱이 긴급 전화, 대피 장소, 체크리스트 화면으로 열립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附近发生强震后，应用会以紧急电话、集合点和清单页面打开。"
          }
        }
      }
    },
