        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkar–Bommer 감쇠 모델로 진원 깊이와 거리에 따라 추정한 지반 운동입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
