    "intro.tracking.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أين ومتى\nوبأي مقدار؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo, wann\nund wie stark?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where, when\nand how large?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde, cuándo\ny de qué magnitud?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où, quand\net quelle magnitude ?"
