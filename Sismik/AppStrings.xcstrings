            "value" : "Экстренная помощь"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acil durum"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έκτακτη ανάγκη"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergência"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darurat"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧急"
          }
        }
      }
    },
    "ob2.emergency.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل حتى عند انقطاع الشبكة. استعد الآن، فلن يكون هناك وقت للبحث لحظتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert auch ohne Netz. Bereite dich jetzt vor – im Ernstfall fehlt die Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works even when networks fail. Get ready now — there's no time to search in the moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona aunque caiga la red. Prepárate ahora: en el momento no habrá tiempo de buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne même sans réseau. Préparez-vous maintenant : sur le moment, pas le temps de chercher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona anche senza rete. Preparati ora: sul momento non c'è tempo per cercare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回線が落ちても動きます。今のうちに準備を。その時に探す時間はありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает даже без сети. Подготовьтесь сейчас — в момент беды искать будет некогда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şebeke çökse de çalışır. Hazırlığını şimdi yap; o an arayacak vaktin olmaz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λειτουργεί ακόμη κι όταν πέφτουν τα δίκτυα. Ετοιμάσου τώρα — εκείνη τη στιγμή δεν θα υπάρχει χρόνος για ψάξιμο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona mesmo quando as redes caem. Prepare-se agora — na hora não dá tempo de procurar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap berfungsi saat jaringan putus. Bersiaplah sekarang — saat kejadian tak ada waktu untuk mencari."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통신망이 끊겨도 작동합니다. 지금 준비하세요. 그 순간엔 찾아볼 시간이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使网络中断也能使用。现在就做好准备——事发时没有时间查找。"
          }
        }
      }
    },
    "ob2.emergency.family.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقاط اللقاء وجهات الاتصال؛ «أنا بأمان» مع موقعك عبر رسائل SMS دون إنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treffpunkte und Kontakte; „Ich bin sicher“ mit Standort per SMS, ohne Internet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeting points and contacts; \"I'm safe\" with your location by SMS, no internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntos de encuentro y contactos; «Estoy a salvo» con ubicación por SMS, sin internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points de rendez-vous et contacts ; « Je suis en sécurité » avec position par SMS, sans internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punti di ritrovo e contatti; «Sono al sicuro» con posizione via SMS, senza internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合場所と連絡先。ネット不要のSMSで「無事です」と現在地を送信。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места встречи и контакты; «Я в безопасности» с координатами по SMS без интернета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buluşma noktaları ve kişiler; internetsiz SMS ile \"Güvendeyim\" ve konum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημεία συνάντησης και επαφές· «Είμαι ασφαλής» με την τοποθεσία σου μέσω SMS, χωρίς διαδίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontos de encontro e contatos; «Estou bem» com sua localização por SMS, sem internet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titik temu dan kontak; \"Saya aman\" beserta lokasimu lewat SMS, tanpa internet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만날 장소와 연락처. 인터넷 없이 SMS로 위치와 함께 \"무사해요\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合地点和联系人；无需网络，通过短信发送“我平安”及位置。"
          }
        }
      }
    },
