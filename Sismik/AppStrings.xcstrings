    },
    "rrsm.list.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسارع والسرعة هما أقصى حركة للمحطة في الاتجاه الأفقي. تم معالجة البيانات تلقائيًا وهي لأغراض إعلامية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschleunigung und Geschwindigkeit stellen die maximale horizontale Bewegung der Station dar. Die Daten werden automatisch verarbeitet und dienen zu Informationszwecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceleration and velocity represent the maximum horizontal movement of the station. Data is processed automatically and is for informational purposes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aceleración y la velocidad son el movimiento horizontal máximo de la estación. Los datos se procesan automáticamente y son de carácter informativo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accélération et la vitesse représentent le mouvement horizontal maximal de la station. Les données sont traitées automatiquement et sont fournies à titre informatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accelerazione e la velocità rappresentano il movimento orizzontale massimo della stazione. I dati sono elaborati automaticamente e hanno scopo informativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加速度と速度は、観測点の水平方向における最大の運動です。データは自動処理されており、情報提供を目的としています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускорение и скорость представляют собой максимальное движение станции в горизонтальном направлении. Данные обработаны автоматически и предназначены для справки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İvme ve hız, istasyonun yatay yöndeki en büyük hareketidir. Veriler otomatik işlenmiştir ve bilgi amaçlıdır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιτάχυνση και η ταχύτητα δείχνουν τη μέγιστη οριζόντια κίνηση του σταθμού. Τα δεδομένα επεξεργάζονται αυτόματα και είναι ενημερωτικά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceleração e velocidade representam o movimento horizontal máximo da estação. Os dados são processados automaticamente e servem apenas para informação."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percepatan dan kecepatan menunjukkan gerakan horizontal maksimum stasiun. Data diproses otomatis dan hanya untuk informasi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가속도와 속도는 관측소의 최대 수평 움직임을 나타냅니다. 데이터는 자동 처리되며 참고용입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加速度和速度表示台站的最大水平运动。数据为自动处理，仅供参考。"
          }
        }
      }
    },
    "rrsm.list.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل سطر هو محطة قياس سجلت الزلزال. القيم هي أقصى تسارع وسرعة للأرض قاستهما المحطة؛ وتختلف حتى في الزلزال نفسه وفقًا لبُعد المحطة ونوع التربة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile ist eine Messstation, die das Erdbeben aufgezeichnet hat. Die Werte sind die von der Station gemessene höchste Bodenbeschleunigung und -geschwindigkeit; sie variieren selbst beim selben Erdbeben je nach Entfernung der Station und Bodenbeschaffenheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each row is a measuring station that recorded the earthquake. Values are the peak ground acceleration and velocity measured by the station; even in the same earthquake, they vary based on the station's distance and soil conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila es una estación de medición que registró el sismo. Los valores son la aceleración y velocidad máximas del suelo medidas por la estación; varían incluso en el mismo sismo según la distancia de la estación y el terreno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne est une station de mesure ayant enregistré le séisme. Les valeurs sont l'accélération et la vitesse maximales du sol mesurées par la station ; elles varient même pour un même séisme selon la distance de la station et le sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga è una stazione di misurazione che ha registrato il terremoto. I valori sono l'accelerazione e la velocità massima del suolo misurate dalla stazione; variano anche nello stesso terremoto in base alla distanza della stazione e al terreno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各行は地震を記録した計測観測点です。数値は観測点が測定した最大地動加速度および速度であり、同じ地震であっても観測点の距離や地盤によって異なります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая строка — это измерительная станция, зарегистрировавшая землетрясение. Значения представляют собой пиковое ускорение и скорость грунта, измеренные станцией; даже при одном и том же землетрясении они различаются в зависимости от расстояния до станции и типа грунта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satır, depremi kaydeden bir ölçüm istasyonudur. Değerler istasyonun ölçtüğü en büyük yer ivmesi ve hızıdır; aynı depremde bile istasyonun uzaklığına ve zeminine göre değişir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε γραμμή είναι ένας σταθμός που κατέγραψε τον σεισμό. Οι τιμές είναι η μέγιστη επιτάχυνση και ταχύτητα εδάφους του σταθμού· ακόμη και στον ίδιο σεισμό διαφέρουν ανάλογα με την απόσταση και το έδαφος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha é uma estação que registrou o terremoto. Os valores são a aceleração e a velocidade máximas do solo medidas; mesmo no mesmo terremoto, variam conforme a distância e o solo da estação."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap baris adalah stasiun yang merekam gempa. Nilainya adalah percepatan dan kecepatan tanah puncak yang diukur stasiun; bahkan pada gempa yang sama, nilainya berbeda menurut jarak dan kondisi tanah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 행은 지진을 기록한 관측소입니다. 값은 관측소의 최대 지반 가속도와 속도이며, 같은 지진이라도 거리와 지반에 따라 다릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一行都是记录到此次地震的台站。数值为台站测得的峰值地面加速度和速度；即使是同一次地震，也会因台站距离和土层条件而不同。"
          }
        }
      }
    },
