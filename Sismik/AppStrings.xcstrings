    "stats.time.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل عمود يمثل عدد الزلازل في تلك الفترة، ولونه يدل على أقواها. اضغط على عمود للتفاصيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Balken zeigt die Anzahl der Beben; die Farbe das stärkste. Tippe auf einen Balken für Details."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each bar is the number of earthquakes in that slice; its color shows the largest one. Tap a bar for details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada barra es el número de sismos en ese tramo; su color indica el mayor. Toca una barra para ver detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque barre compte les séismes de la tranche ; sa couleur indique le plus fort. Touchez une barre pour le détail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni barra è il numero di terremoti nel periodo; il colore indica il più forte. Tocca una barra per i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各棒はその時間帯の地震の数、色は最大の地震を示します。棒をタップすると詳細を表示。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый столбец — число землетрясений за отрезок, цвет — сильнейшее из них. Нажмите на столбец для подробностей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her çubuk o dilimdeki deprem sayısı; rengi o dilimin en büyük depremini gösterir. Ayrıntı için çubuğa dokun."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε στήλη είναι ο αριθμός σεισμών στο διάστημα· το χρώμα δείχνει τον μεγαλύτερο. Πάτα μια στήλη για λεπτομέρειες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
