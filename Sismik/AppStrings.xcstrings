    "settings.criticalSound.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجاوز التنبيهات الحرجة الوضع الصامت ووضع التركيز، ولا تُشغَّل إلا عند العتبة الحرجة التي تحددها لمكان ما. اختر صوتًا يمكنك تمييزه عن التنبيهات العادية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritische Warnungen umgehen den Stumm- und Fokusmodus und ertönen nur ab der kritischen Schwelle, die du für einen Ort festlegst. Wähle einen Ton, den du von normalen Mitteilungen unterscheiden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critical alerts break through silent mode and Focus, and only play at the critical threshold you set for a place. Pick a sound you can tell apart from regular alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas críticas ignoran el modo silencio y los modos de concentración, y solo suenan en el umbral crítico que fijes para un lugar. Elige un sonido que distingas de las alertas normales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes critiques passent outre le mode silencieux et la concentration, et ne sonnent qu'au seuil critique défini pour un lieu. Choisissez un son distinct des alertes habituelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi critici superano il silenzioso e la modalità Full immersion e suonano solo alla soglia critica che imposti per un luogo. Scegli un suono distinguibile dagli avvisi normali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大な通知は消音モードや集中モードでも鳴り、場所ごとに設定した重大しきい値でのみ再生されます。通常の通知と聞き分けられる音を選んでください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Критические оповещения звучат даже в бесшумном режиме и режиме фокусирования — только при критическом пороге, заданном для места. Выберите звук, отличный от обычных уведомлений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritik uyarı sessiz modu ve Odak'ı aşar; yalnızca bir yer için belirlediğin kritik eşikte çalar. Olağan bildirimden ayırt edebileceğin bir ses seç."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κρίσιμες ειδοποιήσεις παρακάμπτουν τη σίγαση και την Εστίαση και ηχούν μόνο στο κρίσιμο όριο που ορίζεις για μια τοποθεσία. Διάλεξε ήχο που ξεχωρίζει από τις κανονικές."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertas críticos ignoram o modo silencioso e o Foco e só tocam no limite crítico definido para um lugar. Escolha um som que você diferencie dos alertas normais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan kritis menembus mode senyap dan Fokus, dan hanya berbunyi pada ambang kritis yang kamu tetapkan untuk suatu tempat. Pilih suara yang mudah dibedakan dari peringatan biasa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요 알림은 무음 모드와 집중 모드를 뚫고, 장소마다 정한 중요 기준에서만 울립니다. 일반 알림과 구별되는 소리를 고르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧急提醒会突破静音和专注模式，仅在你为地点设定的紧急阈值时响起。请选择与普通提醒易于区分的声音。"
          }
        }
      }
    },
