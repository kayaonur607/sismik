    "Estimated acceleration and velocity calculated using Akkar-Bommer attenuation model based on focal depth and distance." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقديرات التسارع والسرعة محسوبة بنموذج التوهين أكار-بومر استنادًا إلى عمق البؤرة والمسافة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzte Beschleunigungs- und Geschwindigkeitswerte, berechnet mit dem Akkar-Bommer-Abminderungsmodell auf Basis von Herdtiefe und Entfernung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated acceleration and velocity calculated using Akkar-Bommer attenuation model based on focal depth and distance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimaciones de aceleración y velocidad calculadas con el modelo de atenuación de Akkar-Bommer según la profundidad focal y la distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimations d'accélération et de vitesse calculées avec le modèle d'atténuation Akkar-Bommer selon la profondeur focale et la distance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stime di accelerazione e velocità calcolate con il modello di attenuazione Akkar-Bommer in base alla profondità focale e alla distanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "震源深さと震央距離をもとに、Akkar-Bommer の距離減衰式で算出した加速度・速度の推定値です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценки ускорения и скорости, рассчитанные по модели затухания Аккара — Боммера с учётом глубины очага и расстояния."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkar-Bommer sismolojik azalım modeli uyarınca odak derinliği ve merkez üssü mesafesine göre hesaplanan ivme ve hız tahminleridir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτιμώμενη επιτάχυνση και ταχύτητα με το μοντέλο εξασθένησης Akkar-Bommer, βάσει βάθους εστίας και απόστασης."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceleração e velocidade estimadas pelo modelo de atenuação Akkar-Bommer, com base na profundidade do foco e na distância."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percepatan dan kecepatan perkiraan dihitung dengan model atenuasi Akkar-Bommer berdasarkan kedalaman fokus dan jarak."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진원 깊이와 거리를 바탕으로 Akkar-Bommer 감쇠 모델로 계산한 추정 가속도와 속도."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于震源深度和距离，采用 Akkar-Bommer 衰减模型估算的加速度和速度。"
          }
        }
      }
