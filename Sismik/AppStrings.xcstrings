    "ob2.alerts.tsunami.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA, JMA ya da BMKG yerlerinden birine yakın bir tsunami uyarısı yayımlayınca hemen haber verir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notified as soon as NOAA, JMA or BMKG issues a tsunami warning near one of your places."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofortige Nachricht, sobald NOAA, JMA oder BMKG eine Tsunamiwarnung nahe einem deiner Orte herausgibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisa en cuanto la NOAA, la JMA o el BMKG emiten una alerta de tsunami cerca de uno de tus lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préviens-toi dès que la NOAA, la JMA ou le BMKG émet une alerte tsunami près de l'un de tes lieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa appena NOAA, JMA o BMKG emettono un'allerta tsunami vicino a uno dei tuoi luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA・気象庁・BMKG が登録地点の近くに津波警報を発表すると、すぐにお知らせします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщит сразу, как только NOAA, JMA или BMKG объявят угрозу цунами рядом с одним из ваших мест."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعلمك فور إصدار NOAA أو JMA أو BMKG تحذيرًا من تسونامي قرب أحد أماكنك."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειδοποιηθείτε μόλις η NOAA, η JMA ή το BMKG εκδώσει προειδοποίηση τσουνάμι κοντά σε κάποιο μέρος σας."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa assim que a NOAA, a JMA ou o BMKG emitem um alerta de tsunami perto de um dos seus lugares."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri tahu segera saat NOAA, JMA, atau BMKG mengeluarkan peringatan tsunami di dekat salah satu tempat Anda."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA·JMA·BMKG가 등록한 장소 근처에 쓰나미 경보를 발령하면 바로 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA、JMA 或 BMKG 在你的地点附近发布海啸警报时，立即通知你。"
          }
        }
      }
    },
