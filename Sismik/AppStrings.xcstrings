    "ob3.felt.card.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 km içinde M3.0+ ya da konumunda hissedilebilecek uzak M5.0+ depremler; kayıtlı yerlerin de sayılır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ within 30 km, or a distant M5.0+ likely felt where you are; your saved places count too."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ im Umkreis von 30 km oder ein fernes M5.0+, das bei dir spürbar ist; gespeicherte Orte zählen mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ a menos de 30 km, o un M5.0+ lejano que probablemente se sintió donde estás; tus lugares guardados también cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ à moins de 30 km, ou un M5.0+ lointain probablement ressenti chez toi ; tes lieux enregistrés comptent aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ entro 30 km, o un M5.0+ lontano probabilmente avvertito dove sei; valgono anche i luoghi salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 km 以内の M3.0 以上、または現在地で揺れを感じた可能性がある遠方の M5.0 以上。登録した場所も対象です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ в радиусе 30 км или далёкое M5.0+, вероятно ощутимое там, где вы; учитываются и сохранённые места."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زلزال M3.0+ ضمن 30 كم، أو M5.0+ بعيد يُرجَّح أنه أُحس حيث أنت؛ وتُحتسب أماكنك المحفوظة أيضًا."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ σε 30 χλμ. ή ένας μακρινός M5.0+ που πιθανόν έγινε αισθητός εκεί που είσαι· μετράνε και τα αποθηκευμένα μέρη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ a até 30 km, ou um M5.0+ distante provavelmente sentido onde você está; seus lugares salvos também contam."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3.0+ dalam 30 km, atau M5.0+ jauh yang kemungkinan terasa di lokasimu; tempat tersimpan juga dihitung."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30km 이내 M3.0 이상, 또는 내 위치에서 느꼈을 먼 곳의 M5.0 이상 지진. 저장한 장소도 포함됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 公里内 M3.0 以上，或你所在处可能有感的远处 M5.0 以上地震；已保存的地点同样计入。"
          }
        }
      }
    },
    "ob3.felt.card.title" : {
      "extractionState" : "manual",
      "localizations" : {
