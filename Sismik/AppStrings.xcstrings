    "premiumPreview.map.feature.places.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رؤية أماكنك المحفوظة ونطاقات الإشعارات على الخريطة؛ ومعرفة مدى قرب الزلزال منها بلمحة واحدة"
