        }
      }
    },
    "Sana en yakın toplanma alanlarını gösterebilmek için iOS Ayarlar'dan Sismik'e konum erişimi ver." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتتمكن من رؤية أقرب مناطق التجمع، امنح Sismik إذن الوصول إلى الموقع من إعدادات iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Ihnen die nächstgelegenen Sammelplätze anzuzeigen, erlauben Sie Sismik den Standortzugriff in den iOS-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Sismik to access your location in iOS Settings to show nearest assembly areas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrarte las zonas de evacuación más cercanas, permite el acceso a la ubicación de Sismik en los Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour afficher les zones de rassemblement les plus proches, autorisez l'accès à la localisation pour Sismik dans les Réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrarti le aree di raccolta più vicine, consenti l'accesso alla posizione a Sismik nelle Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最寄りの避難場所を表示するには、iOSの設定からSismikに位置情報へのアクセスを許可してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы показать ближайшие пункты сбора, разрешите Sismik доступ к геопозиции в настройках iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana en yakın toplanma alanlarını gösterebilmek için iOS Ayarlar'dan Sismik'e konum erişimi ver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε στο Sismik πρόσβαση στην τοποθεσία σου από τις Ρυθμίσεις του iOS για να δεις τους κοντινότερους χώρους συγκέντρωσης."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Sismik acesse sua localização nos Ajustes do iOS para mostrar os pontos de encontro mais próximos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Sismik mengakses lokasimu di Pengaturan iOS untuk menampilkan titik kumpul terdekat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까운 대피 장소를 보려면 iOS 설정에서 Sismik의 위치 접근을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iOS 设置中允许 Sismik 访问你的位置，以显示最近的集合点。"
          }
        }
      }
    },
