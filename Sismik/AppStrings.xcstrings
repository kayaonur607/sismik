    "notifications.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل الإشعارات فورًا بشأن الزلازل ضمن النطاق الذي اخترته. يلزم لذلك تفعيل هذا المفتاح وإذن إشعارات iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen treffen sofort für Erdbeben im ausgewählten Bereich ein. Dafür müssen dieser Schalter und die iOS-Mitteilungsberechtigung aktiviert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications arrive instantly for earthquakes within your selected scope. For this, this switch and iOS notification permission must be turned on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones llegan al instante para los terremotos dentro del alcance seleccionado. Para ello, este interruptor y el permiso de notificaciones de iOS deben estar activados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications arrivent instantanément pour les séismes situés dans le périmètre sélectionné. Pour cela, cet interrupteur et l'autorisation de notification iOS doivent être activés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche arrivano istantaneamente per i terremoti nell'ambito selezionato. A tal fine, questo interruttore e l'autorizzazione alle notifiche di iOS devono essere attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した範囲の地震に関する通知が即座に届きます。そのためには、このスイッチとiOSの通知許可がオンになっている必要があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления о землетрясениях в выбранном вами диапазоне приходят мгновенно. Для этого этот переключатель и разрешение на уведомления iOS должны быть включены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler seçtiğin kapsamdaki depremler için anında gelir. Bunun için bu anahtarın ve iOS bildirim izninin açık olması gerekir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις έρχονται αμέσως για σεισμούς εντός του εύρους που επέλεξες. Για αυτό πρέπει να είναι ενεργός ο διακόπτης και η άδεια ειδοποιήσεων του iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações chegam na hora para terremotos no escopo selecionado. Para isso, este botão e a permissão de notificações do iOS devem estar ativados."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi datang seketika untuk gempa dalam cakupan pilihanmu. Untuk itu, sakelar ini dan izin notifikasi iOS harus aktif."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 범위의 지진을 즉시 알려 드립니다. 이 스위치와 iOS 알림 권한이 켜져 있어야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选范围内的地震会即时通知你。需开启此开关以及 iOS 通知权限。"
          }
        }
      }
    },
    "notifications.permission.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بإشعارات Sismik في إعدادات iOS لتلقي التنبيهات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Sismik-Benachrichtigungen in den iOS-Einstellungen, um Warnungen zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Sismik notifications in iOS Settings to receive alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite notificaciones en los Ajustes de iOS para recibir alertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications Sismik dans les Réglages iOS pour recevoir des alertes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti le notifiche di Sismik nelle Impostazioni iOS per ricevere avvisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震アラートを受け取るには、iOSの設定でSismikの通知を許可してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите уведомления для Sismik в Настройках iOS, чтобы получать предупреждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim alabilmek için iOS Ayarlar'dan Sismik bildirimlerine izin ver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε τις ειδοποιήσεις του Sismik στις Ρυθμίσεις του iOS για να λαμβάνεις ειδοποιήσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita as notificações do Sismik nos Ajustes do iOS para receber alertas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan notifikasi Sismik di Pengaturan iOS untuk menerima peringatan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림을 받으려면 iOS 설정에서 Sismik 알림을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iOS 设置中允许 Sismik 通知以接收提醒。"
          }
        }
      }
    },
