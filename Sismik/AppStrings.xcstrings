    "places.editor.critical.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجاوز التنبيهات الحرجة الوضع الصامت ووضع التركيز. تُستخدم فقط للزلازل التي تساوي القوة التي تختارها لهذا المكان أو تزيد عليها، وتصل التنبيهات الأخرى بالصوت العادي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritische Hinweise umgehen Stummschaltung und Fokus. Sie gelten nur für Beben ab der Magnitude, die du für diesen Ort wählst; andere Warnungen nutzen den normalen Ton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critical alerts override silent mode and Focus. They are used only for quakes at or above the magnitude you choose for this place; other alerts use the normal sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas críticas ignoran el modo silencio y Concentración. Solo se usan para sismos iguales o mayores a la magnitud que elijas para este lugar; los demás avisos usan el sonido normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes critiques passent outre le mode silencieux et les modes de concentration. Elles ne servent qu’aux séismes égaux ou supérieurs à la magnitude choisie pour ce lieu ; les autres alertes utilisent le son normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi critici ignorano la modalità silenziosa e Full immersion. Si usano solo per sismi pari o superiori alla magnitudo scelta per questo luogo; gli altri avvisi usano il suono normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大な通知はマナーモードや集中モードを無視して鳴ります。この場所で選んだマグニチュード以上の地震にだけ使われ、ほかの通知は通常の音で届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экстренные оповещения обходят беззвучный режим и фокусирование. Они используются только для землетрясений не слабее выбранной для этого места магнитуды; остальные приходят с обычным звуком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritik uyarı sessiz modu ve Odak modlarını aşar. Yalnızca bu yerde, seçtiğin büyüklük ve üstündeki depremlerde kullanılır; diğer bildirimler normal sesle gelir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κρίσιμες ειδοποιήσεις παρακάμπτουν τη σίγαση και την Εστίαση. Χρησιμοποιούνται μόνο για σεισμούς ίσους ή μεγαλύτερους από το μέγεθος που επιλέγεις γι' αυτή την τοποθεσία· οι υπόλοιπες έχουν τον κανονικό ήχο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertas críticos ignoram o modo silencioso e o Foco. São usados só para terremotos iguais ou acima da magnitude escolhida para este lugar; os demais usam o som normal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan kritis menembus mode senyap dan Fokus. Hanya dipakai untuk gempa dengan magnitudo sama atau di atas pilihanmu untuk tempat ini; peringatan lain memakai suara biasa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요 알림은 무음 모드와 집중 모드를 무시합니다. 이 장소에 정한 규모 이상의 지진에만 쓰이고, 나머지는 일반 소리로 울립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧急提醒会突破静音和专注模式，仅用于达到或超过你为此地点设定震级的地震；其他提醒使用普通提示音。"
          }
        }
      }
    },
    "places.editor.critical.permission" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُمنح إذن التنبيهات الحرجة، لذا تصل هذه التنبيهات حاليًا بالصوت العادي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigung für kritische Hinweise fehlt, daher kommen diese Warnungen derzeit mit normalem Ton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critical alert permission isn’t granted, so these alerts currently use the normal sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha concedido el permiso de alertas críticas, así que por ahora estos avisos usan el sonido normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation des alertes critiques n’est pas accordée : ces alertes utilisent pour l’instant le son normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorizzazione agli avvisi critici non è concessa, quindi per ora questi avvisi usano il suono normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大な通知が許可されていないため、現在これらの通知は通常の音で届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение на экстренные оповещения не выдано, поэтому сейчас они приходят с обычным звуком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritik uyarı izni verilmediği için bu bildirimler şu an normal sesle gelir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει δοθεί άδεια κρίσιμων ειδοποιήσεων, οπότε προς το παρόν χρησιμοποιούν τον κανονικό ήχο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A permissão de alerta crítico não foi concedida, então esses alertas usam o som normal por enquanto."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin peringatan kritis belum diberikan, jadi peringatan ini sementara memakai suara biasa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요 알림 권한이 없어 지금은 일반 소리로 울립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未授予紧急提醒权限，因此这些提醒目前使用普通提示音。"
          }
        }
      }
    },
    "places.editor.critical.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند وقوع زلزال قوي هنا، يرن هاتفك حتى في الوضع الصامت"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem schweren Beben hier klingelt dein Telefon auch lautlos"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a major quake here, your phone rings even on silent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ante un sismo fuerte aquí, tu teléfono suena aunque esté en silencio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un fort séisme ici, votre téléphone sonne même en silencieux"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un forte sisma qui, il telefono suona anche in silenzioso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この場所で大きな地震があると、マナーモードでも音が鳴ります"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сильном землетрясении здесь телефон зазвонит даже в беззвучном режиме"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yerde büyük bir depremde telefon sessizdeyken de çalar"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μεγάλο σεισμό εδώ, το τηλέφωνο χτυπά ακόμη και στη σίγαση"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um grande terremoto aqui, seu telefone toca mesmo no silencioso"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk gempa besar di sini, ponselmu tetap berbunyi meski senyap"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳에 큰 지진이 나면 무음이어도 휴대폰이 울립니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处发生大地震时，即使静音手机也会响铃"
          }
        }
      }
    },
