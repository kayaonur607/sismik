    "places.section.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld أماكن. تصلك إشعارات بالزلازل داخل نطاق مكان مُفعّل وتتجاوز عتبته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld Orte. Du wirst über Erdbeben im Radius eines aktiven Ortes benachrichtigt, die dessen Schwelle erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld places. You are notified for earthquakes inside an active place’s radius that meet its threshold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld lugares. Recibes avisos de sismos dentro del radio de un lugar activo que superen su umbral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld lieux. Vous êtes alerté des séismes dans le rayon d’un lieu actif qui atteignent son seuil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld luoghi. Ricevi notifiche per i terremoti nel raggio di un luogo attivo che superano la sua soglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld 地点。有効な地点の半径内で、しきい値を超えた地震が通知されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld мест. Уведомления приходят о землетрясениях в радиусе активного места, превышающих его порог."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld yer. Bildirim, açık yerlerden birinin yarıçapına düşen ve o yerin eşiğini geçen depremler için gelir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld τοποθεσίες. Ειδοποιείσαι για σεισμούς εντός της ακτίνας μιας ενεργής τοποθεσίας που ξεπερνούν το όριό της."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld lugares. Você é avisado sobre terremotos dentro do raio de um lugar ativo que atinjam o limite dele."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld tempat. Kamu diberi tahu tentang gempa di dalam radius tempat aktif yang memenuhi ambang batasnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld 장소. 활성 장소의 반경 안에서 기준을 넘는 지진이 알림으로 옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld 个地点。在启用地点半径内且达到其阈值的地震会通知你。"
          }
        }
      }
    },
    "places.section.footer.free" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاناً: مكان واحد ونصف قطر حتى 50 كم. أماكن أكثر ومناطق أوسع مع Premium."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos: 1 Ort und bis zu 50 km Radius. Mehr Orte und größere Bereiche mit Premium."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free plan includes 1 place and up to 50 km radius. More places and wider areas come with Premium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis: 1 lugar y hasta 50 km de radio. Más lugares y áreas más amplias con Premium."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit : 1 lieu et jusqu’à 50 km de rayon. Plus de lieux et des zones plus larges avec Premium."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis: 1 luogo e raggio fino a 50 km. Più luoghi e aree più ampie con Premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランは1か所・半径50 kmまで。複数の場所と広い範囲はプレミアムで。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно: 1 место и радиус до 50 км. Больше мест и шире зона — в Premium."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz planda 1 yer ve 50 km'ye kadar yarıçap. Daha fazla yer ve geniş alan Premium'da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δωρεάν πλάνο περιλαμβάνει 1 τοποθεσία και ακτίνα έως 50 km. Περισσότερες τοποθεσίες και μεγαλύτερες περιοχές με το Premium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano grátis inclui 1 lugar e raio de até 50 km. Mais lugares e áreas maiores com o Premium."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket gratis mencakup 1 tempat dan radius hingga 50 km. Lebih banyak tempat dan area lebih luas dengan Premium."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 요금제는 장소 1곳, 반경 최대 50 km입니다. 더 많은 장소와 넓은 범위는 Premium에서."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费方案包含 1 个地点、最大 50 公里半径。Premium 可添加更多地点和更大范围。"
          }
        }
      }
    },
