    "favorites.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ المفضلة على جهازك. تفتح حتى عند انهيار الشبكة؛ يمكن استخدام البوصلة للحصول على الاتجاهات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriten werden auf deinem Gerät gespeichert. Sie öffnen sich auch bei Netzausfall; der Kompass kann zur Navigation verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorites are kept on your device. They open even when the network is down; the compass can guide you there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los favoritos se guardan en tu dispositivo. Se abren incluso si la red se cae; se puede usar la brújula para obtener indicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris sont enregistrés sur votre appareil. Ils s'ouvrent même en cas de panne de réseau ; la boussole peut être utilisée pour la navigation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preferiti vengono salvati sul tuo dispositivo. Si aprono anche in caso di guasto della rete; la bussola può essere usata per le indicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りはデバイスに保存されます。ネットワークが停止しても開くことができ、方位磁針を使って経路案内を行えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избранное сохраняется на вашем устройстве. Доступно даже при сбое сети; компас можно использовать для навигации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriler cihazında saklanır. Şebeke çöktüğünde bile açılır; yol tarifi için pusula kullanılabilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αγαπημένα αποθηκεύονται στη συσκευή σου. Ανοίγουν ακόμη και χωρίς δίκτυο· η πυξίδα μπορεί να σε οδηγήσει."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os favoritos ficam no seu aparelho. Abrem mesmo sem rede; a bússola pode guiar você até lá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorit disimpan di perangkatmu. Tetap terbuka saat jaringan mati; kompas bisa memandumu ke sana."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기는 기기에 저장됩니다. 네트워크가 끊겨도 열리며 나침반이 길을 안내합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收藏保存在你的设备上。断网时也能打开，指南针可以带你前往。"
          }
        }
      }
    },
    "favorites.limit.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك حفظ ما يصل إلى %d من الأماكن كحد أقصى. أزل مكانًا من القائمة لإضافة مكان جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst maximal %d Orte speichern. Entferne einen Ort aus der Liste, um einen neuen hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can save up to %d places. Remove one to add another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes guardar un máximo de %d lugares. Elimina uno de la lista para añadir uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez enregistrer jusqu'à %d lieux. Supprimez-en un de la liste pour en ajouter un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi salvare un massimo di %d luoghi. Rimuovine uno dall'elenco per aggiungerne uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大 %d か所の場所を保存できます。新しい場所を追加するには、リストから 1 つ削除してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете сохранить не более %d мест. Удалите одно из списка, чтобы добавить новое."
