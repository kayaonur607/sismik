    "pi.confidence.high.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değer, istasyon ölçümlerini ve yer hareketi modelini birleştiren USGS ShakeMap şiddet ızgarasından alındı."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The value comes from the USGS ShakeMap intensity grid, which combines station records and ground-motion modeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wert stammt aus dem USGS-ShakeMap-Intensitätsraster, das Stationsdaten und Bodenbewegungsmodelle kombiniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor procede de la cuadrícula de intensidad de ShakeMap del USGS, que combina registros de estaciones y modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur provient de la grille d'intensité ShakeMap de l'USGS, qui combine mesures des stations et modélisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore proviene dalla griglia di intensità ShakeMap dell'USGS, che unisce misure delle stazioni e modelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値は観測点の記録と地盤モデルを組み合わせた USGS ShakeMap の震度グリッドによるものです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение взято из сетки интенсивности USGS ShakeMap, объединяющей данные станций и моделирование."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيمة مأخوذة من شبكة شدة USGS ShakeMap التي تجمع قياسات المحطات ونمذجة الحركة الأرضية."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τιμή προέρχεται από το πλέγμα έντασης USGS ShakeMap, που συνδυάζει μετρήσεις σταθμών και μοντελοποίηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor vem da grade de intensidade do ShakeMap do USGS, que combina registros de estações e modelagem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai berasal dari grid intensitas USGS ShakeMap yang menggabungkan rekaman stasiun dan pemodelan gerakan tanah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 관측소 기록과 지반 운동 모델을 결합한 USGS ShakeMap 진도 격자에서 가져왔어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该数值来自 USGS ShakeMap 烈度网格，融合了台站记录和地面运动模型。"
          }
        }
      }
    },
