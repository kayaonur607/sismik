    "intro.emergency.prepare.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "املأ بطاقة الطوارئ وراجع قائمة التحقق لحقيبة الطوارئ. لن يكون هناك وقت لفعل ذلك بعد وقوع الزلزال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fülle deine Notfallkarte aus und überprüfe die Notfallgepäck-Checkliste. Nach einem Erdbeben bleibt dafür keine Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill in your emergency card and go through the go-bag checklist. There's no time for that after a quake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa tu tarjeta de emergencia y revisa la lista de verificación de la mochila. No habrá tiempo para hacer esto después de un terremoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplissez votre fiche d'urgence et vérifiez la liste de contrôle du sac. Il n'y aura plus le temps de le faire après un séisme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila la tua scheda di emergenza e controlla la lista di verifica dello zaino. Non ci sarà tempo per farlo dopo un terremoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急カードを記入し、防災バッグのチェックリストを確認しましょう。地震発生後にこれらを行う時間はありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполните карточку экстренной помощи и проверьте чек-лист тревожного чемоданчика. После землетрясения на это не будет времени."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acil durum kartını doldur, çanta kontrol listesini gözden geçir. Bunları depremden sonra yapmak için vakit olmaz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπλήρωσε την κάρτα έκτακτης ανάγκης και έλεγξε τη λίστα του σακιδίου. Μετά τον σεισμό δεν θα υπάρχει χρόνος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preencha seu cartão de emergência e revise a lista do kit. Depois de um terremoto não haverá tempo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi kartu daruratmu dan periksa daftar tas siaga. Setelah gempa tidak akan ada waktu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비상 카드를 작성하고 대비 가방 목록을 점검하세요. 지진 후에는 그럴 시간이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写紧急信息卡并检查应急包清单。地震发生后就没有时间了。"
          }
        }
      }
    },
    "intro.emergency.prepare.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعد مسبقًا"
          }
        },
        "de" : {
          "stringUnit" : {
