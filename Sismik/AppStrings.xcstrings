    "safety.during.drop.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزل على ركبتيك أرضاً؛ احتمِ تحت طاولة متينة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehen Sie auf die Knie; schützen Sie sich unter einem stabilen Tisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop to the ground where you are; get under or next to a sturdy table."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tírate al suelo de rodillas; cúbrete bajo una mesa resistente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-vous à genoux ; abritez-vous sous une table solide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettiti a terra carponi; riparati sotto un tavolo robusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体勢を低くし、丈夫な机の下などに身を隠します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опуститесь на колени; спрячьтесь под прочным столом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olduğun yerde yere çök; sağlam bir masanın yanına veya altına geç."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πέσε στο έδαφος εκεί που βρίσκεσαι· μπες κάτω ή δίπλα σε γερό τραπέζι."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixe-se onde estiver; fique sob ou ao lado de uma mesa firme."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merunduk di tempatmu; berlindung di bawah atau di samping meja yang kokoh."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 자리에서 엎드려 튼튼한 탁자 아래나 옆으로 가세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就地趴下；躲到结实的桌子下面或旁边。"
          }
        }
      }
    },
