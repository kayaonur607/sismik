    "places.locked.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح كل مكان نطاقه وعتبته، ويصلك الإشعار باسمه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib jedem Ort eigenen Radius und Schwelle — die Benachrichtigung kommt mit seinem Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give each place its own radius and magnitude threshold, and get the notification by that place’s name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a cada lugar su radio y umbral, y recibe el aviso con su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à chaque lieu son rayon et son seuil, et recevez l’alerte à son nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai a ogni luogo raggio e soglia propri e ricevi la notifica col suo nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地点ごとに半径としきい値を設定し、その名前で通知を受け取れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте каждому месту свой радиус и порог — уведомление придёт с его названием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yere ayrı yarıçap ve büyüklük eşiği ver; o bölgede deprem olduğunda bildirim yerin adıyla gelsin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε σε κάθε τοποθεσία δική της ακτίνα και όριο μεγέθους και λάβε την ειδοποίηση με το όνομά της."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê a cada lugar seu próprio raio e limite de magnitude e receba a notificação com o nome dele."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri setiap tempat radius dan ambang magnitudo sendiri, lalu terima notifikasi dengan nama tempat itu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소마다 반경과 규모 기준을 따로 정하고, 그 장소 이름으로 알림을 받으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个地点设置各自的半径和震级阈值，并以地点名称接收通知。"
          }
        }
      }
    },
