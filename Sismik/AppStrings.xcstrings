    "Yeni özellikleri ve Premium fırsatlarını seyrek bildirimlerle öğren. İstediğin zaman kapatabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرّف على الميزات الجديدة وعروض Premium عبر إشعارات غير متكررة. يمكنك إيقافها في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahre von neuen Funktionen und Premium-Angeboten durch gelegentliche Benachrichtigungen. Du kannst sie jederzeit deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn about new features and Premium offers with occasional notifications. You can turn it off anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre nuevas funciones y ofertas Premium con notificaciones ocasionales. Puedes desactivarlas en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez les nouvelles fonctionnalités et les offres Premium grâce à des notifications occasionnelles. Vous pouvez les désactiver à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri le nuove funzionalità e le offerte Premium con notifiche occasionali. Puoi disattivarle in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新機能やPremium特典の情報を、頻度の低い通知でお知らせします。いつでもオフにできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнавайте о новых функциях и предложениях Premium из редких уведомлений. Вы можете отключить их в любое время."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni özellikleri ve Premium fırsatlarını seyrek bildirimlerle öğren. İstediğin zaman kapatabilirsin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μάθε για νέες λειτουργίες και προσφορές Premium με περιστασιακές ειδοποιήσεις. Μπορείς να το απενεργοποιήσεις οποτεδήποτε."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiba de novos recursos e ofertas Premium com notificações ocasionais. Você pode desativar quando quiser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketahui fitur baru dan penawaran Premium lewat notifikasi sesekali. Kamu bisa menonaktifkannya kapan saja."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가끔 오는 알림으로 새 기능과 Premium 혜택을 알아보세요. 언제든 끌 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过偶尔的通知了解新功能和 Premium 优惠，可随时关闭。"
          }
        }
      }
    },
