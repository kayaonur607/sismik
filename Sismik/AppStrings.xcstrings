    "safety.after.assembly.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجه إلى نقطة التجمع المحددة مسبقاً مع عائلتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begeben Sie sich zum vorab vereinbarten Sammelplatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Head to the nearest assembly area you identified beforehand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirígete al punto de encuentro acordado con tu familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendez-vous au point de rassemblement convenu à l'avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungi l'area di raccolta stabilita in precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族で事前に決めた避難場所へ落ち着いて移動してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идите к заранее оговоренному безопасному месту встречи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceden belirlediğin en yakın toplanma alanına yönel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πήγαινε στον κοντινότερο χώρο συγκέντρωσης που έχεις εντοπίσει από πριν."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
