    "family.sms.noContacts" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف جهة اتصال واحدة على الأقل أدناه لإرسال الرسائل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge unten mindestens einen Kontakt hinzu, um SMS zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add at least one contact below to send texts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al menos un contacto abajo para enviar SMS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez au moins un contact ci-dessous pour envoyer des SMS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi almeno un contatto qui sotto per inviare SMS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMSを送るには、下で連絡先を1件以上追加してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте ниже хотя бы один контакт, чтобы отправлять SMS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS gönderebilmek için aşağıya en az bir kişi ekle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε τουλάχιστον μία επαφή παρακάτω για να στείλεις μηνύματα."
          }
        },
        "pt-BR" : {
