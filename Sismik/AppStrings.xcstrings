    "Premium üyeliğin aktifken fırsat bildirimi gönderilmez. Bu tercihi istediğin zaman kapatabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم إرسال إشعارات العروض أثناء نشاط اشتراك Premium الخاص بك. يمكنك إيقاف هذا التفضيل في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange Ihre Premium-Mitgliedschaft aktiv ist, werden keine Angebotsbenachrichtigungen gesendet. Sie können diese Einstellung jederzeit deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offer notifications are not sent while your Premium membership is active. You can turn off this preference at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envían notificaciones de ofertas mientras tu suscripción Premium esté activa. Puedes desactivar esta preferencia en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications d'offres ne sont pas envoyées lorsque votre abonnement Premium est actif. Vous pouvez désactiver cette préférence à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche delle offerte non vengono inviate quando l'abbonamento Premium è attivo. Puoi disattivare questa preferenza in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premiumメンバーシップが有効な間は、セールの通知は送信されません。この設定はいつでもオフにできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления о предложениях не отправляются, пока активна ваша подписка Premium. Вы можете отключить этот параметр в любое время."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
