    "help.faq.updates.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم فحص مصادر AFAD وEMSC وUSGS وNOA بانتظام في الخلفية. وعند انقطاع الاتصال تبقى آخر البيانات المحفوظة ظاهرة وتُحدَّث تلقائيًا عند عودة الشبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS und NOA werden regelmäßig im Hintergrund abgefragt. Ohne Verbindung bleiben die zuletzt gespeicherten Daten sichtbar und werden bei erneuter Verbindung still aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS and NOA are checked regularly in the background. When offline, the latest cached data remains visible and refreshes silently when connectivity returns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS y NOA se consultan periódicamente en segundo plano. Sin conexión se mantienen los últimos datos guardados, que se actualizan en silencio al recuperar la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS et NOA sont consultés régulièrement en arrière-plan. Hors ligne, les dernières données enregistrées restent visibles et se mettent à jour silencieusement au retour du réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS e NOA vengono controllati regolarmente in background. Offline restano visibili gli ultimi dati salvati, che si aggiornano silenziosamente al ritorno della connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD、EMSC、USGS、NOAの各機関をバックグラウンドで定期的に確認します。オフライン時は最後に取得したデータが表示され、接続が回復すると自動的に更新されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источники AFAD, EMSC, USGS и NOA регулярно проверяются в фоновом режиме. Без сети отображаются последние сохранённые данные, которые обновляются автоматически при восстановлении связи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS ve NOA kaynakları düzenli aralıklarla arka planda kontrol edilir. Bağlantı yoksa son bilinen veriler gösterilir ve ağ geri geldiğinde sessizce yenilenir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι AFAD, EMSC, USGS και NOA ελέγχονται τακτικά στο παρασκήνιο. Χωρίς σύνδεση, τα τελευταία δεδομένα παραμένουν ορατά και ανανεώνονται αθόρυβα όταν επανέλθει η σύνδεση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS e NOA são verificados regularmente em segundo plano. Offline, os dados mais recentes continuam visíveis e são atualizados em silêncio quando a conexão voltar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS, dan NOA diperiksa secara berkala di latar belakang. Saat offline, data terakhir tetap terlihat dan diperbarui diam-diam saat koneksi kembali."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, EMSC, USGS, NOA를 백그라운드에서 정기적으로 확인합니다. 오프라인일 때는 마지막 데이터가 계속 표시되고 연결되면 조용히 새로 고칩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台会定期检查 AFAD、EMSC、USGS 和 NOA。离线时仍显示最近的数据，网络恢复后自动静默刷新。"
          }
        }
      }
    },
