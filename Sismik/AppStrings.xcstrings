    "places.noneWarning.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتلقى إشعارات الزلازل. أضف مكانًا للبدء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst keine Erdbebenbenachrichtigungen. Füge einen Ort hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are not receiving earthquake notifications. Add a place to start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recibes avisos de sismos. Añade un lugar para empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne recevez aucune alerte sismique. Ajoutez un lieu pour commencer."
