    "pi.limitation" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değerlendirme bina güvenliği raporu değildir. Yerel zemin, yapı kalitesi ve kat yüksekliği gerçek etkiyi değiştirebilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This assessment is not a building safety report. Local soil, construction quality and floor level can change the actual impact."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einschätzung ist kein Gebäudesicherheitsbericht. Boden, Bauqualität und Stockwerk können die tatsächliche Wirkung ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta evaluación no es un informe de seguridad del edificio. El suelo, la calidad de construcción y la planta pueden cambiar el impacto real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette évaluation n'est pas un rapport de sécurité du bâtiment. Le sol, la qualité de construction et l'étage peuvent modifier l'impact réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa valutazione non è un rapporto sulla sicurezza dell'edificio. Suolo, qualità costruttiva e piano possono cambiare l'impatto reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この評価は建物の安全診断ではありません。地盤、建物の品質、階数によって実際の影響は変わります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта оценка не является отчётом о безопасности здания. Грунт, качество постройки и этаж могут изменить реальное воздействие."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا التقييم ليس تقريرًا عن سلامة المبنى. قد تغيّر التربة وجودة البناء والطابق التأثير الفعلي."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εκτίμηση αυτή δεν είναι έκθεση ασφάλειας κτιρίου. Το έδαφος, η ποιότητα κατασκευής και ο όροφος μπορούν να αλλάξουν την πραγματική επίπτωση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta avaliação não é um laudo de segurança do prédio. Solo, qualidade da construção e andar podem mudar o impacto real."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penilaian ini bukan laporan keamanan bangunan. Tanah setempat, kualitas konstruksi, dan lantai dapat mengubah dampak sebenarnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 평가는 건물 안전 진단이 아니에요. 지반, 시공 품질, 층수에 따라 실제 영향은 달라질 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本评估并非建筑安全报告。当地土质、施工质量和楼层都可能改变实际影响。"
          }
        }
      }
    },
