    "favorites.empty.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تحديد نقطة والضغط على النجمة، يتم حفظها هنا. تُحفظ المفضلة بالكامل على جهازك وتفتح حتى بدون إنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Ort auswählst und auf den Stern tippst, wird er hier gespeichert. Favoriten werden vollständig auf deinem Gerät gespeichert und sind auch ohne Internet verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a place and tap the star to keep it here. Favorites are stored entirely on your device and open without internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionar un punto y tocar la estrella, se guardará aquí. Los favoritos se guardan por completo en tu dispositivo y se pueden abrir sin conexión a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous sélectionnez un point et touchez l'étoile, il est conservé ici. Les favoris sont entièrement enregistrés sur votre appareil et s'ouvrent même sans Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selezioni un punto e tocchi la stella, viene salvato qui. I preferiti sono conservati interamente sul tuo dispositivo e si aprono anche senza Internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地点を選択して星アイコンをタップすると、ここに保存されます。お気に入りはすべて端末に保存され、インターネットがなくても開くことができます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выборе точки и нажатии на звездочку она сохраняется здесь. Избранное полностью хранится на устройстве и открывается даже без интернета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir noktayı seçip yıldıza dokunduğunda burada saklanır. Favoriler tamamen cihazında tutulur ve internet olmadan da açılır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε ένα μέρος και πάτα το αστέρι για να μείνει εδώ. Τα αγαπημένα αποθηκεύονται μόνο στη συσκευή σου και ανοίγουν χωρίς διαδίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um lugar e toque na estrela para guardá-lo aqui. Os favoritos ficam só no seu aparelho e abrem sem internet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempat dan ketuk bintang untuk menyimpannya di sini. Favorit disimpan sepenuhnya di perangkatmu dan terbuka tanpa internet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소를 고르고 별을 눌러 여기에 보관하세요. 즐겨찾기는 기기에만 저장되어 인터넷 없이 열립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个地点并点按星标保存在这里。收藏完全保存在你的设备上，无需网络即可打开。"
          }
        }
      }
    },
