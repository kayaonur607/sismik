    "onboarding.welcome.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منصة سيزمولوجية متطورة لتتبع الزلازل المحلية والعالمية لحظياً مع خرائط حية وفوالق نشطة وأدوات طوارئ شاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine moderne Seismologie-Plattform zur Echtzeit-Verfolgung globaler Erdbeben mit Live-Karten, Verwerfungen und Notfall-Tools."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An advanced seismology platform tracking local and global earthquakes in real time, combining live maps, fault lines, emergency and safety tools under one roof."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una plataforma sismológica avanzada para seguir terremotos globales en tiempo real con mapas interactivos, fallas activas y herramientas de rescate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une plateforme sismologique avancée pour suivre les séismes du monde entier en temps réel avec cartes interactives, failles et outils de secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una piattaforma sismologica avanzata per monitorare i terremoti globali in tempo reale con mappe interattive, faglie e strumenti di emergenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界中の地震をリアルタイムに追跡し、活断層マップ、避難所案内、防災ツールを統合した先進的な地震・地球科学プラットフォーム。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передовая сейсмологическая платформа для отслеживания землетрясений по всему миру в реальном времени с интерактивными картами, разломами и инструментами безопасности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Türkiye ve dünyadaki depremleri anlık takip eden; canlı harita, aktif fay hatları, acil durum ve hazırlık araçlarını tek çatı altında toplayan gelişmiş sismoloji platformu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλατφόρμα σεισμολογίας που παρακολουθεί σε πραγματικό χρόνο τοπικούς και παγκόσμιους σεισμούς, με ζωντανούς χάρτες, ρήγματα και εργαλεία έκτακτης ανάγκης σε ένα μέρος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma plataforma de sismologia que acompanha terremotos locais e globais em tempo real, reunindo mapas ao vivo, falhas e ferramentas de emergência em um só lugar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform seismologi yang melacak gempa lokal dan global secara langsung, menggabungkan peta langsung, garis sesar, serta alat darurat dan keselamatan dalam satu tempat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국내외 지진을 실시간으로 추적하고 실시간 지도, 단층, 긴급·안전 도구를 한곳에 모은 지진 플랫폼."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时追踪本地与全球地震的地震学平台，集实时地图、断层以及应急和安全工具于一体。"
          }
        }
      }
    },
