            "state" : "translated",
            "value" : "Seçilen dönemdeki en yüksek büyüklüğe sahip depremler, büyükten küçüğe sıralanır. Herhangi birine dokunarak detaylarını görebilirsin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μεγαλύτεροι σεισμοί της περιόδου, από τον μεγαλύτερο στον μικρότερο. Πάτα οποιονδήποτε για λεπτομέρειες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os terremotos de maior magnitude do período, do maior para o menor. Toque em um para ver detalhes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gempa bermagnitudo tertinggi pada periode terpilih, diurutkan dari terbesar. Ketuk salah satu untuk detailnya."
