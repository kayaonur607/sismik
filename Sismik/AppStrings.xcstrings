    "intro.emergency.call.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بطاقة الجزء العلوي تتصل برقم الطوارئ الخاص بالبلد الذي تقع فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die oberste Karte wählt die Notrufnummer des Landes, in dem du dich befindest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The top card dials the emergency number of the country you're in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta superior llama al número de emergencia del país en el que te encuentras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte supérieure appelle le numéro d'urgence du pays où vous vous trouvez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda in alto chiama il numero di emergenza del Paese in cui ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最上部のカードをタップすると、現在いる国の緊急通報番号に電話がかかります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верхняя карточка вызывает номер службы экстренной помощи страны, в которой вы находитесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En üstteki kart bulunduğun ülkenin acil numarasını arar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πάνω κάρτα καλεί τον αριθμό έκτακτης ανάγκης της χώρας όπου βρίσκεσαι."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão de cima liga para o número de emergência do país onde você está."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartu teratas menelepon nomor darurat negara tempatmu berada."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 위 카드는 현재 있는 나라의 긴급 번호로 전화합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部卡片会拨打你所在国家的紧急号码。"
          }
        }
      }
    },
