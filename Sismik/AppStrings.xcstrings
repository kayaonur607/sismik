    "premiumPreview.stats.feature.pulse.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر ما إذا كان النشاط قد زاد أم قلّ من خلال مقارنة نصفي الفترة، بالإضافة إلى المتوسط اليومي والوقت بين الزلازل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt durch den Vergleich der beiden Periodenhälften, ob die Aktivität zu- oder abgenommen hat, sowie den Tagesdurchschnitt und die Zeit zwischen Erdbeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows whether activity has increased or decreased by comparing the two halves of the period, along with the daily average and time between earthquakes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra si la actividad ha aumentado o disminuido comparando las dos mitades del período, el promedio diario y el tiempo entre terremotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique si l'activité a augmenté ou diminué en comparant les deux moitiés de la période, la moyenne quotidienne et le délai entre les séismes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra se l'attività è aumentata o diminuita confrontando le due metà del periodo, insieme alla media giornaliera e al tempo tra i terremoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間の前後を比較してアクティビティの増減、日別平均、地震間の間隔を表示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает увеличение или уменьшение активности путем сравнения двух половин периода, а также среднесуточное значение и время между землетрясениями."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dönemin iki yarısını karşılaştırarak hareketliliğin arttığını ya da azaldığını, günlük ortalamayı ve depremler arası süreyi gösterir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει αν η δραστηριότητα αυξήθηκε ή μειώθηκε συγκρίνοντας τα δύο μισά της περιόδου, μαζί με τον ημερήσιο μέσο όρο και τον χρόνο μεταξύ σεισμών."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra se a atividade aumentou ou diminuiu comparando as duas metades do período, com a média diária e o tempo entre terremotos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan apakah aktivitas naik atau turun dengan membandingkan dua paruh periode, beserta rata-rata harian dan jeda antar gempa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간의 두 절반을 비교해 활동이 늘었는지 줄었는지와 일평균, 지진 간 간격을 보여줍니다."
          }
        },
        "zh-Hans" : {
