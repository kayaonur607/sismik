    "ob2.welcome.ready.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصافرة وضوء SOS ودليل الإسعاف وخطة العائلة تعمل دون شبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeife, SOS-Licht, Erste-Hilfe-Leitfaden und Familienplan funktionieren ohne Netz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whistle, SOS light, first-aid guide and family plan work without a network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silbato, luz SOS, guía de primeros auxilios y plan familiar funcionan sin red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sifflet, lumière SOS, guide de premiers secours et plan familial fonctionnent sans réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fischietto, luce SOS, guida al primo soccorso e piano familiare funzionano senza rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笛、SOSライト、応急手当ガイド、家族の計画は圏外でも使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свисток, SOS-свет, первая помощь и семейный план работают без сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düdük, SOS ışığı, ilk yardım rehberi ve aile planı şebeke olmasa da çalışır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σφυρίχτρα, φως SOS, οδηγός πρώτων βοηθειών και οικογενειακό σχέδιο λειτουργούν χωρίς δίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apito, luz SOS, guia de primeiros socorros e plano familiar funcionam sem rede."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peluit, lampu SOS, panduan P3K, dan rencana keluarga berfungsi tanpa jaringan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호루라기, SOS 조명, 응급처치 안내, 가족 계획은 네트워크 없이 작동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哨子、SOS 灯、急救指南和家庭计划无需网络即可使用。"
          }
        }
      }
    },
