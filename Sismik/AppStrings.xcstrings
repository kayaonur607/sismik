    "pi.places.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yer için sarsıntı büyüklük, derinlik ve uzaklıkla ya da varsa ShakeMap ölçümüyle tahmin edilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shaking at each place is estimated from magnitude, depth and distance, or from ShakeMap where available."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erschütterung wird je Ort aus Magnitude, Tiefe und Entfernung geschätzt, oder aus ShakeMap, falls vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sacudida en cada lugar se estima por magnitud, profundidad y distancia, o con ShakeMap si existe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La secousse de chaque lieu est estimée par magnitude, profondeur et distance, ou par ShakeMap si disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scuotimento di ogni luogo è stimato da magnitudo, profondità e distanza, o da ShakeMap se disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各場所の揺れは規模・深さ・距離、または ShakeMap があればその観測から推定します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сотрясения в каждом месте оцениваются по магнитуде, глубине и расстоянию или по ShakeMap, если есть."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقدَّر الاهتزاز في كل مكان وفق القوة والعمق والمسافة، أو من ShakeMap إن توفرت."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δόνηση σε κάθε μέρος εκτιμάται από μέγεθος, βάθος και απόσταση ή από το ShakeMap, αν υπάρχει."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tremor em cada lugar é estimado por magnitude, profundidade e distância, ou pelo ShakeMap quando houver."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guncangan di tiap tempat diperkirakan dari magnitudo, kedalaman, dan jarak, atau dari ShakeMap bila ada."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 장소의 흔들림은 규모·깊이·거리 또는 가능한 경우 ShakeMap으로 추정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各地点的震感根据震级、深度和距离估算，若有 ShakeMap 则采用其观测。"
          }
        }
      }
    },
