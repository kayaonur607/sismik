    "settings.notificationStyle.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı depremin farklı ajans kayıtları tek bildirim olarak gelir; ilk yayımlayan kaynak kullanılır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports of the same earthquake from different agencies arrive as a single notification, from whichever source publishes first."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen verschiedener Dienste zum selben Erdbeben kommen als eine Benachrichtigung – von der Quelle, die zuerst veröffentlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de un mismo terremoto de distintas agencias llegan como una sola notificación, de la fuente que publica primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les relevés d'un même séisme par différentes agences arrivent en une seule notification, depuis la source qui publie en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di uno stesso terremoto da agenzie diverse arrivano come un'unica notifica, dalla fonte che pubblica per prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ地震の複数機関の記録は、最初に発表した情報源から1件の通知として届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные об одном землетрясении от разных агентств приходят одним уведомлением — от источника, опубликовавшего их первым."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل سجلات الزلزال نفسه من جهات مختلفة في إشعار واحد، من المصدر الذي ينشر أولاً."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εγγραφές του ίδιου σεισμού από διαφορετικούς φορείς έρχονται ως μία ειδοποίηση, από την πηγή που δημοσιεύει πρώτη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros do mesmo terremoto de agências diferentes chegam como uma única notificação, da fonte que publicar primeiro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan gempa yang sama dari lembaga berbeda datang sebagai satu notifikasi, dari sumber yang menerbitkan pertama."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 지진에 대한 여러 기관의 기록은 가장 먼저 발표한 출처로 한 번만 알립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一地震来自不同机构的记录只会以一条通知送达，采用最先发布的来源。"
          }
        }
      }
    },
