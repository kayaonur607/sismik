        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες στον χάρτη τους κοντινούς χώρους συγκέντρωσης και άνοιξε οδηγίες προς όποιον επιλέξεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja no mapa os pontos de encontro próximos e abra rotas até o local escolhido."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelajahi titik kumpul terdekat di peta dan buka petunjuk arah ke lokasi pilihanmu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 가까운 대피 장소를 확인하고 선택한 곳으로 길찾기를 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地图上查看附近的集合点，并打开前往所选位置的路线。"
          }
        }
      }
    },
