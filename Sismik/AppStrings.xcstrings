    "ob2.list.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأخضر زلازل صغيرة لا تُحس، والبرتقالي محسوس، والأحمر زلازل قوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grüntöne sind kaum spürbar, Orange ist spürbar, Rot sind starke Beben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greens are too small to feel, oranges are felt, reds are strong earthquakes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los verdes son demasiado pequeños para sentirse, los naranjas se sienten y los rojos son fuertes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les verts sont imperceptibles, les orangés ressentis, les rouges sont forts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I verdi sono impercettibili, gli arancioni si avvertono, i rossi sono forti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑は感じないほど小さい地震、オレンジは揺れを感じる地震、赤は強い地震。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зелёные — слишком слабые, чтобы почувствовать, оранжевые ощущаются, красные — сильные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeşil tonlar hissedilmeyecek kadar küçük depremler, turuncular hissedilir olanlar, kırmızılar güçlü depremler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πράσινα είναι πολύ μικροί για να γίνουν αισθητοί, τα πορτοκαλί αισθητοί, τα κόκκινα ισχυροί σεισμοί."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os verdes são pequenos demais para sentir, os laranja são sentidos e os vermelhos são terremotos fortes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hijau terlalu kecil untuk terasa, oranye terasa, merah adalah gempa kuat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초록은 느끼기 어려운 작은 지진, 주황은 느껴지는 지진, 빨강은 강한 지진입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绿色表示小到无感，橙色表示有感，红色表示强烈地震。"
          }
        }
      }
    },
    "ob2.list.felt.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغ بأنك شعرت به وشاهد على الخريطة أين شعر به الآخرون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde, dass du es gespürt hast, und sieh, wo andere es spürten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report that you felt it and see where others felt it on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica que lo sentiste y mira en el mapa dónde lo sintieron otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalez l'avoir ressenti et voyez où d'autres l'ont ressenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala di averlo sentito e guarda dove l'hanno sentito gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揺れを感じたら報告し、どこで感じられたかを地図で見られます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщите, что почувствовали, и смотрите на карте, где почувствовали другие."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hissettiğini bildir, kimlerin nerede hissettiğini haritada gör."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανέφερε ότι τον ένιωσες και δες στον χάρτη πού τον ένιωσαν άλλοι."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe que sentiu e veja no mapa onde outros sentiram."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporkan bahwa kamu merasakannya dan lihat di peta di mana orang lain merasakannya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느꼈다고 알리고 다른 사람들이 어디서 느꼈는지 지도에서 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告你有震感，并在地图上查看其他人在哪里有感。"
          }
        }
      }
    },
