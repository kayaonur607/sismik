        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Где, когда\nи какой магнитуды?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede, ne zaman,\nne büyüklükte?"
