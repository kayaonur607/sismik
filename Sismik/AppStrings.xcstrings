    "places.felt.level.4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evde çoğu kişi hisseder; kapılar, pencereler tıkırdar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felt by most people indoors; doors and windows rattle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von den meisten im Haus gespürt; Türen und Fenster klappern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sienten casi todos en interiores; puertas y ventanas vibran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ressenti par la plupart à l'intérieur ; portes et fenêtres vibrent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvertito dalla maggior parte in casa; porte e finestre vibrano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋内のほとんどの人が感じ、戸や窓が音を立てる揺れ。"
