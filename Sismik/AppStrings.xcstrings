    "help.faq.restore.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح شاشة Premium واضغط على استعادة المشتريات. يجب تسجيل الدخول بحساب Apple الذي أتممت به عملية الشراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Premium-Bildschirm und tippe auf „Käufe wiederherstellen“. Du musst mit dem Apple-Account angemeldet sein, mit dem der Kauf getätigt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Premium screen and tap Restore Purchases. You must be signed in with the Apple Account that originally completed the purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la pantalla Premium y toca Restaurar compras. Debes haber iniciado sesión con la cuenta de Apple con la que realizaste la compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l'écran Premium et touchez Restaurer les achats. Vous devez être connecté avec le compte Apple ayant effectué l'achat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la schermata Premium e tocca Ripristina acquisti. Devi aver effettuato l'accesso con l'Account Apple usato per l'acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium画面を開き、「購入を復元」をタップしてください。購入時に使用したApple アカウントでサインインしている必要があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте экран Premium и нажмите «Восстановить покупки». Нужно войти в тот Apple Account, с которого была совершена покупка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium ekranını açıp Satın Alımları Geri Yükle seçeneğine dokunun. App Store'da satın alımı yaptığınız Apple Hesabı ile oturum açık olmalıdır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άνοιξε την οθόνη Premium και πάτα Επαναφορά αγορών. Πρέπει να είσαι συνδεδεμένος με τον λογαριασμό Apple που έκανε την αγορά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a tela Premium e toque em Restaurar compras. Você precisa estar com a Conta Apple que fez a compra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka layar Premium lalu ketuk Pulihkan Pembelian. Kamu harus masuk dengan Akun Apple yang melakukan pembelian."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium 화면에서 구입 복원을 누르세요. 처음 구입한 Apple 계정으로 로그인되어 있어야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Premium 页面并点按“恢复购买”。需登录最初购买所用的 Apple 账户。"
          }
        }
      }
    },
