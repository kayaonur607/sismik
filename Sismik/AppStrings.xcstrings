    "stats.depth.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسط العمق %@. يُشعر بالزلزال الضحل أكثر من العميق بنفس القوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittlere Tiefe %@. Ein flaches Beben ist stärker spürbar als ein gleich starkes tiefes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average depth %@. A shallow quake is felt more strongly than a deep one of the same size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidad media %@. Un sismo superficial se siente más que uno profundo de igual magnitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeur moyenne %@. Un séisme superficiel est plus ressenti qu'un séisme profond de même magnitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondità media %@. Un terremoto superficiale si avverte più di uno profondo della stessa magnitudo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均の深さ%@。同じ規模なら浅い地震の方が強く揺れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средняя глубина %@. Мелкофокусное землетрясение ощущается сильнее глубокого той же магнитуды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortalama derinlik %@. Aynı büyüklükte sığ deprem, derin olandan daha güçlü hissedilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέσο βάθος %@. Ένας ρηχός σεισμός γίνεται αισθητός πιο έντονα από έναν βαθύ του ίδιου μεγέθους."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade média %@. Um terremoto raso é sentido com mais força que um profundo de mesma magnitude."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedalaman rata-rata %@. Gempa dangkal terasa lebih kuat daripada gempa dalam dengan magnitudo sama."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평균 깊이 %@. 같은 규모라면 얕은 지진이 깊은 지진보다 더 강하게 느껴집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均深度 %@。同样震级下，浅源地震比深源地震震感更强。"
          }
        }
      }
    },
