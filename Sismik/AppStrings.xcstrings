    "ob2.alerts.digest.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل صباح اثنين، ملخص صامت لما حدث قرب أماكنك في الأسبوع الماضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Montagmorgen eine stille Übersicht der letzten Woche rund um deine Orte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every Monday morning, a quiet note on what happened near your places last week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lunes por la mañana, un aviso silencioso de lo ocurrido cerca de tus lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque lundi matin, un résumé silencieux de la semaine autour de vos lieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni lunedì mattina, un riepilogo silenzioso della settimana vicino ai tuoi luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週月曜の朝、先週あなたの場所の近くで起きたことを静かにお知らせ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый понедельник утром — тихая сводка о прошедшей неделе рядом с вашими местами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pazartesi sabahı, yerlerinin yakınında geçen hafta ne olduğunu sessiz bir bildirimle öğren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε Δευτέρα πρωί, ένα αθόρυβο σημείωμα για όσα έγιναν κοντά στις τοποθεσίες σου την περασμένη εβδομάδα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda segunda de manhã, um aviso discreto sobre o que aconteceu perto dos seus lugares na semana passada."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap Senin pagi, catatan senyap tentang apa yang terjadi di dekat tempatmu minggu lalu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 월요일 아침, 지난주 내 장소 근처에서 일어난 일을 조용히 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周一早上，静默告诉你上周你的地点附近发生了什么。"
          }
        }
      }
    },
