    "places.editor.iconFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر الرمز على يمين الإشعار. لكل مكان رمزه الخاص؛ الرموز المستخدمة تظهر باهتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Symbol erscheint rechts in der Mitteilung. Jeder Ort hat ein eigenes Symbol; belegte Symbole sind abgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The icon appears on the right of the notification. Each place gets its own icon; icons in use are dimmed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono aparece a la derecha de la notificación. Cada lugar tiene su propio icono; los iconos en uso se ven atenuados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icône s’affiche à droite de la notification. Chaque lieu a sa propre icône ; celles déjà utilisées sont grisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icona appare a destra della notifica. Ogni luogo ha la sua icona; quelle già usate sono attenuate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコンは通知の右側に表示されます。場所ごとに別のアイコンを使い、使用中のものは薄く表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок появляется справа в уведомлении. У каждого места свой значок; занятые значки приглушены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simge bildirimin sağında görünür. Her yerin simgesi farklı olur; kullanılan simgeler soluk görünür."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το εικονίδιο εμφανίζεται δεξιά στην ειδοποίηση. Κάθε τοποθεσία έχει δικό της εικονίδιο· όσα χρησιμοποιούνται είναι αχνά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ícone aparece à direita da notificação. Cada lugar tem seu próprio ícone; os já usados ficam esmaecidos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikon muncul di kanan notifikasi. Tiap tempat punya ikon sendiri; ikon yang sudah dipakai diredupkan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘은 알림 오른쪽에 표시됩니다. 장소마다 아이콘이 다르며 사용 중인 아이콘은 흐리게 보입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标显示在通知右侧。每个地点使用各自的图标；已使用的图标会变暗。"
          }
        }
      }
    },
