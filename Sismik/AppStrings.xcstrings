    "risk.faults.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات الصدوع: GEM Global Active Faults. أكبر زلزال محتمل تقدير تقريبي من طول الصدع (Wells & Coppersmith)؛ شدة السيناريو هي الاهتزاز الذي قد يسببه هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwerfungsdaten: GEM Global Active Faults. Das größtmögliche Beben ist grob aus der Länge geschätzt (Wells & Coppersmith); die Szenario-Intensität ist die Erschütterung, die es hier auslösen könnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fault data: GEM Global Active Faults. The largest possible quake is a rough estimate from fault length (Wells & Coppersmith); scenario intensity is the shaking that quake could cause here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de fallas: GEM Global Active Faults. El sismo máximo posible se estima a partir de la longitud (Wells & Coppersmith); la intensidad del escenario es la sacudida que causaría aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données : GEM Global Active Faults. Le séisme maximal est estimé grossièrement d'après la longueur (Wells & Coppersmith) ; l'intensité du scénario est la secousse qu'il pourrait causer ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati: GEM Global Active Faults. Il terremoto massimo è stimato dalla lunghezza (Wells & Coppersmith); l'intensità dello scenario è lo scuotimento che potrebbe causare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断層データ:GEM Global Active Faults。最大規模は断層長から概算(Wells & Coppersmith)。シナリオ震度はその地震がここで起こしうる揺れです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные: GEM Global Active Faults. Максимальная магнитуда грубо оценена по длине разлома (Wells & Coppersmith); сценарная интенсивность — сотрясения здесь при таком землетрясении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fay verisi: GEM Küresel Aktif Faylar. Olası en büyük deprem fay uzunluğundan (Wells & Coppersmith) kabaca hesaplanır; senaryo şiddeti o depremin burada yaratabileceği sarsıntıdır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεδομένα ρηγμάτων: GEM Global Active Faults. Ο μεγαλύτερος πιθανός σεισμός είναι χονδρική εκτίμηση από το μήκος του ρήγματος (Wells & Coppersmith)· η ένταση σεναρίου είναι η δόνηση που θα μπορούσε να προκαλέσει εδώ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de falhas: GEM Global Active Faults. O maior terremoto possível é uma estimativa aproximada pelo comprimento da falha (Wells & Coppersmith); a intensidade do cenário é o tremor que ele poderia causar aqui."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data sesar: GEM Global Active Faults. Gempa terbesar yang mungkin adalah perkiraan kasar dari panjang sesar (Wells & Coppersmith); intensitas skenario adalah guncangan yang dapat ditimbulkannya di sini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단층 데이터: GEM Global Active Faults. 최대 가능 지진은 단층 길이로 대략 추정한 값(Wells & Coppersmith)이며, 시나리오 진도는 그 지진이 이곳에 줄 수 있는 흔들림입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断层数据：GEM 全球活动断层。最大可能地震是根据断层长度的粗略估算（Wells & Coppersmith）；情景烈度是该地震可能在此处造成的震动。"
          }
        }
      }
    },
