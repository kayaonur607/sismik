    "Sana en yakın güvenli noktaya yönlendirir" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرشدك إلى أقرب نقطة آمنة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt dich zum nächstgelegenen sicheren Punkt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guides you to the nearest safe point"
          }
        },
        "es" : {
          "stringUnit" : {
