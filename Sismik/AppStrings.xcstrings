    "places.onboarding.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر موقعًا على الخريطة، وحدد شعاعه، وأعطه اسمًا وأيقونة. عند وقوع زلزال في تلك المنطقة، يصل الإشعار باسمه، كما تظهر شعاعاتك على الخريطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ort auf der Karte, zeichne seinen Radius, gib ihm einen Namen und ein Symbol. Wenn in diesem Bereich ein Erdbeben auftritt, trifft die Benachrichtigung mit seinem Namen ein; deine Radien werden auch auf der Karte angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a place on the map, set its radius, and give it a name and icon. When an earthquake occurs in that area, notifications arrive with its name; your radii are also visible on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un lugar en el mapa, define su radio, asígnale un nombre y un icono. Cuando ocurra un terremoto en esa zona, recibirás notificaciones con su nombre; tus radios también se verán en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un lieu sur la carte, définissez son rayon, donnez-lui un nom et une icône. Lorsqu'un séisme se produit dans cette zone, les notifications arrivent avec son nom ; vos rayons sont également visibles sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un luogo sulla mappa, imposta il raggio, dagli un nome e un'icona. Quando si verifica un terremoto in quella zona, la notifica arriva con il suo nome; i tuoi raggi sono visibili anche sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップ上で場所を選択し、半径を設定して、名前とアイコンを指定します。その地域で地震が発生すると、設定した名前で通知が届き、半径もマップ上に表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите место на карте, задайте радиус, укажите название и иконку. При землетрясении в этой зоне уведомление придет с его названием; ваши радиусы также будут видны на карте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritadan yer seç, yarıçapını çiz, adını ve simgesini ver. O bölgede deprem olduğunda bildirim adıyla gelir; yarıçapların haritada da görünür."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε ένα μέρος στον χάρτη, όρισε την ακτίνα του και δώσε του όνομα και εικονίδιο. Όταν γίνει σεισμός εκεί, η ειδοποίηση έρχεται με το όνομά του· οι ακτίνες φαίνονται και στον χάρτη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um lugar no mapa, defina o raio e dê um nome e ícone. Quando houver um terremoto na área, a notificação chega com o nome dele; os raios também aparecem no mapa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempat di peta, atur radiusnya, beri nama dan ikon. Saat gempa terjadi di area itu, notifikasi datang dengan namanya; radius juga terlihat di peta."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 장소를 고르고 반경, 이름, 아이콘을 정하세요. 그 지역에 지진이 나면 장소 이름으로 알림이 오고, 반경은 지도에도 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地图上选择地点，设定半径并命名、选图标。该区域发生地震时会以其名称通知你；半径也会显示在地图上。"
          }
        }
      }
    },
