    "Sismik bir erken uyarı sistemi değildir. Hayati acil durumlarda lütfen vakit kaybetmeden %@ Acil Çağrı Merkezini arayın." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik ليس نظام إنذار مبكر. في حالات الطوارئ المهدِّدة للحياة، اتصل فورًا بالطوارئ %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik ist kein Frühwarnsystem. Rufe in lebensbedrohlichen Notfällen sofort den Notruf %@ an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik is not an early warning system. In life-threatening emergencies, call %@ Emergency Services immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik no es un sistema de alerta temprana. En emergencias con riesgo vital, llama de inmediato a emergencias %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik n’est pas un système d’alerte précoce. En cas d’urgence vitale, appelez immédiatement les secours %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik non è un sistema di allerta precoce. In caso di emergenza pericolosa per la vita, chiama subito i soccorsi %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik は早期警報システムではありません。生命に関わる緊急時は、ただちに緊急通報 %@ に連絡してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik не является системой раннего оповещения. При угрозе жизни немедленно звоните в службу %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik bir erken uyarı sistemi değildir. Hayati acil durumlarda lütfen vakit kaybetmeden %@ Acil Çağrı Merkezini arayın."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sismik δεν είναι σύστημα έγκαιρης προειδοποίησης. Σε απειλητική για τη ζωή κατάσταση, κάλεσε αμέσως το %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sismik não é um sistema de alerta antecipado. Em emergências com risco de vida, ligue imediatamente para %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik bukan sistem peringatan dini. Dalam keadaan darurat yang mengancam jiwa, segera hubungi %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik은 조기 경보 시스템이 아닙니다. 생명이 위급하면 즉시 %@에 전화하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik 不是地震预警系统。遇到危及生命的紧急情况，请立即拨打 %@。"
          }
        }
      }
    },
    "Sismik bir resmi acil servis veya erken uyarı sistemi değildir. Deprem anında lütfen resmi acil durum yönergelerine uyun." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن Sismik ليس خدمة طوارئ رسمية أو نظام إنذار مبكر. يرجى اتباع إرشادات الطوارئ الرسمية أثناء حدوث زلزال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik ist kein offizieller Notfalldienst oder Frühwarnsystem. Bitte befolgen Sie im Falle eines Erdbebens die offiziellen Notfallrichtlinien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik is not an official emergency service or early warning system. Please follow official emergency guidelines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik no es un servicio de emergencia oficial ni un sistema de alerta temprana. En caso de terremoto, siga las pautas oficiales de emergencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik n'est pas un service d'urgence officiel ni un système d'alerte précoce. En cas de séisme, veuillez suivre les consignes d'urgence officielles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik non è un servizio di emergenza ufficiale o un sistema di allerta rapida. In caso di terremoto, seguire le linee guida ufficiali di emergenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismikは公式の緊急サービスや早期警戒システムではありません。地震の際は、公式の緊急ガイドラインに従ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik не является официальной службой экстренной помощи или системой раннего оповещения. В случае землетрясения следуйте официальным инструкциям по чрезвычайным ситуациям."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik bir resmi acil servis veya erken uyarı sistemi değildir. Deprem anında lütfen resmi acil durum yönergelerine uyun."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sismik δεν είναι επίσημη υπηρεσία έκτακτης ανάγκης ή σύστημα έγκαιρης προειδοποίησης. Ακολούθησε τις επίσημες οδηγίες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sismik não é um serviço oficial de emergência nem sistema de alerta antecipado. Siga as orientações oficiais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik bukan layanan darurat resmi atau sistem peringatan dini. Ikuti pedoman darurat resmi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik은 공식 긴급 서비스나 조기 경보 시스템이 아닙니다. 공식 안전 지침을 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik 不是官方紧急服务或预警系统。请遵循官方应急指引。"
          }
        }
      }
    },
