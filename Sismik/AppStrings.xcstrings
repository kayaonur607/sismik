    "ob2.premium.stats.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم زلزالًا وما قوتها وعمقها والطاقة المنبعثة؛ وكل رسم يشرح معناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele, wie stark, wie tief und wie viel Energie – jede Grafik erklärt sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many, how strong, how deep and how much energy — each chart says what it means."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos, qué tan fuertes, qué tan profundos y cuánta energía; cada gráfico explica su sentido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien, quelle force, quelle profondeur, quelle énergie : chaque graphique s'explique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti, quanto forti, quanto profondi e quanta energia: ogni grafico dice cosa significa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回数、規模、深さ、放出エネルギー。各グラフに意味の説明付き。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько, насколько сильные, на какой глубине и сколько энергии — каждый график объяснён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaç deprem, ne kadar büyük, ne kadar derin ve açığa çıkan enerji; her grafiğin ne anlama geldiği yazıyor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσοι, πόσο ισχυροί, πόσο βαθιά και πόση ενέργεια — κάθε γράφημα λέει τι σημαίνει."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos, com que força, a que profundidade e quanta energia — cada gráfico diz o que significa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa banyak, seberapa kuat, seberapa dalam, dan berapa energinya — setiap grafik menjelaskan artinya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 번, 얼마나 강하게, 얼마나 깊게, 얼마나 큰 에너지 — 각 차트가 의미를 알려 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多少次、多强、多深、多少能量——每张图都说明其含义。"
          }
        }
      }
    },
