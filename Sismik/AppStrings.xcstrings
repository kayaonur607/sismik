    "firstaid.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يغني هذا الدليل عن التدريب. تأكد من سلامتك أولًا واتصل بالطوارئ في أقرب وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Leitfaden ersetzt keine Ausbildung. Achte zuerst auf deine eigene Sicherheit und ruf so bald wie möglich den Notruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This guide doesn't replace training. Make sure you are safe first and call emergency services as soon as you can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta guía no sustituye la formación. Ponte a salvo primero y llama a emergencias en cuanto puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce guide ne remplace pas une formation. Assurez d'abord votre sécurité et appelez les secours dès que possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa guida non sostituisce la formazione. Metti prima al sicuro te stesso e chiama i soccorsi appena puoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このガイドは講習の代わりにはなりません。まず自分の安全を確保し、できるだけ早く救急に通報してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это руководство не заменяет обучение. Сначала позаботьтесь о своей безопасности и как можно скорее вызовите скорую."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu rehber eğitimin yerini tutmaz. Önce kendi güvenliğini sağla ve mümkünse hemen 112'yi ara."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο οδηγός δεν αντικαθιστά την εκπαίδευση. Βεβαιώσου πρώτα ότι είσαι ασφαλής και κάλεσε βοήθεια το συντομότερο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este guia não substitui treinamento. Garanta primeiro sua segurança e ligue para a emergência assim que puder."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panduan ini bukan pengganti pelatihan. Pastikan dirimu aman dulu dan hubungi layanan darurat secepatnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 안내는 교육을 대신하지 않습니다. 먼저 자신의 안전을 확보하고 최대한 빨리 긴급 서비스에 연락하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本指南不能替代专业培训。请先确保自身安全，并尽快拨打急救电话。"
          }
        }
      }
    },
    "firstaid.fracture.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحاول تقويم أو تحريك موضع الكسر المشتبه به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche nicht, den vermuteten Bruch zu richten oder zu bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't try to straighten or move the suspected fracture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No intentes enderezar ni mover la posible fractura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'essayez pas de redresser ni de bouger la fracture présumée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non cercare di raddrizzare o muovere la frattura sospetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "骨折が疑われる部分をまっすぐにしたり動かしたりしない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не пытайтесь выпрямить или сдвинуть предполагаемый перелом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kırık olduğundan şüphelendiğin bölgeyi düzeltmeye ya da hareket ettirmeye çalışma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην προσπαθείς να ισιώσεις ή να μετακινήσεις το πιθανό κάταγμα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tente endireitar nem mover a possível fratura."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan coba meluruskan atau menggerakkan bagian yang diduga patah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "골절이 의심되는 부위를 펴거나 움직이지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要试图扳直或移动疑似骨折部位。"
          }
        }
      }
    },
    "firstaid.fracture.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جبّره بكرتون أو خشب أو مجلة ملفوفة، مع تضمين المفصلين أعلاه وأسفله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Karton, Holz oder gerollter Zeitschrift schienen – die Gelenke darüber und darunter einschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splint it with cardboard, wood or a rolled magazine, including the joints above and below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entablilla con cartón, madera o una revista enrollada, incluyendo las articulaciones de arriba y abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites une attelle avec du carton, du bois ou un magazine roulé, en incluant les articulations au-dessus et en dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steccalo con cartone, legno o una rivista arrotolata, includendo le articolazioni sopra e sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段ボールや板、丸めた雑誌で、上下の関節も含めて添え木をする。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наложите шину из картона, доски или свёрнутого журнала, захватив суставы выше и ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karton, tahta ya da katlanmış dergiyle alt ve üst eklemleri de içine alacak şekilde atel yap."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακινητοποίησέ το με χαρτόνι, ξύλο ή τυλιγμένο περιοδικό, πιάνοντας και τις αρθρώσεις πάνω και κάτω."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imobilize com papelão, madeira ou revista enrolada, incluindo as articulações acima e abaixo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidai dengan kardus, kayu, atau majalah yang digulung, termasuk sendi di atas dan di bawahnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "골판지, 나무, 말아 쥔 잡지로 위아래 관절까지 포함해 부목을 대세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用纸板、木板或卷起的杂志固定，并包括上下两个关节。"
          }
        }
      }
    },
    "firstaid.fracture.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان العظم ظاهرًا فغطّه بقماش نظيف؛ ولا تحاول إدخاله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ragt Knochen heraus, mit sauberem Tuch abdecken; nicht zurückdrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If bone is showing, cover it with a clean cloth; don't push it back in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el hueso asoma, cúbrelo con un paño limpio; no lo empujes hacia dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l'os est apparent, couvrez-le d'un linge propre ; ne le repoussez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l'osso è esposto, coprilo con un panno pulito; non spingerlo dentro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "骨が見えている場合は清潔な布で覆い、押し戻さない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если видна кость, накройте чистой тканью; не вправляйте её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemik dışarıdaysa üstünü temiz bezle ört; kemiği içeri itmeye çalışma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν φαίνεται κόκαλο, κάλυψέ το με καθαρό ύφασμα· μην το σπρώχνεις μέσα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o osso estiver exposto, cubra com um pano limpo; não o empurre de volta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tulang terlihat, tutup dengan kain bersih; jangan didorong masuk."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뼈가 보이면 깨끗한 천으로 덮고 밀어 넣지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若骨头外露，用干净的布覆盖；不要把它推回去。"
          }
        }
      }
    },
    "firstaid.fracture.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص لون الأصابع وحرارتها وإحساسها؛ وأرخِ الرباط إن ازرقّت أو تنمّلت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe, Wärme und Gefühl in Fingern oder Zehen prüfen; bei Blaufärbung oder Taubheit lockern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check color, warmth and feeling in the fingers or toes; loosen the ties if they turn blue or numb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa color, temperatura y sensibilidad de dedos; afloja si se ponen morados o se duermen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez couleur, chaleur et sensibilité des doigts ou orteils ; desserrez s'ils bleuissent ou s'engourdissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla colore, calore e sensibilità delle dita; allenta se diventano bluastre o intorpidite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指先の色・温かさ・感覚を確かめ、紫色やしびれがあれば固定をゆるめる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяйте цвет, тепло и чувствительность пальцев; при синюшности или онемении ослабьте повязку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmak uçlarında renk, ısı ve his kontrol et; morarma ya da uyuşma varsa bağı gevşet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγξε χρώμα, θερμότητα και αίσθηση σε δάχτυλα χεριών ή ποδιών· χαλάρωσε τους δεσμούς αν μελανιάσουν ή μουδιάσουν."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique cor, calor e sensibilidade dos dedos; afrouxe as amarras se ficarem roxos ou dormentes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa warna, kehangatan, dan rasa di jari tangan atau kaki; longgarkan ikatan jika membiru atau mati rasa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락·발가락의 색, 온기, 감각을 확인하고 파래지거나 저리면 고정을 느슨하게 하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查手指或脚趾的颜色、温度和感觉；若发紫或麻木，请放松固定。"
          }
        }
      }
    },
    "firstaid.fracture.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحركه؛ ثبّته على وضعه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht bewegen, in vorgefundener Lage ruhigstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't move it; immobilize it as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo muevas; inmovilízalo tal como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bougez pas le membre ; immobilisez-le tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non muoverlo; immobilizzalo così com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動かさず、そのままの形で固定する。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не двигайте, зафиксируйте в том положении, в каком есть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket ettirme, bulunduğu şekilde sabitle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην το μετακινείς· ακινητοποίησέ το όπως είναι."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não mexa; imobilize como está."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan digerakkan; imobilisasi apa adanya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직이지 말고 있는 그대로 고정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要移动，保持原状固定。"
          }
        }
      }
    },
    "firstaid.fracture.title" : {
