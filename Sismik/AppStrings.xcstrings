    "USGS bu deprem için tsunami bilgisi yayımladı. Kıyı bölgelerindeki resmî uyarıları takip et." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصدرت USGS معلومات عن تسونامي لهذا الزلزال. اتبع التحذيرات الرسمية في المناطق الساحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS hat Tsunami-Informationen für dieses Erdbeben herausgegeben. Befolgen Sie die offiziellen Warnungen in Küstenregionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS has issued tsunami information for this event. Follow official coastal warnings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La USGS ha emitido información sobre tsunamis para este terremoto. Siga las advertencias oficiales en las zonas costeras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'USGS a émis des informations sur les tsunamis pour ce séisme. Suivez les avertissements officiels dans les zones côtières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'USGS ha emesso informazioni sul maremoto per questo terremoto. Segui le avvertenze ufficiali nelle zone costiere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGSはこの地震に関する津波情報を発表しました。沿岸地域の公式な警告に従ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS опубликовала информацию о цунами для этого землетрясения. Следите за официальными предупреждениями в прибрежных районах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS bu deprem için tsunami bilgisi yayımladı. Kıyı bölgelerindeki resmî uyarıları takip et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το USGS εξέδωσε ενημέρωση για τσουνάμι για αυτό το συμβάν. Ακολούθησε τις επίσημες προειδοποιήσεις για τις ακτές."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O USGS emitiu informação de tsunami para este evento. Siga os alertas oficiais para o litoral."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS mengeluarkan informasi tsunami untuk kejadian ini. Ikuti peringatan pantai resmi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS가 이 지진에 대해 쓰나미 정보를 발표했습니다. 공식 해안 경보를 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS 已就此事件发布海啸信息。请遵循官方沿海警报。"
          }
        }
      }
    },
    "USGS ve Akkar-Bommer azalım modellerine dayalı, odak derinliği kalibreli eş-şiddet konturları." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوط تساوي الشدة معايَرة حسب عمق البؤرة استنادًا إلى نموذجَي التوهين USGS وAkkar-Bommer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isoseisten, kalibriert nach Herdtiefe auf Basis der Dämpfungsmodelle von USGS und Akkar-Bommer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iso-intensity contours calibrated with focal depth based on USGS and Akkar-Bommer attenuation models."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contornos de isointensidad calibrados por profundidad focal según los modelos de atenuación de USGS y Akkar-Bommer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contours d’iso-intensité calibrés selon la profondeur focale, d’après les modèles d’atténuation USGS et Akkar-Bommer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isosiste calibrate sulla profondità focale in base ai modelli di attenuazione USGS e Akkar-Bommer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS と Akkar-Bommer の減衰モデルに基づき、震源深さで補正した等震度線です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изосейсты, откалиброванные по глубине очага на основе моделей затухания USGS и Аккар–Боммера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS ve Akkar-Bommer azalım modellerine dayalı, odak derinliği kalibreli eş-şiddet konturları."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισοσειστές βαθμονομημένες με το βάθος εστίας, βάσει των μοντέλων εξασθένησης USGS και Akkar-Bommer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contornos de isointensidade calibrados pela profundidade focal com base nos modelos de atenuação USGS e Akkar-Bommer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontur isointensitas yang dikalibrasi dengan kedalaman fokus berdasarkan model atenuasi USGS dan Akkar-Bommer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS 및 Akkar-Bommer 감쇠 모델을 바탕으로 진원 깊이로 보정한 등진도선."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 USGS 和 Akkar-Bommer 衰减模型、按震源深度校准的等烈度线。"
          }
        }
      }
    },
