    "help.faq.differences.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الجهات محطات ونماذج وعمليات مراجعة مختلفة. وقد تُراجَع القوة أو العمق أو الموقع بعد النشر الأول. ويحتفظ Sismik بمصدر كل زلزال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Institute nutzen unterschiedliche Stationen, Modelle und Prüfverfahren. Stärke, Tiefe oder Ort können nach der ersten Veröffentlichung revidiert werden. Sismik behält die Quelle zu jedem Ereignis bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agencies use different stations, models and review processes. Magnitude, depth or location may be revised after the first publication. Sismik preserves the source for each event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las agencias usan estaciones, modelos y procesos de revisión distintos. La magnitud, la profundidad o la ubicación pueden revisarse tras la primera publicación. Sismik conserva la fuente de cada evento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agences utilisent des stations, des modèles et des processus de révision différents. La magnitude, la profondeur ou la position peuvent être révisées après la première publication. Sismik conserve la source de chaque événement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli enti usano stazioni, modelli e processi di revisione diversi. Magnitudo, profondità o posizione possono essere riviste dopo la prima pubblicazione. Sismik conserva la fonte di ogni evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各機関は異なる観測点・モデル・検証プロセスを使用しています。マグニチュード、深さ、位置は最初の発表後に修正されることがあります。Sismikは地震ごとに情報源を保持します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведомства используют разные станции, модели и процедуры проверки. Магнитуда, глубина или координаты могут быть уточнены после первой публикации. Sismik сохраняет источник для каждого события."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurumlar farklı istasyonlar, modeller ve revizyon süreçleri kullanır. Büyüklük, derinlik veya konum ilk yayından sonra güncellenebilir. Sismik kaynak bilgisini her depremle birlikte korur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φορείς χρησιμοποιούν διαφορετικούς σταθμούς, μοντέλα και διαδικασίες ελέγχου. Μέγεθος, βάθος ή θέση μπορεί να αναθεωρηθούν μετά την πρώτη δημοσίευση. Το Sismik διατηρεί την πηγή κάθε συμβάντος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As agências usam estações, modelos e processos de revisão diferentes. Magnitude, profundidade ou local podem ser revisados após a primeira publicação. O Sismik mantém a fonte de cada evento."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap lembaga memakai stasiun, model, dan proses peninjauan yang berbeda. Magnitudo, kedalaman, atau lokasi dapat direvisi setelah publikasi pertama. Sismik menyimpan sumber setiap kejadian."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기관마다 관측소, 모델, 검토 절차가 다릅니다. 규모, 깊이, 위치는 첫 발표 후 수정될 수 있습니다. Sismik은 각 이벤트의 출처를 보존합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各机构使用不同的台站、模型和审核流程。震级、深度或位置可能在首次发布后修订。Sismik 会保留每个事件的来源。"
          }
        }
      }
    },
    "help.faq.differences.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لماذا تعرض المصادر قيمًا مختلفة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum zeigen Quellen unterschiedliche Werte an?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why can sources show different values?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué las fuentes pueden mostrar valores distintos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi les sources peuvent-elles afficher des valeurs différentes ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché le fonti possono mostrare valori diversi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "情報源によって数値が異なるのはなぜですか？"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почему источники показывают разные значения?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynaklar neden farklı değerler gösterebilir?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γιατί οι πηγές δείχνουν διαφορετικές τιμές;"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por que as fontes mostram valores diferentes?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengapa sumber bisa menunjukkan nilai berbeda?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출처마다 값이 다른 이유는?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么不同来源的数值不同？"
          }
        }
      }
    },
    "help.faq.location.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم موقعك لتركيز الخريطة على مكان وجودك، وحساب المسافة، والحفاظ على تحديث سجل \"موقعي الحالي\". تعمل الأماكن الأخرى المحفوظة بدون إذن الموقع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Standort wird verwendet, um die Karte auf Ihren aktuellen Aufenthaltsort zu zentrieren, Entfernungen zu berechnen und den Eintrag „Mein Standort“ aktuell zu halten. Andere gespeicherte Orte funktionieren auch ohne Standortberechtigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to center the map on where you are, calculate distance, and keep the “My location” record updated. Other saved locations work without location permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su ubicación se utiliza para centrar el mapa en donde se encuentra, calcular la distancia y mantener actualizado el registro “Mi ubicación”. Los demás lugares guardados funcionan sin permiso de ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position est utilisée pour centrer la carte sur l'endroit où vous vous trouvez, calculer la distance et maintenir à jour l'enregistrement « Ma position ». Les autres lieux enregistrés fonctionnent sans autorisation de localisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua posizione viene utilizzata per centrare la mappa dove ti trovi, calcolare la distanza e mantenere aggiornata la registrazione “La mia posizione”. Gli altri luoghi salvati funzionano anche senza l'autorizzazione alla posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地は、マップを現在地に移動し、距離を計算し、「現在地」の記録を最新に保つために使用されます。その他の保存された場所は、位置情報の権限なしで動作します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше местоположение используется для фокусировки карты на том месте, где вы находитесь, расчета расстояния и поддержания актуальности записи «Мое местоположение». Другие сохраненные места работают и без разрешения на доступ к геопозиции."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunuz haritayı bulunduğunuz yere odaklamak, uzaklık hesaplamak ve “Bulunduğum yer” kaydını güncel tutmak için kullanılır. Kaydettiğiniz diğer yerler konum izni olmadan da çalışır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η θέση σου χρησιμοποιείται για να κεντράρει τον χάρτη, να υπολογίζει αποστάσεις και να ενημερώνει την εγγραφή «Η θέση μου». Οι άλλες αποθηκευμένες τοποθεσίες λειτουργούν χωρίς άδεια τοποθεσίας."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização é usada para centralizar o mapa, calcular distâncias e manter o registro “Minha localização” atualizado. Os outros lugares salvos funcionam sem permissão de localização."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasimu dipakai untuk memusatkan peta, menghitung jarak, dan memperbarui catatan “Lokasiku”. Tempat tersimpan lain berfungsi tanpa izin lokasi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 위치는 지도를 내 위치로 맞추고 거리를 계산하며 ‘내 위치’ 기록을 갱신하는 데 쓰입니다. 다른 저장 장소는 위치 권한 없이도 작동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的位置用于将地图定位到你所在处、计算距离并更新“我的位置”记录。其他已保存地点无需定位权限即可使用。"
          }
        }
      }
    },
    "help.faq.location.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف يُستخدم موقعي؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie wird mein Standort verwendet?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How is my location used?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo se usa mi ubicación?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment ma position est-elle utilisée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come viene usata la mia posizione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報はどのように使われますか？"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как используется моё местоположение?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum bilgim nasıl kullanılır?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς χρησιμοποιείται η τοποθεσία μου;"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como minha localização é usada?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana lokasiku digunakan?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 위치는 어떻게 사용되나요?"
          }
        },
        "zh-Hans" : {
