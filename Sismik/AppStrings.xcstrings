    "paywall.demo.analysis" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوافق هذا الزلزال الضحل مع الحركة الانزلاقية للصدع، ومن المرجح أن الهزة شُعر بها في المناطق القريبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses flache Beben passt zur Seitenverschiebung der Verwerfung; die Erschütterung war wohl in der Nähe spürbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This shallow quake fits the fault’s strike-slip motion; shaking was likely felt nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sismo superficial encaja con el movimiento de desgarre de la falla; probablemente se sintió en los alrededores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce séisme peu profond correspond au coulissement de la faille ; la secousse a probablement été ressentie à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo terremoto superficiale è coerente con il movimento trascorrente della faglia; la scossa è stata probabilmente avvertita nei dintorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この浅い地震は断層の横ずれ運動と整合し、周辺では揺れが感じられた可能性があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это неглубокое землетрясение соответствует сдвиговому движению разлома; толчки, вероятно, ощущались поблизости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sığ odaklı bu deprem, fayın doğrultu atımlı hareketiyle uyumlu; sarsıntı yakın çevrede hissedilmiş olabilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο ρηχός σεισμός ταιριάζει με την οριζόντια ολίσθηση του ρήγματος· η δόνηση πιθανότατα έγινε αισθητή κοντά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este terremoto raso combina com o movimento transcorrente da falha; o tremor provavelmente foi sentido nas proximidades."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gempa dangkal ini sesuai dengan gerak geser mendatar sesar; guncangan kemungkinan terasa di sekitarnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 천발 지진은 단층의 주향이동 운동과 맞으며, 주변에서 흔들림이 느껴졌을 가능성이 큽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次浅源地震与断层的走滑运动相符；附近很可能有震感。"
          }
        }
      }
    },
