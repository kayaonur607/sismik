    "notice.alerts.off.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deprem bildirimlerini uygulamadan kapattın; yakınında deprem olsa da haber vermeyeceğiz. Tek dokunuşla yeniden açabilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You turned off earthquake alerts in the app, so we won't notify you even if a quake hits near you. Turn them back on with one tap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Erdbebenwarnungen in der App ausgeschaltet – wir warnen dich auch bei Beben in deiner Nähe nicht. Mit einem Tippen wieder einschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivaste las alertas de sismos en la app, así que no te avisaremos aunque haya un sismo cerca. Actívalas de nuevo con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as désactivé les alertes séisme dans l'app : aucune alerte même en cas de séisme proche. Réactive-les d'un geste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai disattivato gli avvisi di terremoto nell'app: non ti avviseremo nemmeno per terremoti vicini. Riattivali con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリで地震通知をオフにしているため、近くで地震があってもお知らせしません。ワンタップで再びオンにできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выключили уведомления о землетрясениях в приложении — мы не сообщим даже о толчках рядом. Включите их одним касанием."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفت تنبيهات الزلازل في التطبيق، لذا لن ننبهك حتى لو وقع زلزال قربك. أعد تفعيلها بلمسة واحدة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποίησες τις ειδοποιήσεις σεισμών στην εφαρμογή· δεν θα σε ειδοποιήσουμε ούτε για σεισμό κοντά σου. Ενεργοποίησέ τες ξανά με ένα άγγιγμα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desativou os alertas de terremoto no app, então não avisaremos mesmo se houver um terremoto perto. Reative com um toque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mematikan peringatan gempa di aplikasi, jadi kami tidak akan memberi tahu meski ada gempa di dekatmu. Aktifkan lagi dengan satu ketukan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 지진 알림을 껐기 때문에 근처에서 지진이 나도 알려 드리지 않아요. 한 번에 다시 켤 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已在应用中关闭地震提醒，即使附近发生地震也不会通知你。一键即可重新开启。"
          }
        }
      }
    },
