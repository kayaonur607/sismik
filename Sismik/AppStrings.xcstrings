    "ob2.alerts.location.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Bulunduğum yer\" seyahatte de seninle gelir; uygulama kapalıyken bile, pili yormadan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"My location\" travels with you, even when the app is closed, without draining your battery."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mein Standort“ reist mit – auch bei geschlossener App und ohne den Akku zu belasten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Mi ubicación\" viaja contigo, incluso con la app cerrada y sin gastar batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ma position » voyage avec toi, même app fermée, sans vider la batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"La mia posizione\" viaggia con te, anche con l'app chiusa e senza consumare la batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「現在地」は移動しても一緒に更新。アプリを閉じていても、バッテリーへの負担はわずかです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Моё местоположение» перемещается вместе с вами, даже когда приложение закрыто, почти не расходуя заряд."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"موقعي\" ينتقل معك حتى عند إغلاق التطبيق، دون استنزاف البطارية."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Τοποθεσία μου» ταξιδεύει μαζί σας, ακόμη και με κλειστή εφαρμογή, χωρίς να εξαντλεί την μπαταρία."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Minha localização\" viaja com você, mesmo com o app fechado e sem gastar bateria."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Lokasi saya\" ikut berpindah bersama Anda, bahkan saat aplikasi ditutup, tanpa menguras baterai."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'내 위치'가 이동에 맞춰 함께 업데이트됩니다. 앱이 닫혀 있어도, 배터리 부담 없이."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"我的位置\"随你移动，即使应用关闭也会更新，几乎不耗电。"
          }
        }
      }
    },
