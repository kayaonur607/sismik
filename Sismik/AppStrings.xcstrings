    "safety.before.home.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت الخزائن والأثاث الثقيل في الجدران بإحكام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwere Schränke und Regale fest an der Wand verankern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchor cabinets and shelves that could tip over to the wall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija estanterías y muebles pesados a la pared."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixez solidement les meubles hauts et lourds aux murs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa armadi e scaffali pesanti alle pareti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背の高い家具や家電を突っ張り棒や金具で壁に固定します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надежно закрепите тяжелую мебель и шкафы к стенам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devrilebilecek dolap ve rafları duvara sabitle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στερέωσε στον τοίχο ντουλάπια και ράφια που μπορεί να ανατραπούν."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenda na parede armários e prateleiras que possam tombar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaitkan lemari dan rak yang bisa terguling ke dinding."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "넘어질 수 있는 수납장과 선반을 벽에 고정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将可能倾倒的柜子和架子固定在墙上。"
          }
        }
      }
    },
