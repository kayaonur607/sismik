    "stats.energy.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي معظم الطاقة من أكبر بضعة زلازل؛ ومئات الزلازل الصغيرة معًا لا تضيف إلا القليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast die gesamte Energie stammt von den wenigen stärksten Beben; Hunderte kleine tragen kaum etwas bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost all of the energy comes from the few largest events; hundreds of small ones together add only a sliver."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi toda la energía proviene de los pocos sismos más grandes; cientos de pequeños apenas suman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presque toute l'énergie vient des quelques plus forts ; des centaines de petits n'en ajoutent qu'une infime part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi tutta l'energia viene dai pochi eventi più forti; centinaia di piccoli ne aggiungono una minima parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギーのほぼすべては最大級の数回から生じ、数百の小さな地震を合わせてもわずかです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почти вся энергия приходится на несколько сильнейших событий; сотни слабых дают лишь малую долю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplam enerjinin neredeyse tamamı en büyük birkaç depremden gelir; yüzlerce küçük deprem birlikte bile küçük bir pay tutar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδόν όλη η ενέργεια προέρχεται από τους λίγους μεγαλύτερους σεισμούς· εκατοντάδες μικροί μαζί προσθέτουν ελάχιστη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase toda a energia vem dos poucos maiores eventos; centenas de pequenos juntos somam só uma fração."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hampir semua energi berasal dari beberapa gempa terbesar; ratusan gempa kecil bersama-sama hanya menyumbang sedikit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에너지의 거의 전부가 가장 큰 몇 번의 지진에서 나옵니다. 수백 번의 작은 지진을 합쳐도 아주 적습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几乎所有能量都来自少数最大的地震；数百次小地震加起来也只占一小部分。"
          }
        }
      }
    },
