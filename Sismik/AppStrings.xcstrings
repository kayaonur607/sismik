    "family.notes.placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يصطحب الأطفال، الحيوانات الأليفة، الأدوية…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer holt die Kinder ab, Haustiere, Medikamente…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who picks up the kids, pets, medications…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién recoge a los niños, mascotas, medicinas…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui récupère les enfants, animaux, médicaments…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi prende i bambini, animali, farmaci…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子どもの迎え、ペット、薬など…"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто забирает детей, питомцы, лекарства…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çocukları okuldan kim alacak, evcil hayvanlar, ilaçlar…"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποιος παίρνει τα παιδιά, τα κατοικίδια, τα φάρμακα…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem busca as crianças, os pets, os remédios…"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa menjemput anak, hewan peliharaan, obat…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이, 반려동물, 약은 누가 챙길지…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谁去接孩子、带宠物和药品……"
          }
        }
      }
    },
    "family.outOfTown.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الزلزال تزدحم الخطوط المحلية بينما تبقى الخطوط البعيدة مفتوحة غالبًا. يبلغ الجميع هذا الشخص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Beben sind lokale Leitungen überlastet, Ferngespräche klappen oft noch. Alle melden sich bei dieser Person."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a quake, local lines jam while long-distance lines often stay open. Everyone checks in with this person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un sismo las líneas locales se saturan y las de larga distancia suelen seguir abiertas. Todos avisan a esta persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un séisme, les lignes locales saturent alors que les appels longue distance passent souvent. Tout le monde donne des nouvelles à cette personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un terremoto le linee locali si intasano, quelle a lunga distanza spesso restano libere. Tutti avvisano questa persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震後は地元の回線がつながりにくくなりますが、遠方への回線は通じることが多いです。全員がこの人に連絡します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После землетрясения местные линии перегружены, а междугородние часто работают. Все сообщают о себе этому человеку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deprem sonrası yerel hatlar kilitlenir, şehirler arası hatlar çoğu zaman açık kalır. Herkes bu kişiye haber versin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από σεισμό οι τοπικές γραμμές μπλοκάρουν, ενώ οι υπεραστικές συχνά λειτουργούν. Όλοι επικοινωνούν με αυτό το άτομο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após um terremoto, as linhas locais congestionam, mas as de longa distância costumam funcionar. Todos dão notícias a essa pessoa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah gempa, jalur lokal padat sementara jalur jarak jauh sering tetap terbuka. Semua orang melapor ke orang ini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지진 후 지역 회선은 막혀도 장거리 회선은 대개 열려 있습니다. 모두 이 사람에게 연락합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震后本地线路拥堵，长途线路往往仍然畅通。所有人都向此人报平安。"
          }
        }
      }
    },
