    "stats.mag.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معظم الزلازل صغيرة ولا تُلاحظ. كل زيادة بدرجة واحدة تعني طاقة أكبر بنحو 32 مرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Beben sind klein und unbemerkt. Jede Stufe mehr Magnitude setzt etwa 32-mal so viel Energie frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most earthquakes are small and go unnoticed. Each step up in magnitude releases about 32 times more energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría son pequeños y pasan desapercibidos. Cada punto más de magnitud libera unas 32 veces más energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des séismes sont faibles et passent inaperçus. Chaque point de magnitude libère environ 32 fois plus d'énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte è piccola e non si avverte. Ogni punto in più di magnitudo libera circa 32 volte più energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどの地震は小さく、揺れを感じません。マグニチュードが1上がると、エネルギーは約32倍になります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большинство землетрясений слабые и незаметны. Каждая единица магнитуды — примерно в 32 раза больше энергии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depremlerin çoğu küçüktür ve hissedilmez. Büyüklükte 1 birimlik artış, yaklaşık 32 kat daha fazla enerji demektir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι περισσότεροι σεισμοί είναι μικροί και περνούν απαρατήρητοι. Κάθε μονάδα μεγέθους απελευθερώνει περίπου 32 φορές περισσότερη ενέργεια."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria dos terremotos é pequena e passa despercebida. Cada ponto a mais de magnitude libera cerca de 32 vezes mais energia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagian besar gempa kecil dan tidak terasa. Setiap kenaikan satu magnitudo melepaskan sekitar 32 kali lebih banyak energi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 지진은 작아서 느끼지 못합니다. 규모가 1 오를 때마다 에너지는 약 32배가 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数地震很小，不易察觉。震级每增加 1，释放的能量约增加 32 倍。"
          }
        }
      }
    },
