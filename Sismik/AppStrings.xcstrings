    "risk.felt.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شدة مقدّرة من القوة والعمق والمسافة؛ قد تغيّر ظروف التربة الاهتزاز الفعلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Magnitude, Tiefe und Entfernung geschätzte Intensität; der Untergrund kann die tatsächliche Erschütterung verändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensity estimated from magnitude, depth and distance; local ground conditions can change the actual shaking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidad estimada a partir de magnitud, profundidad y distancia; el tipo de suelo puede cambiar la sacudida real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensité estimée d'après la magnitude, la profondeur et la distance ; la nature du sol peut modifier la secousse réelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensità stimata da magnitudo, profondità e distanza; il tipo di suolo può cambiare lo scuotimento reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マグニチュード・深さ・距離から推定した震度です。地盤条件により実際の揺れは変わります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интенсивность оценена по магнитуде, глубине и расстоянию; грунт может изменить реальные сотрясения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyüklük, derinlik ve uzaklıktan tahmin edilen şiddettir; zemin koşulları gerçek sarsıntıyı değiştirebilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένταση που εκτιμάται από μέγεθος, βάθος και απόσταση· οι τοπικές εδαφικές συνθήκες μπορεί να αλλάξουν την πραγματική δόνηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidade estimada por magnitude, profundidade e distância; as condições do solo podem alterar o tremor real."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
