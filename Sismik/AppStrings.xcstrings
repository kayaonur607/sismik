    "places.free.downgrade" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الخطة المجانية تصل التنبيهات لأول مكان فقط (حتى 50 كم). أماكنك الأخرى محفوظة وتعود مع Premium."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos gibt es nur Hinweise für deinen ersten Ort (bis 50 km). Andere Orte bleiben gespeichert und kehren mit Premium zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the free plan, only your first place (within 50 km) sends alerts. Your other places and settings are kept and return with Premium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el plan gratuito solo avisa tu primer lugar (hasta 50 km). Tus otros lugares se conservan y vuelven con Premium."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l’offre gratuite, seul votre premier lieu (jusqu’à 50 km) envoie des alertes. Vos autres lieux sont conservés et reviennent avec Premium."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il piano gratuito avvisa solo il primo luogo (entro 50 km). Gli altri luoghi restano salvati e tornano con Premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランでは最初の場所(50 km以内)のみ通知されます。他の場所と設定は保持され、プレミアムで戻ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В бесплатном плане оповещения приходят только для первого места (до 50 км). Остальные места сохранены и вернутся с Premium."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz planda yalnızca ilk yerin 50 km'lik çevresi için bildirim gelir. Diğer yerlerin ve ayarların silinmedi; Premium'la geri gelir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο δωρεάν πλάνο ειδοποιήσεις στέλνει μόνο η πρώτη σου τοποθεσία (έως 50 km). Οι άλλες τοποθεσίες και ρυθμίσεις διατηρούνται και επιστρέφουν με το Premium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No plano gratuito, só seu primeiro lugar (até 50 km) envia alertas. Os outros lugares e ajustes ficam guardados e voltam com o Premium."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di paket gratis, hanya tempat pertamamu (hingga 50 km) yang mengirim peringatan. Tempat dan pengaturan lain tetap tersimpan dan aktif lagi dengan Premium."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 요금제에서는 첫 번째 장소(50 km 이내)만 알림을 보냅니다. 다른 장소와 설정은 보관되며 Premium으로 다시 켜집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费方案仅第一个地点（50 公里内）会发送提醒。其他地点和设置会保留，升级 Premium 后恢复。"
          }
        }
      }
    },
