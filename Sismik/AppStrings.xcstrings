    "pi.gm.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkar–Bommer azalım modeliyle odak derinliği ve uzaklığa göre hesaplanan tahmini zemin hareketi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated ground motion from the Akkar–Bommer attenuation model using focal depth and distance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzte Bodenbewegung nach dem Akkar–Bommer-Dämpfungsmodell aus Herdtiefe und Entfernung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimiento del suelo estimado con el modelo de atenuación de Akkar–Bommer según profundidad y distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouvement du sol estimé par le modèle d'atténuation d'Akkar–Bommer selon profondeur et distance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moto del suolo stimato con il modello di attenuazione di Akkar–Bommer in base a profondità e distanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkar–Bommer 減衰モデルで震源の深さと距離から推定した地盤の揺れです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка движения грунта по модели затухания Акара–Боммера с учётом глубины и расстояния."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة أرضية مقدّرة بنموذج التخامد Akkar–Bommer وفق عمق البؤرة والمسافة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτιμώμενη εδαφική κίνηση με το μοντέλο απόσβεσης Akkar–Bommer βάσει βάθους και απόστασης."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento do solo estimado pelo modelo de atenuação de Akkar–Bommer com profundidade e distância."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan gerakan tanah dari model atenuasi Akkar–Bommer berdasarkan kedalaman fokus dan jarak."
