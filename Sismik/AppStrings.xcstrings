    "places.background.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Bulunduğum yer\" uygulama kapalıyken de seninle taşınır. Yalnızca belirgin yer değişikliğinde, kabaca konum kullanılır; pil etkisi çok düşüktür. \"Her zaman\" konum izni gerekir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"My location\" moves with you even when the app is closed. Only approximate location is used, after a significant move; battery impact is minimal. Requires \"Always\" location access."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mein Standort“ zieht auch bei geschlossener App mit. Nur ungefährer Standort nach deutlichem Ortswechsel; kaum Akkuverbrauch. Erfordert Standortzugriff „Immer“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Mi ubicación\" se mueve contigo aunque la app esté cerrada. Solo se usa una ubicación aproximada tras un cambio significativo; apenas consume batería. Requiere acceso a la ubicación \"Siempre\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ma position » te suit même app fermée. Seule une position approximative est utilisée après un déplacement important ; impact minime sur la batterie. Nécessite l'accès à la position « Toujours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"La mia posizione\" ti segue anche con l'app chiusa. Si usa solo una posizione approssimativa dopo uno spostamento significativo; consumo minimo. Richiede l'accesso alla posizione \"Sempre\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを閉じていても「現在地」が移動に合わせて更新されます。大きく移動したときだけ、おおよその位置を使用し、バッテリーへの影響はごくわずかです。位置情報の「常に」許可が必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Моё местоположение» обновляется, даже когда приложение закрыто. Используется приблизительное местоположение и только при значительном перемещении; расход заряда минимален. Нужен доступ к геопозиции «Всегда»."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"موقعي\" ينتقل معك حتى عند إغلاق التطبيق. يُستخدم موقع تقريبي فقط بعد تغيّر ملحوظ؛ التأثير على البطارية ضئيل. يتطلب إذن الموقع \"دائمًا\"."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Τοποθεσία μου» μετακινείται μαζί σας ακόμη και με κλειστή εφαρμογή. Χρησιμοποιείται μόνο κατά προσέγγιση τοποθεσία μετά από σημαντική μετακίνηση· ελάχιστη κατανάλωση μπαταρίας. Απαιτεί πρόσβαση στην τοποθεσία «Πάντα»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Minha localização\" acompanha você mesmo com o app fechado. Só uma localização aproximada é usada, após um deslocamento significativo; impacto mínimo na bateria. Requer acesso à localização \"Sempre\"."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Lokasi saya\" ikut berpindah bahkan saat aplikasi ditutup. Hanya lokasi perkiraan yang dipakai, setelah perpindahan signifikan; dampak baterai sangat kecil. Memerlukan izin lokasi \"Selalu\"."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 닫혀 있어도 '내 위치'가 함께 이동합니다. 크게 이동했을 때만 대략적인 위치를 사용하며 배터리 영향은 미미합니다. 위치 접근 '항상' 권한이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使应用关闭，\"我的位置\"也会随你移动。仅在明显移动后使用大致位置，耗电极少。需要\"始终\"位置权限。"
          }
        }
      }
    },
