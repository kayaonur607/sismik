    "firstaid.cpr.metronome.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغطة مع كل نبضة: 110 في الدقيقة. إن كان الصوت مغلقًا فاتبع الاهتزاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Druck pro Takt: 110 pro Minute. Ohne Ton der Vibration folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One push per beat: 110 per minute. If sound is off, follow the vibration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una compresión por golpe: 110 por minuto. Si no hay sonido, sigue la vibración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une compression par battement : 110 par minute. Sans son, suivez la vibration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una spinta per battito: 110 al minuto. Senza audio, segui la vibrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1拍ごとに1回、1分間に110回。音が出ないときは振動に合わせる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно нажатие на удар: 110 в минуту. Если звук выключен, ориентируйтесь на вибрацию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her tıkta bir bası: dakikada 110. Ses kapalıysa titreşimi takip et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία συμπίεση ανά χτύπο: 110 το λεπτό. Αν ο ήχος είναι κλειστός, ακολούθησε τη δόνηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compressão por batida: 110 por minuto. Sem som, siga a vibração."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu tekanan per ketukan: 110 per menit. Jika suara mati, ikuti getarannya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "박자마다 한 번: 분당 110회. 소리가 꺼져 있으면 진동을 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每拍按压一次：每分钟 110 次。若无声音，跟随振动。"
          }
        }
      }
    },
