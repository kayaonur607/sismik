    "firstaid.burn.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برّد الحرق بماء فاتر جارٍ لمدة 10–20 دقيقة؛ ولا تستخدم الثلج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbrennung 10–20 Minuten unter lauwarmem fließendem Wasser kühlen; kein Eis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cool the burn under lukewarm running water for 10–20 minutes; don't use ice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfría la quemadura con agua tibia corriente 10–20 minutos; no uses hielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refroidissez la brûlure 10 à 20 minutes sous l'eau tiède courante ; pas de glace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raffredda l'ustione sotto acqua tiepida corrente per 10–20 minuti; niente ghiaccio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぬるい流水で10〜20分冷やす。氷は使わない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Охлаждайте ожог под тёплой проточной водой 10–20 минут; не используйте лёд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanan bölgeyi 10–20 dakika ılık akan suyla soğut; buz kullanma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρύωσε το έγκαυμα με χλιαρό τρεχούμενο νερό για 10–20 λεπτά· μη χρησιμοποιείς πάγο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resfrie a queimadura em água corrente morna por 10–20 minutos; não use gelo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinginkan luka bakar di bawah air mengalir suam-suam kuku 10–20 menit; jangan gunakan es."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미지근한 흐르는 물에 10–20분 식히고 얼음은 쓰지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用温水冲洗烧伤处 10–20 分钟；不要用冰。"
          }
        }
      }
    },
    "firstaid.burn.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزع الخواتم والساعات وكل ما يضغط قبل أن يبدأ التورم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringe, Uhren und Enges entfernen, bevor es anschwillt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove rings, watches and anything tight before swelling starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita anillos, relojes y lo que apriete antes de que se hinche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez bagues, montre et tout ce qui serre avant que ça gonfle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Togli anelli, orologi e ciò che stringe prima che si gonfi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腫れる前に指輪や時計など締めつける物を外す。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите кольца, часы и всё тесное, пока не началась отёчность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şişmeden önce yüzük, saat gibi sıkan eşyaları çıkar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βγάλε δαχτυλίδια, ρολόγια και ό,τι σφίγγει πριν αρχίσει το πρήξιμο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire anéis, relógios e o que apertar antes de inchar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepas cincin, jam tangan, dan apa pun yang ketat sebelum bengkak."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붓기 전에 반지, 시계 등 조이는 것을 빼세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在肿胀前取下戒指、手表等紧箍物品。"
          }
        }
      }
    },
    "firstaid.burn.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تفقأ البثور؛ ولا تضع معجون أسنان أو زيتًا أو كريمات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blasen nicht öffnen; keine Zahnpasta, kein Öl, keine Cremes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't pop blisters; don't apply toothpaste, oil or creams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No revientes ampollas; no pongas pasta de dientes, aceite ni cremas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne percez pas les cloques ; pas de dentifrice, d'huile ni de crème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non rompere le vesciche; niente dentifricio, olio o creme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水ぶくれはつぶさず、歯みがき粉・油・クリームは塗らない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вскрывайте пузыри; не наносите пасту, масло или кремы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabarcıkları patlatma; diş macunu, yağ ya da krem sürme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη σπας τις φουσκάλες· μη βάζεις οδοντόκρεμα, λάδι ή κρέμες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estoure bolhas; não passe pasta de dente, óleo ou cremes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan pecahkan lepuh; jangan oleskan pasta gigi, minyak, atau krim."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물집을 터뜨리지 말고 치약, 기름, 크림을 바르지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要挑破水泡；不要涂牙膏、油或药膏。"
          }
        }
      }
    },
    "firstaid.burn.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غطِّه بشكل فضفاض بقماش نظيف غير لاصق أو بغلاف بلاستيكي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locker mit sauberem, nicht haftendem Tuch oder Frischhaltefolie abdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cover loosely with a clean, non-stick cloth or cling film."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre sin apretar con un paño limpio que no se pegue o film transparente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couvrez sans serrer avec un linge propre non adhérent ou du film alimentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copri senza stringere con un panno pulito non aderente o pellicola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清潔でくっつかない布かラップで、ゆるく覆う。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неплотно накройте чистой неприлипающей тканью или пищевой плёнкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temiz ve yapışmayan bir bezle ya da streç filmle gevşekçe ört."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάλυψε χαλαρά με καθαρό, μη κολλώδες ύφασμα ή μεμβράνη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubra sem apertar com um pano limpo que não grude ou filme plástico."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup longgar dengan kain bersih yang tidak lengket atau plastik wrap."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깨끗하고 달라붙지 않는 천이나 랩으로 느슨하게 덮으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用干净、不粘的布或保鲜膜轻轻覆盖。"
          }
        }
      }
    },
    "firstaid.burn.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برّده فورًا بماء فاتر جارٍ لفترة طويلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofort lange unter lauwarmem fließendem Wasser kühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cool it right away under lukewarm running water for a long time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfríala enseguida con agua tibia corriente durante un buen rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refroidissez tout de suite et longtemps sous l'eau tiède courante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raffredda subito e a lungo sotto acqua tiepida corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐにぬるい流水で長めに冷やす。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу и долго охлаждайте под тёплой проточной водой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemen ılık akan suyla uzun süre soğut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρύωσέ το αμέσως με χλιαρό τρεχούμενο νερό για αρκετή ώρα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resfrie imediatamente em água corrente morna por bastante tempo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segera dinginkan di bawah air mengalir suam-suam kuku cukup lama."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즉시 미지근한 흐르는 물에 오래 식히세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即用温水长时间冲洗降温。"
          }
        }
      }
    },
