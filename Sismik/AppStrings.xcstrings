    },
    "intensity.desc.7_8" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صعوبة في الوقوف؛ احتمال حدوث أضرار في المباني الضعيفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stehen fällt schwer; Schäden an schwachen Bauwerken möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing may be difficult; vulnerable buildings may be damaged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difícil mantenerse en pie; posibles daños en construcciones vulnerables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
