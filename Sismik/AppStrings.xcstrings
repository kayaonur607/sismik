    "safety.after.lines.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل فقط في حالات الطوارئ القصوى؛ استخدم الرسائل النصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur im echten Notfall telefonieren; SMS/Messenger bevorzugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call only in a real emergency; prefer text messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llama solo en emergencias graves; prefiere mensajes de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne téléphonez qu'en urgence vitale ; privilégiez les SMS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefona solo in emergenze gravi; usa messaggi di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話は救急専用に空け、安否確認はメッセージアプリを活用してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звоните только при угрозе жизни; используйте текстовые сообщения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca gerçek acil durumda ara; kısa mesajı tercih et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάλεσε μόνο σε πραγματική ανάγκη· προτίμησε μηνύματα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue só em emergência real; prefira mensagens de texto."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menelepon dalam keadaan darurat nyata; utamakan pesan teks."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 긴급 상황에만 전화하고, 문자 메시지를 우선하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在真正紧急时拨打电话；优先发短信。"
          }
        }
      }
    },
