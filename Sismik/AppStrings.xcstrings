    "pi.location.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarsıntının sana etkisini hesaplamak için konumuna izin ver ya da takip edeceğin bir yer ekle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location or add a place to follow so we can estimate how the shaking affected you."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standort oder füge einen Ort hinzu, damit wir die Auswirkung auf dich schätzen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la ubicación o añade un lugar para estimar cómo te afectó la sacudida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise la position ou ajoute un lieu pour estimer l'effet de la secousse sur toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti la posizione o aggiungi un luogo per stimare l'effetto dello scuotimento su di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揺れの影響を推定するには、位置情報を許可するか場所を追加してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите геопозицию или добавьте место, чтобы оценить, как вас затронули сотрясения."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالموقع أو أضف مكانًا لتقدير أثر الاهتزاز عليك."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε την τοποθεσία ή πρόσθεσε ένα μέρος για να εκτιμήσουμε πώς σε επηρέασε η δόνηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a localização ou adicione um lugar para estimar como o tremor afetou você."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan lokasi atau tambahkan tempat agar kami bisa memperkirakan dampak guncangan padamu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흔들림이 나에게 미친 영향을 추정하려면 위치를 허용하거나 장소를 추가하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请允许位置权限或添加关注地点，以估算震动对你的影响。"
          }
        }
      }
