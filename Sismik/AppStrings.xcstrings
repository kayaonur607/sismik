    "places.premium.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنزل، العمل، مدينة العائلة — احفظ ما يصل إلى 8 أماكن. حدد شعاعًا وعتبة قوة منفصلة لكل منها؛ واحصل على إشعارات فورية باسم المكان عند حدوث زلزال في تلك المنطقة. تظهر شعاعاتك أيضًا على الخريطة، ويمكنك إضافة مكان جديد بالضغط المطوّل على الخريطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuhause, Arbeit, Stadt der Familie — speichere bis zu 8 Orte. Lege für jeden Ort einen eigenen Radius und eine Stärkeschwelle fest; erhalte sofortige Benachrichtigungen mit Name, wenn in dieser Region ein Erdbeben auftritt. Deine Radien sind auf der Karte sichtbar, und durch langes Drücken auf die Karte fügst du einen neuen Ort hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home, work, family's city — save up to 8 places. Set a custom radius and magnitude threshold for each; get instant notifications with its name when an earthquake occurs in that region. Your radii are visible on the map, and you can long press on the map to add a new place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, trabajo, la ciudad de tu familia: guarda hasta 8 lugares. Establece un radio y un umbral de magnitud individuales para cada uno; recibe notificaciones al instante con su nombre cuando ocurra un terremoto en esa zona. Tus radios se verán en el mapa y puedes mantener presionado el mapa para añadir un nuevo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domicile, travail, ville de la famille — enregistrez jusqu'à 8 lieux. Définissez un rayon et un seuil de magnitude distincts pour chacun ; recevez des notifications instantanées avec son nom lorsqu'un séisme survient dans cette région. Vos rayons sont visibles sur la carte, et un appui long sur la carte permet d'ajouter un nouveau lieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, lavoro, la città della famiglia — salva fino a 8 luoghi. Imposta un raggio e una soglia di magnitudo separati per ciascuno; ricevi notifiche istantanee con il relativo nome quando si verifica un terremoto in quella regione. I tuoi raggi sono visibili sulla mappa e puoi aggiungere un nuovo luogo premendo a lungo sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅、職場、家族の街など、最大8つの場所を保存できます。それぞれに個別で半径とマグニチュードのしきい値を設定し、その地域で地震が発生した際には名前付きで即座に通知を受け取れます。半径はマップ上にも表示され、マップを長押しして新しい場所を追加できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дом, работа, город семьи — сохраняйте до 8 мест. Задайте отдельный радиус и порог магнитуды для каждого; получайте мгновенные уведомления с его названием при землетрясении в этом регионе. Ваши радиусы видны на карте, а новое место можно добавить долгим нажатием на карту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev, iş, ailenin şehri — 8 yere kadar kaydet. Her biri için ayrı yarıçap ve büyüklük eşiği belirle; o bölgede deprem olduğunda adıyla birlikte anında bildirim al. Yarıçapların haritada da görünür, haritaya uzun basarak yeni yer eklersin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σπίτι, δουλειά, πόλη της οικογένειας — αποθήκευσε έως 8 τοποθεσίες. Όρισε για καθεμία ακτίνα και όριο μεγέθους· λάβε άμεση ειδοποίηση με το όνομά της όταν γίνει σεισμός εκεί. Οι ακτίνες φαίνονται στον χάρτη και με παρατεταμένο πάτημα προσθέτεις νέα τοποθεσία."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, trabalho, cidade da família — salve até 8 lugares. Defina raio e limite de magnitude para cada um; receba notificação na hora com o nome dele quando houver um terremoto na região. Os raios aparecem no mapa, e você pode tocar e segurar no mapa para adicionar um lugar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah, kantor, kota keluarga — simpan hingga 8 tempat. Atur radius dan ambang magnitudo untuk masing-masing; dapatkan notifikasi instan dengan namanya saat gempa terjadi di wilayah itu. Radius terlihat di peta, dan kamu bisa tekan lama di peta untuk menambah tempat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집, 직장, 가족의 도시 — 최대 8곳까지 저장하세요. 장소마다 반경과 규모 기준을 정하면 그 지역에 지진이 날 때 장소 이름으로 즉시 알려 드립니다. 반경은 지도에 표시되며, 지도를 길게 눌러 새 장소를 추가할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家、工作地点、家人所在城市——最多保存 8 个地点。为每个地点设置半径和震级阈值；该区域发生地震时，立即以地点名称通知你。半径会显示在地图上，长按地图即可添加新地点。"
          }
        }
      }
    },
