    "list.empty.source.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ yalnızca kendi bölgesindeki (%2$@) depremleri yayımlar; sakin dönemlerde liste boş kalabilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ only reports quakes in its own region (%2$@), so the list can be empty during quiet periods."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ meldet nur Beben in seiner Region (%2$@); in ruhigen Zeiten kann die Liste leer sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ solo publica sismos de su región (%2$@); en periodos tranquilos la lista puede estar vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne publie que les séismes de sa région (%2$@) ; en période calme, la liste peut être vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pubblica solo i terremoti della sua regione (%2$@); nei periodi tranquilli la lista può essere vuota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は自分の地域（%2$@）の地震のみを発表するため、静かな時期はリストが空になることがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ публикует только землетрясения своего региона (%2$@), поэтому в спокойные периоды список может быть пуст."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنشر %1$@ زلازل منطقتها فقط (%2$@)، لذا قد تكون القائمة فارغة في الفترات الهادئة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %1$@ δημοσιεύει μόνο σεισμούς της περιοχής του (%2$@)· σε ήσυχες περιόδους η λίστα μπορεί να είναι κενή."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ só publica terremotos da própria região (%2$@); em períodos calmos a lista pode ficar vazia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hanya melaporkan gempa di wilayahnya (%2$@), jadi daftar bisa kosong saat periode tenang."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 자기 지역(%2$@)의 지진만 발표하므로 조용한 시기에는 목록이 비어 있을 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 仅发布其所在区域（%2$@）的地震，平静时期列表可能为空。"
          }
        }
      }
    },
