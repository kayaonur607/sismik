          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震情報、近くの集合場所、緊急ツールをひとつのアプリで確認できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изучайте землетрясения, находите ближайшие места сбора и пользуйтесь экстренными инструментами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depremleri incele, yakınındaki toplanma alanlarını bul ve acil araçlarına tek yerden ulaş."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξερεύνησε σεισμούς, βρες κοντινούς χώρους συγκέντρωσης και έχε πάντα κοντά τα εργαλεία έκτακτης ανάγκης."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe terremotos, encontre pontos de encontro próximos e tenha as ferramentas de emergência à mão."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelajahi gempa, temukan titik kumpul terdekat, dan simpan alat darurat di dekatmu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지진을 살펴보고, 가까운 대피 장소를 찾고, 긴급 도구를 가까이 두세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看地震、寻找附近的集合点，让应急工具随手可用。"
          }
        }
      }
    },
