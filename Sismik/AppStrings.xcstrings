    "Bu olay için %@ veya doğrulanmış USGS ShakeMap tarafından yayımlanan MMI gösterilir. Konum, uzaklık veya büyüklükten tahmin üretilmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض MMI المنشورة بواسطة %@ أو ShakeMap معتمدة من USGS لهذا الحدث. لا يتم استنتاج أي تقدير من الموقع أو المسافة أو القوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Ereignis wird die von %@ oder einer verifizierten USGS ShakeMap veröffentlichte MMI angezeigt. Es wird keine Schätzung aus Standort, Entfernung oder Stärke abgeleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MMI published by %@ or a verified USGS ShakeMap is shown for this event. No estimate is derived from location, distance, or magnitude."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra la MMI publicada por %@ o un ShakeMap verificado del USGS para este evento. No se deriva ninguna estimación de la ubicación, distancia o magnitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intensité MMI publiée par %@ ou un ShakeMap vérifié de l'USGS est affichée pour cet événement. Aucune estimation n'est calculée à partir de l'emplacement, de la distance ou de la magnitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questo evento viene mostrata la MMI pubblicata da %@ o uno ShakeMap USGS verificato. Nessuna stima viene ricavata da posizione, distanza o magnitudo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
