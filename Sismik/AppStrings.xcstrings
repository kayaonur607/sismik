    "firstaid.cpr.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدّد الشخص على ظهره فوق سطح صلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person auf dem Rücken auf eine harte Unterlage legen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay the person on their back on a firm surface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumba a la persona boca arriba sobre una superficie firme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allongez la personne sur le dos, sur une surface dure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stendi la persona sulla schiena su una superficie rigida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硬い床の上にあお向けに寝かせる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уложите человека на спину на твёрдую поверхность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişiyi sert bir zemine sırtüstü yatır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξάπλωσε το άτομο ανάσκελα σε σκληρή επιφάνεια."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deite a pessoa de costas em uma superfície firme."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baringkan orang itu telentang di permukaan yang keras."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "딱딱한 바닥에 똑바로 눕히세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让患者仰卧在坚硬的平面上。"
          }
        }
      }
    },
    "firstaid.cpr.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع قاعدة إحدى يديك في منتصف الصدر وشبّك اليد الأخرى فوقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handballen in die Mitte des Brustkorbs legen, die andere Hand darüber verschränken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the heel of one hand in the center of the chest and interlock the other hand on top."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el talón de una mano en el centro del pecho y entrelaza la otra encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez le talon d'une main au centre de la poitrine et l'autre main par-dessus, doigts entrelacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti il palmo di una mano al centro del torace e intreccia l'altra sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸の真ん中に片手の付け根を置き、もう一方の手を重ねて組む。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте основание ладони на центр груди, другую руку положите сверху, сцепив пальцы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir elinin topuğunu göğsün ortasına koy, diğer elini üstüne kenetle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε τη βάση της παλάμης στο κέντρο του θώρακα και πλέξε το άλλο χέρι από πάνω."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque a base de uma mão no centro do peito e entrelace a outra por cima."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan pangkal telapak tangan di tengah dada dan kaitkan tangan lainnya di atasnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 손바닥 아랫부분을 가슴 중앙에 대고 다른 손을 깍지 껴 위에 올리세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一只手掌根放在胸部中央，另一只手叠放其上、十指相扣。"
          }
        }
      }
    },
    "firstaid.cpr.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بذراعين مستقيمتين، اضغط بعمق 5–6 سم بمعدل 100–120 مرة في الدقيقة. استخدم الإيقاع أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit gestreckten Armen 5–6 cm tief drücken, 100–120 Mal pro Minute. Nutze den Takt unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With straight arms, push 5–6 cm deep at 100–120 per minute. Use the rhythm below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los brazos rectos, presiona 5–6 cm a 100–120 por minuto. Usa el ritmo de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bras tendus, enfoncez de 5–6 cm à 100–120 par minute. Suivez le rythme ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A braccia tese, spingi 5–6 cm a 100–120 al minuto. Usa il ritmo qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕を伸ばし、1分間に100〜120回、深さ5〜6 cmで押す。下のリズムを使う。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прямыми руками надавливайте на 5–6 см с частотой 100–120 в минуту. Используйте ритм ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolların düz, dakikada 100–120 hızla ve 5–6 cm derinlikte bastır. Aşağıdaki ritmi kullan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τεντωμένα χέρια, πίεσε 5–6 cm βάθος με ρυθμό 100–120 το λεπτό. Χρησιμοποίησε τον ρυθμό παρακάτω."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os braços esticados, comprima 5–6 cm a 100–120 por minuto. Use o ritmo abaixo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan lengan lurus, tekan sedalam 5–6 cm dengan laju 100–120 per menit. Ikuti ritme di bawah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔을 곧게 펴고 분당 100–120회, 5–6 cm 깊이로 누르세요. 아래 리듬을 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双臂伸直，以每分钟 100–120 次、深 5–6 厘米按压。跟随下方节奏。"
          }
        }
      }
    },
    "firstaid.cpr.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك الصدر يرتفع بالكامل بعد كل ضغطة؛ ولا تتوقف حتى تصل المساعدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jedem Druck den Brustkorb vollständig entlasten; nicht aufhören, bis Hilfe da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the chest rise fully after each push; don't stop until help arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el pecho vuelva por completo tras cada compresión; no pares hasta que llegue ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la poitrine remonter complètement après chaque compression ; ne vous arrêtez pas avant l'arrivée des secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia risalire completamente il torace dopo ogni spinta; non fermarti finché non arrivano i soccorsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押すたびに胸を元の高さまで戻し、助けが来るまで続ける。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После каждого нажатия дайте груди полностью расправиться; не останавливайтесь до прибытия помощи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her basıdan sonra göğsün tamamen kalkmasına izin ver; yardım gelene kadar durma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άφησε το θώρακα να επανέλθει πλήρως μετά από κάθε συμπίεση· μη σταματάς μέχρι να έρθει βοήθεια."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o peito voltar totalmente após cada compressão; não pare até a ajuda chegar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan dada kembali penuh setiap selesai menekan; jangan berhenti sampai bantuan tiba."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누를 때마다 가슴이 완전히 올라오게 하고, 도움이 올 때까지 멈추지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次按压后让胸廓完全回弹；在救援到达前不要停止。"
          }
        }
      }
    },
    "firstaid.cpr.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للبالغ الذي لا يتنفس: ضغطات على الصدر دون توقف حتى وصول المساعدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Erwachsenen ohne Atmung: Brustkorbkompressionen ohne Pause, bis Hilfe kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For an adult who isn't breathing: chest compressions without pause until help arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un adulto que no respira: compresiones torácicas sin parar hasta que llegue ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chez un adulte qui ne respire pas : compressions thoraciques sans interruption jusqu'à l'arrivée des secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un adulto che non respira: compressioni toraciche senza sosta fino all'arrivo dei soccorsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸のない大人には、助けが来るまで休まず胸骨圧迫を続ける。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Взрослому без дыхания — компрессии грудной клетки без перерыва до прибытия помощи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solumayan yetişkinde yardım gelene kadar ara vermeden göğüs basısı."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ενήλικα που δεν αναπνέει: θωρακικές συμπιέσεις χωρίς διακοπή μέχρι να έρθει βοήθεια."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um adulto que não respira: compressões torácicas sem parar até a ajuda chegar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk orang dewasa yang tidak bernapas: kompresi dada tanpa henti sampai bantuan tiba."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨을 쉬지 않는 성인: 도움이 올 때까지 쉬지 말고 가슴 압박."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成人无呼吸时：持续胸外按压直至救援到达。"
          }
        }
      }
    },
