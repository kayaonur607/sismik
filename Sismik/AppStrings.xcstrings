        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah kamu merasakan gempa ini?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지진을 느끼셨나요?"
          }
