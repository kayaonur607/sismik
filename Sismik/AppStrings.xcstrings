    "intro.emergency.location.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ إحداثياتك بلمسة واحدة أو أرسلها عبر رسالة؛ هذا كل ما تحتاجه فرق البحث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere deine Koordinaten mit einem Tipp oder sende sie per Nachricht – das ist alles, was Suchteams brauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy or message your exact coordinates — that's all rescue teams need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia tus coordenadas con un toque o envíalas por mensaje: es todo lo que necesitan los equipos de búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez vos coordonnées en un touché ou envoyez-les par message ; c'est tout ce dont les équipes de recherche ont besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia le tue coordinate con un tocco o inviale tramite messaggio: è tutto ciò di cui hanno bisogno le squadre di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンタップで座標をコピーまたはメッセージで送信できます。救助隊に必要なのはこれだけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте координаты одним касанием или отправьте сообщением — это всё, что нужно поисково-спасательным группам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koordinatını tek dokunuşla kopyala ya da mesajla gönder; arama ekiplerinin ihtiyacı olan tek şey bu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντέγραψε ή στείλε τις ακριβείς συντεταγμένες σου — αυτό χρειάζονται οι διασώστες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie ou envie suas coordenadas exatas — é tudo de que as equipes de resgate precisam."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin atau kirim koordinat tepatmu — hanya itu yang dibutuhkan tim penyelamat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정확한 좌표를 복사하거나 보내세요. 구조대에 필요한 건 그것뿐입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制或发送你的精确坐标——救援人员只需要这些。"
          }
        }
      }
    },
