    "response.safe.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مشاركة حالتك مع موقعك. عند ازدحام الشبكة تصل الرسالة أسهل من المكالمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Status wird mit deinem Standort geteilt. Bei überlasteten Netzen kommt eine Nachricht leichter durch als ein Anruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your status is shared with your location. When networks are busy, a message gets through more easily than a call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu estado se comparte con tu ubicación. Si la red está saturada, un mensaje llega más fácil que una llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre statut est partagé avec votre position. Quand le réseau est saturé, un message passe plus facilement qu'un appel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo stato viene condiviso con la posizione. Con la rete congestionata un messaggio arriva più facilmente di una chiamata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状況は現在地とともに共有されます。回線が混雑しているときは、電話よりメッセージの方が届きやすくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статус отправляется вместе с вашим местоположением. При перегрузке сети сообщение доходит легче, чем звонок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum mesajı konumunla birlikte paylaşılır. Şebeke yoğunsa arama yerine mesaj daha kolay ulaşır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κατάστασή σου κοινοποιείται μαζί με τη θέση σου. Όταν τα δίκτυα είναι φορτωμένα, ένα μήνυμα περνά πιο εύκολα από μια κλήση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu status é enviado com sua localização. Com a rede congestionada, uma mensagem passa mais fácil que uma ligação."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusmu dibagikan bersama lokasimu. Saat jaringan padat, pesan lebih mudah sampai daripada panggilan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태가 위치와 함께 공유됩니다. 통신망이 붐빌 때는 전화보다 메시지가 더 잘 전달됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的状态会连同位置一起分享。网络繁忙时，短信比电话更容易送达。"
          }
        }
      }
    },
