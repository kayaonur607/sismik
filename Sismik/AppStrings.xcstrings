    "onboarding.assembly.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعثر على نقاط التجمع الرسمية بالقرب منك على الخريطة وتوجه إليها بأمان حتى بدون اتصال بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde offizielle Sammelplätze in deiner Nähe auf der Karte und erreiche sie auch ohne Internet sicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View emergency assembly areas and healthcare centers near your location on the map and get instant directions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra puntos de encuentro oficiales cerca de ti en el mapa y llega seguro incluso sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez les zones de rassemblement officielles près de chez vous sur la carte et rejoignez-les en toute sécurité, même sans connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova i punti di raccolta ufficiali vicino a te sulla mappa e raggiungili in sicurezza anche senza connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地から最も近い公式な指定避難場所を地図上で確認し、オフラインでも安全に避難できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находите официальные пункты сбора рядом с вами на карте и безопасно добирайтесь до них даже без интернета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumuna en yakın acil durum toplanma alanlarını ve kritik sağlık merkezlerini haritada görüntüle, anında rota al."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες στον χάρτη χώρους συγκέντρωσης και κέντρα υγείας κοντά σου και πάρε αμέσως οδηγίες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja no mapa pontos de encontro e unidades de saúde perto de você e obtenha rotas na hora."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat titik kumpul darurat dan fasilitas kesehatan di dekatmu pada peta dan dapatkan petunjuk arah langsung."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 대피 장소와 의료 기관을 지도에서 보고 바로 길안내를 받으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地图上查看附近的紧急集合点和医疗机构，并立即获取路线。"
          }
        }
      }
    },
