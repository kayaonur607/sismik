    "intro.emergency.tools.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعد الصفارة وصفارة الإنذار مفيدين عندما لا يُسمع صوتك، بينما يعمل الكشاف وضوء SOS بشفرة مورس في الظلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trillerpfeife und Sirene funktionieren, wenn Ihre Stimme nicht gehört wird, Taschenlampe und SOS-Blinker mit Morsecode in der Dunkelheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whistle and siren when your voice won't carry; flashlight and a Morse SOS strobe in the dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El silbato y la sirena funcionan cuando no se escucha tu voz, y la linterna y el estroboscopio SOS en código Morse funcionan en la oscuridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sifflet et la sirène fonctionnent lorsque votre voix n'est pas entendue, la lampe de poche et le flash SOS en code Morse fonctionnent dans l'obscurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fischietto e la sirena funzionano quando la tua voce non si sente, la torcia e il lampeggiante SOS in codice Morse funzionano al buio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声が届かないときはホイッスルやサイレン、暗闇では懐中電灯やモールス信号のSOSフラッシャーが機能します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свисток и сирена работают, когда вашего голоса не слышно, а фонарик и SOS-вспышка с азбукой Морзе — в темноте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesin duyulmadığında düdük ve siren, karanlıkta fener ve mors alfabesiyle SOS flaşörü çalışır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σφυρίχτρα και σειρήνα όταν η φωνή σου δεν ακούγεται· φακός και σήμα SOS Μορς στο σκοτάδι."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apito e sirene quando sua voz não alcança; lanterna e SOS em Morse no escuro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peluit dan sirene saat suaramu tak terdengar; senter dan kedip SOS Morse dalam gelap."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리가 닿지 않을 땐 호루라기와 사이렌, 어둠 속에선 손전등과 모스 SOS 점멸."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声音传不远时用哨子和警报；黑暗中用手电和摩尔斯 SOS 闪光。"
          }
        }
      }
    },
