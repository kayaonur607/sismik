    "firstaid.bleeding.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احمِ يديك بقفازات أو كيس إن أمكن، وجهّز قطعة قماش نظيفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schütze deine Hände möglichst mit Handschuhen oder einer Tüte; nimm ein sauberes Tuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect your hands with gloves or a plastic bag if you can; find a clean cloth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege tus manos con guantes o una bolsa si puedes; busca un paño limpio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégez vos mains avec des gants ou un sac si possible ; prenez un linge propre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi le mani con guanti o un sacchetto se puoi; prendi un panno pulito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できれば手袋やポリ袋で手を守り、清潔な布を用意する。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По возможности защитите руки перчатками или пакетом; возьмите чистую ткань."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkünse eldiven ya da poşetle ellerini koru; temiz bir bez bul."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστάτευσε τα χέρια σου με γάντια ή σακούλα αν μπορείς· βρες καθαρό ύφασμα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja as mãos com luvas ou um saco plástico se puder; pegue um pano limpo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lindungi tangan dengan sarung tangan atau kantong plastik jika bisa; siapkan kain bersih."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능하면 장갑이나 비닐봉지로 손을 보호하고 깨끗한 천을 준비하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能用手套或塑料袋保护双手；找一块干净的布。"
          }
        }
      }
    },
    "firstaid.bleeding.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع القماش مباشرة على الجرح واضغط بقوة ودون توقف براحة يدك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg das Tuch direkt auf die Wunde und drück fest und ohne Unterbrechung mit der Handfläche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place the cloth directly on the wound and press hard and continuously with your palm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon el paño sobre la herida y presiona fuerte y sin parar con la palma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez le linge sur la plaie et appuyez fort et sans relâche avec la paume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti il panno direttamente sulla ferita e premi forte e senza interruzioni con il palmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布を傷口に直接当て、手のひらで強く押さえ続ける。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите ткань прямо на рану и сильно, непрерывно прижмите ладонью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezi doğrudan yaranın üstüne koy ve avucunla güçlü, kesintisiz bastır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε το ύφασμα απευθείας στο τραύμα και πίεσε δυνατά και συνεχώς με την παλάμη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o pano direto na ferida e pressione forte e sem parar com a palma."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan kain langsung di luka dan tekan kuat terus-menerus dengan telapak tangan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천을 상처에 직접 대고 손바닥으로 세게 계속 누르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将布直接放在伤口上，用手掌持续用力按压。"
          }
        }
      }
    },
    "firstaid.bleeding.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تسرب الدم فلا ترفع القماش؛ أضف قطعة أخرى فوقها واستمر في الضغط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Blut durchsickert, das Tuch nicht abnehmen; ein weiteres darauflegen und weiterdrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If blood soaks through, don't lift the cloth; add another on top and keep pressing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la sangre traspasa, no quites el paño; pon otro encima y sigue presionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le sang traverse, ne retirez pas le linge ; ajoutez-en un autre et continuez d'appuyer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il sangue passa, non togliere il panno; aggiungine un altro sopra e continua a premere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血がにじんでも布ははがさず、上から重ねて押さえ続ける。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если кровь пропитала ткань, не снимайте её — положите сверху новую и продолжайте давить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan bezden sızarsa bezi kaldırma; üstüne yenisini ekleyip basmaya devam et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το αίμα περάσει, μη σηκώνεις το ύφασμα· βάλε άλλο από πάνω και συνέχισε να πιέζεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o sangue atravessar, não tire o pano; coloque outro por cima e continue pressionando."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika darah merembes, jangan angkat kainnya; tambahkan kain lain di atasnya dan terus tekan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피가 배어 나와도 천을 떼지 말고 위에 하나 더 덧대어 계속 누르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若血液渗透，不要揭开布料；在上面再加一块并继续按压。"
          }
        }
      }
    },
    "firstaid.bleeding.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يتوقف نزيف خطير من الذراع أو الساق، ضع رباطًا ضاغطًا فوق الجرح بـ 5–7 سم ودوّن الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt eine lebensbedrohliche Blutung an Arm oder Bein nicht, 5–7 cm oberhalb der Wunde abbinden und die Uhrzeit notieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If life-threatening bleeding from an arm or leg won't stop, apply a tourniquet 5–7 cm above the wound and note the time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una hemorragia grave de brazo o pierna no para, aplica un torniquete 5–7 cm por encima y anota la hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un saignement grave au bras ou à la jambe ne s'arrête pas, posez un garrot 5–7 cm au-dessus de la plaie et notez l'heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se un'emorragia grave di braccio o gamba non si ferma, applica un laccio 5–7 cm sopra la ferita e annota l'ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕や脚の命に関わる出血が止まらなければ、傷の5〜7 cm上を止血帯で縛り、時刻を記録する。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если опасное кровотечение из руки или ноги не останавливается, наложите жгут на 5–7 см выше раны и запишите время."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kol ya da bacaktaki hayati kanama durmazsa yaranın 5–7 cm üstüne turnike uygula ve saatini not et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν απειλητική αιμορραγία από χέρι ή πόδι δεν σταματά, βάλε ίσχαιμο 5–7 cm πάνω από το τραύμα και σημείωσε την ώρα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se um sangramento grave de braço ou perna não parar, aplique um torniquete 5–7 cm acima da ferida e anote o horário."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika perdarahan yang mengancam nyawa dari lengan atau kaki tidak berhenti, pasang torniket 5–7 cm di atas luka dan catat waktunya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔다리의 생명을 위협하는 출혈이 멈추지 않으면 상처 5–7 cm 위에 지혈대를 감고 시간을 적으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若手臂或腿部危及生命的出血无法止住，在伤口上方 5–7 厘米处扎止血带并记下时间。"
          }
        }
      }
    },
    "firstaid.bleeding.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضغط القوي والمستمر يوقف معظم حالات النزيف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fester, anhaltender Druck stoppt die meisten Blutungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firm, continuous pressure stops most bleeding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una presión firme y continua detiene la mayoría de hemorragias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pression ferme et continue arrête la plupart des saignements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pressione forte e continua ferma la maggior parte delle emorragie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかり押さえ続ければ、ほとんどの出血は止まります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильное непрерывное давление останавливает большинство кровотечений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güçlü ve sürekli bası çoğu kanamayı durdurur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σταθερή, συνεχής πίεση σταματά τις περισσότερες αιμορραγίες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressão firme e contínua estanca a maioria dos sangramentos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekanan kuat dan terus-menerus menghentikan sebagian besar perdarahan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세게 계속 누르면 대부분의 출혈이 멈춥니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续用力按压可止住大多数出血。"
          }
        }
      }
    },
