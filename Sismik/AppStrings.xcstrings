    "safety.during.hold.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمسك بالمأوى حتى تتوقف الهزات تماماً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie sich fest, bis die Erschütterungen aufhören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not let go of your shelter; wait until the shaking stops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostente fuerte hasta que cese el movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez bon jusqu'à la fin des secousses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggrappati fino alla fine delle scosse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揺れが完全に収まるまで机の脚などをしっかり掴みます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крепко держитесь за укрытие до окончания толчков."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutunduğun yeri bırakma, sarsıntı geçene kadar bekle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην αφήνεις το καταφύγιό σου· περίμενε να σταματήσει η δόνηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não solte seu abrigo; espere o tremor parar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan lepaskan tempat berlindungmu; tunggu sampai guncangan berhenti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피난처를 놓지 말고 흔들림이 멈출 때까지 기다리세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要离开掩护物，等待震动停止。"
          }
        }
      }
    },
