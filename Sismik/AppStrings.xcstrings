          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как увидеть мои места на карте?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı yerlerimi haritada nasıl görürüm?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς βλέπω τις τοποθεσίες μου στον χάρτη;"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como vejo meus lugares salvos no mapa?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana melihat tempat tersimpan di peta?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 장소를 지도에서 어떻게 보나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何在地图上查看我保存的地点？"
          }
        }
      }
    },
    "help.faq.playback.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على زر الدائرة المتقطعة على الخريطة، وحرّك الخريطة أثناء إيقاف التشغيل مؤقتًا، ثم اختر نطاقًا زمنيًا. يعرض التشغيل الزلازل بالترتيب الزمني بألوان وأحجام حسب القوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf die gestrichelte Kreistaste, verschiebe die Karte bei pausierter Wiedergabe und wähle einen Zeitraum. Die Wiedergabe zeigt die Ereignisse chronologisch mit stärkeabhängigen Farben und Größen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the dashed-circle button on the map, move the map while playback is paused, and choose a date range. Play displays events chronologically with magnitude-based colors and sizes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón del círculo discontinuo en el mapa, mueve el mapa con la reproducción en pausa y elige un intervalo de fechas. La reproducción muestra los eventos en orden cronológico con colores y tamaños según la magnitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton en cercle pointillé sur la carte, déplacez la carte pendant que la lecture est en pause et choisissez une période. La lecture affiche les événements par ordre chronologique, avec des couleurs et tailles selon la magnitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante con il cerchio tratteggiato sulla mappa, sposta la mappa con la riproduzione in pausa e scegli un intervallo di date. La riproduzione mostra gli eventi in ordine cronologico con colori e dimensioni in base alla magnitudo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図上の破線の円ボタンをタップし、再生を一時停止した状態で地図を動かして期間を選択します。再生すると、マグニチュードに応じた色とサイズで地震が時系列に表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку с пунктирным кругом на карте, переместите карту при остановленном воспроизведении и выберите диапазон дат. Воспроизведение показывает события в хронологическом порядке с цветом и размером по магнитуде."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritada kesik çember simgesine dokunun, oynatma dururken haritayı istediğiniz alana taşıyın ve tarih aralığını seçin. Oynat düğmesi depremleri zaman sırasıyla, renk ve boyutlarını büyüklüğe göre gösterir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα το κουμπί με τον διακεκομμένο κύκλο στον χάρτη, μετακίνησε τον χάρτη όσο η αναπαραγωγή είναι σε παύση και διάλεξε εύρος ημερομηνιών. Η αναπαραγωγή δείχνει τα συμβάντα χρονολογικά με χρώματα και μεγέθη ανά μέγεθος σεισμού."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão de círculo tracejado no mapa, mova o mapa com a reprodução pausada e escolha um período. O play mostra os eventos em ordem cronológica, com cores e tamanhos por magnitude."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk tombol lingkaran putus-putus di peta, geser peta saat pemutaran dijeda, lalu pilih rentang tanggal. Putar menampilkan kejadian secara kronologis dengan warna dan ukuran sesuai magnitudo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 점선 원 버튼을 누르고, 일시정지 상태에서 지도를 움직인 뒤 기간을 고르세요. 재생하면 규모별 색과 크기로 지진이 시간순으로 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按地图上的虚线圆按钮，在暂停时移动地图并选择日期范围。播放会按时间顺序显示事件，颜色和大小随震级变化。"
          }
        }
      }
    },
