    "notice.notif.body.ask" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınındaki ve dünyadaki önemli depremleri anında öğrenmek için bildirimlere izin ver."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow notifications to hear about important quakes near you and worldwide right away."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mitteilungen, um sofort von wichtigen Beben in deiner Nähe und weltweit zu erfahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite las notificaciones para enterarte al instante de los sismos importantes cerca de ti y en el mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise les notifications pour être prévenu tout de suite des séismes importants près de toi et dans le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti le notifiche per sapere subito dei terremoti importanti vicino a te e nel mondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知を許可すると、近くや世界の重要な地震をすぐに知ることができます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите уведомления, чтобы сразу узнавать о важных землетрясениях рядом и по всему миру."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالإشعارات لتعرف فورًا بالزلازل المهمة القريبة منك وحول العالم."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε τις ειδοποιήσεις για να μαθαίνεις αμέσως για σημαντικούς σεισμούς κοντά σου και παγκοσμίως."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita as notificações para saber na hora dos terremotos importantes perto de você e no mundo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan notifikasi agar langsung tahu gempa penting di dekatmu dan di seluruh dunia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림을 허용하면 내 주변과 전 세계의 중요한 지진을 바로 알 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许通知，即可第一时间了解附近和全球的重要地震。"
          }
        }
      }
    },
    "notice.notif.body.denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim izni kapalı olduğu için deprem olduğunda sana haber veremiyoruz. Ayarlar'dan Sismik bildirimlerini açabilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are turned off, so we can't tell you when a quake happens. You can turn on Sismik notifications in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind deaktiviert, daher können wir dich bei einem Beben nicht warnen. Aktiviere Sismik-Mitteilungen in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas, así que no podemos avisarte cuando haya un sismo. Actívalas para Sismik en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées : impossible de te prévenir en cas de séisme. Active les notifications de Sismik dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disattivate, quindi non possiamo avvisarti di un terremoto. Attiva le notifiche di Sismik in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がオフのため、地震が起きてもお知らせできません。設定で Sismik の通知をオンにしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления выключены, поэтому мы не сможем сообщить о землетрясении. Включите уведомления Sismik в Настройках."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة، لذا لا يمكننا تنبيهك عند وقوع زلزال. فعّل إشعارات Sismik من الإعدادات."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις είναι απενεργοποιημένες, οπότε δεν μπορούμε να σε ειδοποιήσουμε για σεισμό. Ενεργοποίησέ τες για το Sismik στις Ρυθμίσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas, então não podemos avisar quando houver um terremoto. Ative as notificações do Sismik em Ajustes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi dimatikan, jadi kami tidak bisa memberi tahu saat terjadi gempa. Aktifkan notifikasi Sismik di Pengaturan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 꺼져 있어 지진이 나도 알려 드릴 수 없어요. 설정에서 Sismik 알림을 켜 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已关闭，发生地震时我们无法提醒你。请在设置中开启 Sismik 通知。"
          }
        }
      }
    },
