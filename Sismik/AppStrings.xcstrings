    "risk.prob.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسوب من المعدل السنوي للزلازل السابقة في كتالوج USGS (نموذج بواسون). ليس تنبؤًا، بل يُظهر الاتجاه طويل المدى للمنطقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechnet aus der jährlichen Häufigkeit früherer Beben im USGS-Katalog (Poisson-Modell). Keine Vorhersage, sondern die langfristige Tendenz der Region."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on the yearly rate of past quakes in the USGS catalog (Poisson model). Not a prediction; it shows the area's long-term tendency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado a partir de la frecuencia anual de sismos pasados en el catálogo del USGS (modelo de Poisson). No es una predicción; muestra la tendencia a largo plazo de la zona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculé à partir de la fréquence annuelle des séismes passés du catalogue USGS (modèle de Poisson). Ce n'est pas une prévision, mais la tendance à long terme de la zone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolata dalla frequenza annua dei terremoti passati nel catalogo USGS (modello di Poisson). Non è una previsione; mostra la tendenza a lungo termine della zona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGSカタログの過去の地震の年間頻度から算出(ポアソンモデル)。予知ではなく、地域の長期的な傾向を示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассчитано по годовой частоте прошлых землетрясений из каталога USGS (модель Пуассона). Это не прогноз, а долгосрочная тенденция района."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS kataloğundaki geçmiş depremlerin yıllık sıklığından hesaplanır (Poisson modeli). Tahmin değildir; bölgenin uzun vadeli eğilimini gösterir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βασίζεται στον ετήσιο ρυθμό παλαιότερων σεισμών του καταλόγου USGS (μοντέλο Poisson). Δεν είναι πρόβλεψη· δείχνει τη μακροπρόθεσμη τάση της περιοχής."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com base na taxa anual de terremotos passados do catálogo USGS (modelo de Poisson). Não é previsão; mostra a tendência de longo prazo da área."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdasarkan laju tahunan gempa masa lalu di katalog USGS (model Poisson). Bukan prediksi; ini menunjukkan kecenderungan jangka panjang wilayah itu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USGS 목록의 과거 연간 지진 빈도(푸아송 모형)에 기반합니다. 예측이 아니라 지역의 장기적 경향입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 USGS 目录中过往地震的年发生率（泊松模型）。并非预测，仅反映该地区的长期趋势。"
          }
        }
      }
    },
