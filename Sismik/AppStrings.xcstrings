            "value" : "Συμφώνησε με την οικογένειά σου σημείο συνάντησης και σχέδιο επικοινωνίας."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine com sua família um ponto de encontro e um plano de contato."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepakati titik temu dan rencana kontak dengan keluargamu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족과 만날 장소와 연락 계획을 정해 두세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与家人约定集合地点和联络计划。"
          }
        }
      }
    },
    "risk.advice.recent" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ازداد النشاط الزلزالي مؤخرًا؛ تابع البيانات الرسمية للسلطات المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bebenaktivität hat zuletzt zugenommen; verfolge offizielle Mitteilungen der Behörden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake activity has risen recently in this area; follow official announcements from local authorities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad sísmica aumentó recientemente; sigue los comunicados oficiales de las autoridades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activité sismique a récemment augmenté ; suis les annonces officielles des autorités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attività sismica è aumentata di recente; segui gli annunci ufficiali delle autorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近この地域で地震が増えています。自治体など公的機関の発表を確認しましょう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейсмическая активность недавно выросла; следите за официальными сообщениями властей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölgede son dönemde deprem sayısı arttı; AFAD ve yerel yetkililerin açıklamalarını takip et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σεισμική δραστηριότητα αυξήθηκε πρόσφατα στην περιοχή· ακολούθησε τις ανακοινώσεις των τοπικών αρχών."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atividade sísmica aumentou recentemente na área; acompanhe os avisos oficiais das autoridades locais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas gempa meningkat baru-baru ini di area ini; ikuti pengumuman resmi otoritas setempat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 이 지역의 지진 활동이 늘었습니다. 현지 당국의 공식 발표를 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该地区近期地震活动增加；请关注当地政府的官方通告。"
          }
        }
      }
    },
