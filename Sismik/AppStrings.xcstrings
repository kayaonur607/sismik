    "notif.major.footer.free" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاني: تصل الزلازل بقوة M6.0+ حول العالم فورًا. ضبط الحد الأدنى يتطلب Premium."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos: M6.0+ Erdbeben weltweit treffen sofort ein. Das Anpassen des Schwellenwerts erfordert Premium."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free: M6.0+ earthquakes worldwide arrive instantly. Adjusting the threshold requires Premium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis: los terremotos M6.0+ de todo el mundo llegan al instante. Ajustar el umbral requiere Premium."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit : les séismes de magnitude M6.0+ dans le monde entier arrivent instantanément. L'ajustement du seuil nécessite Premium."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito: i terremoti M6.0+ in tutto il mondo arrivano all'istante. Regolare la soglia richiede Premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料：世界中のM6.0以上の地震が即座に届きます。しきい値の調整にはPremiumが必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно: землетрясения M6.0+ по всему миру приходят мгновенно. Настройка порога доступна в Premium."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz: dünyanın her yerindeki M6.0+ depremler anında gelir. Eşiği ayarlamak Premium'dadır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν: οι σεισμοί M6,0+ παγκοσμίως έρχονται αμέσως. Η αλλαγή ορίου απαιτεί Premium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grátis: terremotos M6,0+ no mundo chegam na hora. Ajustar o limite exige Premium."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis: gempa M6,0+ di seluruh dunia langsung datang. Mengubah ambang batas perlu Premium."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료: 전 세계 M6.0 이상 지진을 즉시 알려 드립니다. 기준 조정은 Premium이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费：全球 M6.0+ 地震即时送达。调整阈值需要 Premium。"
          }
        }
      }
    },
    "notif.major.footer.premium" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستقلة عن أماكنك المحفوظة. إذا طابق الزلزال أحد أماكنك أيضاً، يصلك تنبيه المكان فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängig von deinen Orten. Passt ein Beben auch zu einem deiner Orte, erhältst du nur den Orts-Hinweis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independent of your saved places. If a quake also matches one of your places, you only get the place alert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independiente de tus lugares. Si un terremoto también coincide con uno de tus lugares, solo recibes el aviso de ese lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indépendant de vos lieux. Si un séisme correspond aussi à l’un de vos lieux, seule l’alerte du lieu est envoyée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indipendente dai tuoi luoghi. Se un terremoto corrisponde anche a un tuo luogo, ricevi solo l’avviso del luogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所とは無関係に届きます。地震が場所にも一致する場合は、場所の通知だけが届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Независимо от ваших мест. Если землетрясение совпадает и с вашим местом, придёт только оповещение для места."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı yerlerinden bağımsız gelir. Bir deprem yerlerinden biriyle de eşleşirse yalnızca yer bildirimi gönderilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανεξάρτητα από τις τοποθεσίες σου. Αν ο σεισμός ταιριάζει και σε μία από αυτές, λαμβάνεις μόνο την ειδοποίηση τοποθεσίας."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independente dos seus lugares salvos. Se o terremoto também corresponder a um lugar, você recebe só o alerta do lugar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlepas dari tempat tersimpanmu. Jika gempa juga cocok dengan salah satu tempatmu, kamu hanya menerima peringatan tempat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 장소와 무관합니다. 지진이 내 장소 조건에도 맞으면 장소 알림만 받습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与已保存地点无关。若地震同时符合某个地点，只会收到地点提醒。"
          }
        }
      }
    },
