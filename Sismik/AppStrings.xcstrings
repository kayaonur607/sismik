          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen and camera-flash signal to be seen in the dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Señal con la pantalla y el flash para ser visible en la oscuridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signal par l'écran et le flash pour être visible dans le noir."
          }
        },
