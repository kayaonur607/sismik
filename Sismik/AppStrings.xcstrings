            "value" : "急救指南"
          }
        }
      }
    },
    "firstaid.unconscious.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربت على كتفيه وتحدث بصوت عالٍ؛ لاحظ إن كان يستجيب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe an die Schultern und sprich laut; reagiert die Person?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap their shoulders and speak loudly; see if they respond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca sus hombros y háblale fuerte; mira si responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapotez les épaules et parlez fort ; voyez si la personne réagit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca le spalle e parla ad alta voce; guarda se risponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩をたたいて大きな声で呼びかけ、反応を見る。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похлопайте по плечам и громко окликните — есть ли реакция."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omuzlarına dokunup yüksek sesle seslen; yanıt veriyor mu bak."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτύπησέ του τους ώμους και μίλα δυνατά· δες αν αντιδρά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque nos ombros e fale alto; veja se a pessoa responde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepuk bahunya dan bicara keras; lihat apakah dia merespons."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어깨를 두드리며 크게 말하고 반응하는지 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻拍其肩膀并大声呼唤，看是否有反应。"
          }
        }
      }
    },
    "firstaid.unconscious.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمل الرأس للخلف وارفع الذقن؛ واستمع للتنفس وراقب الصدر لمدة 10 ثوانٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopf leicht überstrecken, Kinn anheben; 10 Sekunden auf Atmung hören und den Brustkorb beobachten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilt the head back and lift the chin; for 10 seconds, listen for breathing and watch the chest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina la cabeza hacia atrás y eleva el mentón; durante 10 segundos escucha la respiración y mira el pecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculez la tête en arrière et levez le menton ; pendant 10 secondes, écoutez la respiration et regardez la poitrine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina la testa indietro e solleva il mento; per 10 secondi ascolta il respiro e guarda il torace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭を後ろに傾けてあごを上げ、10秒間呼吸音を聞き胸の動きを見る。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрокиньте голову и поднимите подбородок; 10 секунд слушайте дыхание и смотрите на грудь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başı hafifçe geriye itip çeneyi kaldır; 10 saniye boyunca soluğu dinle ve göğsü izle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γείρε το κεφάλι πίσω και σήκωσε το πηγούνι· για 10 δευτερόλεπτα άκου για αναπνοή και κοίτα το στήθος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline a cabeça para trás e levante o queixo; por 10 segundos, ouça a respiração e observe o peito."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengadahkan kepala dan angkat dagu; selama 10 detik, dengarkan napas dan perhatikan dada."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머리를 뒤로 젖히고 턱을 들어 10초 동안 숨소리를 듣고 가슴을 살피세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使头后仰、抬起下巴；用 10 秒倾听呼吸并观察胸部起伏。"
          }
        }
      }
    },
    "firstaid.unconscious.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان يتنفس طبيعيًا، ضعه على جانبه (وضعية الإفاقة) وغطِّه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei normaler Atmung in die stabile Seitenlage bringen und zudecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If breathing normally, roll them onto their side (recovery position) and keep them covered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si respira con normalidad, colócala de lado (posición de recuperación) y abrígala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la respiration est normale, mettez la personne sur le côté (PLS) et couvrez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se respira normalmente, mettila su un fianco (posizione laterale di sicurezza) e coprila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通に呼吸していれば横向き（回復体位）にし、体を覆って保温する。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если дыхание нормальное, уложите на бок (восстановительное положение) и укройте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal soluyorsa yan yatır (koma pozisyonu) ve üstünü ört."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν αναπνέει κανονικά, γύρισέ τον στο πλάι (θέση ανάνηψης) και κράτησέ τον σκεπασμένο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se respirar normalmente, vire a pessoa de lado (posição de recuperação) e mantenha-a coberta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika bernapas normal, miringkan tubuhnya (posisi pemulihan) dan tetap selimuti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정상적으로 숨을 쉬면 옆으로 눕히고(회복 자세) 덮어 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若呼吸正常，将其翻成侧卧（复原体位）并盖好保暖。"
          }
        }
      }
    },
    "firstaid.unconscious.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يكن يتنفس أو كان تنفسه غير طبيعي، اتصل بالطوارئ وابدأ الإنعاش فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmet die Person nicht oder nicht normal: Notruf wählen und sofort mit der Herzdruckmassage beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If they aren't breathing or breathing abnormally, call emergency services and start CPR immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no respira o respira de forma anormal, llama a emergencias y empieza la RCP de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la personne ne respire pas ou respire anormalement, appelez les secours et commencez la RCP immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non respira o respira in modo anomalo, chiama i soccorsi e inizia subito la RCP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸がない、または普段どおりでなければ救急に通報し、すぐに胸骨圧迫を始める。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если дыхания нет или оно ненормальное, вызовите скорую и сразу начните СЛР."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solumuyorsa ya da soluk düzensizse 112'yi ara ve hemen kalp masajına başla."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεν αναπνέει ή η αναπνοή δεν είναι φυσιολογική, κάλεσε βοήθεια και ξεκίνα αμέσως ΚΑΡΠΑ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não respirar ou respirar de forma anormal, ligue para a emergência e comece a RCP imediatamente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak bernapas atau napasnya tidak normal, hubungi layanan darurat dan segera mulai RJP."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨을 쉬지 않거나 호흡이 비정상이면 긴급 서비스에 연락하고 즉시 심폐소생술을 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若无呼吸或呼吸异常，立即拨打急救电话并开始心肺复苏。"
          }
        }
      }
    },
    "firstaid.unconscious.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من الاستجابة ثم من التنفس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Reaktion, dann Atmung prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check for a response, then for breathing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba si responde y luego si respira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la réaction, puis la respiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla se risponde, poi se respira."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず反応、次に呼吸を確認。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте реакцию, затем дыхание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce yanıt, sonra soluk kontrolü."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγξε αν αντιδρά, μετά αν αναπνέει."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se há resposta e depois a respiração."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa respons, lalu periksa napas."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 반응을, 그다음 호흡을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先检查反应，再检查呼吸。"
          }
        }
      }
    },
