          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik non è autorizzato a inviare notifiche in iOS, quindi non arriverà alcun avviso. Puoi consentirle in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSでSismikの通知が許可されていないため、通知は届きません。設定で許可できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik не может отправлять уведомления в iOS, поэтому оповещения не придут. Разрешите их в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik’e iOS’ta bildirim izni verilmediği için hiçbir bildirim gelmez. İzni Ayarlar’dan açabilirsin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sismik δεν έχει άδεια για ειδοποιήσεις στο iOS, οπότε δεν θα έρχονται. Μπορείς να τις επιτρέψεις στις Ρυθμίσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sismik não tem permissão para notificações no iOS, então nenhum alerta chegará. Você pode permitir nos Ajustes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sismik tidak diizinkan mengirim notifikasi di iOS, jadi peringatan tidak akan masuk. Kamu bisa mengizinkannya di Pengaturan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서 Sismik 알림이 허용되지 않아 알림이 오지 않습니다. 설정에서 허용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 未允许 Sismik 发送通知，因此不会收到提醒。你可以在“设置”中开启。"
          }
        }
      }
    },
