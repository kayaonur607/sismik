    "ob2.emergency.firstaid.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النزيف والإنعاش والكسور والانضغاط؛ مع إيقاع مساعد للإنعاش."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blutung, Herzdruckmassage, Brüche, Quetschungen – mit Takthilfe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleeding, CPR, fractures, crush injuries — with a CPR rhythm guide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemorragias, RCP, fracturas, aplastamiento; con guía de ritmo para la RCP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hémorragies, RCP, fractures, écrasement ; avec un métronome pour la RCP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emorragie, RCP, fratture, schiacciamento; con metronomo per la RCP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出血、胸骨圧迫、骨折、挫滅。胸骨圧迫のリズムガイド付き。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кровотечение, СЛР, переломы, сдавление; метроном для СЛР."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanama, kalp masajı, kırık, ezilme; kalp masajı için ritim tutucu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αιμορραγία, ΚΑΡΠΑ, κατάγματα, συνθλίψεις — με οδηγό ρυθμού ΚΑΡΠΑ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangramento, RCP, fraturas, esmagamento — com guia de ritmo para RCP."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdarahan, RJP, patah tulang, cedera terjepit — dengan panduan ritme RJP."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출혈, 심폐소생술, 골절, 압궤 손상 — 심폐소생술 리듬 가이드 포함."
          }
        },
        "zh-Hans" : {
