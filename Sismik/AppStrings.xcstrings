    "permissions.notif.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على إشعارات فورية للزلازل الجديدة التي تطابق معاييرك والهزات الكبيرة حول العالم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahre sofort von neuen Erdbeben, die deinen Kriterien entsprechen, und großen Erschütterungen weltweit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get instant updates for new earthquakes matching your criteria and major tremors worldwide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infórmate al instante sobre nuevos terremotos que coincidan con tus criterios y grandes temblores en todo el mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soyez informé instantanément des nouveaux séismes correspondant à vos critères et des secousses majeures dans le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi notifiche immediate per i nuovi terremoti che soddisfano i tuoi criteri e per le principali scosse nel mondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件に一致する新しい地震や世界中の大規模な揺れをすばやく把握できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мгновенно узнавайте о новых землетрясениях, соответствующих вашим критериям, и о крупных толчках по всему миру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kriterlerine uyan yeni depremleri ve dünya genelindeki büyük sarsıntıları anında öğren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβε άμεσες ενημερώσεις για νέους σεισμούς που ταιριάζουν στα κριτήριά σου και για μεγάλους σεισμούς παγκοσμίως."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba na hora avisos de novos terremotos que atendam aos seus critérios e de grandes tremores no mundo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan kabar instan tentang gempa baru yang sesuai kriteriamu dan gempa besar di seluruh dunia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조건에 맞는 새 지진과 전 세계 큰 지진을 즉시 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即时获取符合条件的新地震以及全球大地震的通知。"
          }
        }
      }
    },
