          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos bis 50 km. Mit Premium bis 1.000 km und kritische Hinweise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free plan covers up to 50 km. Premium extends it to 1,000 km and adds critical alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan gratuito cubre hasta 50 km. Premium lo amplía a 1000 km y añade alertas críticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’offre gratuite couvre jusqu’à 50 km. Premium l’étend à 1 000 km et ajoute les alertes critiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano gratuito copre fino a 50 km. Premium arriva a 1.000 km e aggiunge gli avvisi critici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランは半径50 kmまで。プレミアムなら1,000 kmまで広げ、重要な通知も使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно — до 50 км. Premium расширяет до 1000 км и добавляет критические оповещения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz planda yarıçap 50 km'ye kadar. Premium'la 1000 km'ye kadar genişlet, kritik uyarıyı aç."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δωρεάν πλάνο καλύπτει έως 50 km. Το Premium το επεκτείνει στα 1.000 km και προσθέτει κρίσιμες ειδοποιήσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano grátis cobre até 50 km. O Premium amplia para 1.000 km e adiciona alertas críticos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket gratis mencakup hingga 50 km. Premium memperluasnya ke 1.000 km dan menambah peringatan kritis."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 요금제는 최대 50 km까지입니다. Premium은 1,000 km로 넓히고 중요 알림을 추가합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费方案最多覆盖 50 公里。Premium 可扩展至 1,000 公里并加入紧急提醒。"
          }
        }
      }
    },
