        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentido pela maioria em ambientes fechados; portas e janelas tremem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirasakan kebanyakan orang di dalam; pintu dan jendela bergetar."
