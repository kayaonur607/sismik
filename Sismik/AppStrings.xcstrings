        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Службы геолокации на устройстве выключены. Вы можете включить их в разделе Настройки > Конфиденциальность и безопасность > Службы геолокации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
