    "ob2.welcome.alerts.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنزل أو العمل أو مدينة العائلة؛ عند وقوع زلزال هناك يأتي التنبيه باسم المكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuhause, Arbeit oder die Stadt der Familie – bei einem Beben nennt die Warnung den Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home, work or your family's city — when a quake hits there, the alert names the place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, trabajo o la ciudad de tu familia: si hay un sismo, la alerta nombra el lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maison, travail ou ville de la famille : en cas de séisme, l'alerte nomme le lieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, lavoro o la città della famiglia: in caso di terremoto l'avviso nomina il luogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅、職場、家族の町。そこで地震が起きると、場所の名前で通知します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дом, работа или город семьи — при землетрясении уведомление назовёт место."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev, iş ya da ailenin şehri; o bölgede deprem olunca bildirim yerin adıyla gelir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σπίτι, δουλειά ή η πόλη της οικογένειάς σου — όταν γίνει σεισμός εκεί, η ειδοποίηση αναφέρει την τοποθεσία."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, trabalho ou a cidade da sua família — quando houver um terremoto ali, o alerta diz o nome do lugar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah, kantor, atau kota keluargamu — saat gempa terjadi di sana, peringatan menyebut nama tempatnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집, 직장, 가족이 사는 도시 — 그곳에 지진이 나면 장소 이름으로 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家、工作地点或家人所在城市——那里发生地震时，提醒会注明地点名称。"
          }
        }
      }
    },
