    "The location value comes from the USGS ShakeMap MMI grid, which combines station observations and ground-motion modeling." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيمة الموقع مأخوذة من شبكة MMI الخاصة بـ USGS ShakeMap التي تجمع بين قياسات المحطات ونمذجة حركة الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortwert stammt aus dem MMI-Raster der USGS ShakeMap, das Stationsmessungen und Bodenbewegungsmodelle kombiniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The location value comes from the USGS ShakeMap MMI grid, which combines station observations and ground-motion modeling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor de la ubicación proviene de la cuadrícula MMI del ShakeMap del USGS, que combina observaciones de estaciones y modelado del movimiento del suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur de localisation provient de la grille MMI de la ShakeMap de l'USGS, qui combine les mesures des stations et la modélisation du mouvement du sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore per la posizione proviene dalla griglia MMI della ShakeMap USGS, che combina le misure delle stazioni e la modellazione del moto del suolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この地点の値は、観測点データと地動モデルを統合した USGS ShakeMap の MMI グリッドから算出されています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение для точки взято из сетки MMI карты USGS ShakeMap, объединяющей данные станций и моделирование движения грунта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum değeri USGS ShakeMap'in istasyon ölçümleri ve yer hareketi modelini birleştiren MMI ızgarasından hesaplandı."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τιμή για τη θέση προέρχεται από το πλέγμα MMI του USGS ShakeMap, που συνδυάζει παρατηρήσεις σταθμών και μοντελοποίηση εδαφικής κίνησης."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor do local vem da grade MMI do USGS ShakeMap, que combina observações de estações e modelagem do movimento do solo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai lokasi berasal dari grid MMI USGS ShakeMap yang menggabungkan pengamatan stasiun dan pemodelan gerakan tanah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 값은 관측소 자료와 지반 운동 모델을 결합한 USGS ShakeMap MMI 격자에서 가져옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置数值来自 USGS ShakeMap MMI 网格，结合了台站观测与地面运动建模。"
          }
        }
      }
    },
