    "ob2.emergency.assembly.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقرب الأماكن في قائمة واحدة، ورسالة \"أنا هنا\" لعائلتك، وبوصلة حتى دون شبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächste Orte in einer Liste, „Ich bin hier“ an die Familie und Kompass-Navigation auch ohne Netz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nearest places in one list, an \"I'm here\" message to family and compass directions even without a network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares más cercanos en una lista, mensaje \"Estoy aquí\" a tu familia y brújula incluso sin red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux les plus proches en une liste, message « Je suis ici » à la famille et boussole même sans réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I luoghi più vicini in un elenco, messaggio \"Sono qui\" alla famiglia e bussola anche senza rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最寄りの場所を一覧で、家族に「ここにいます」、圏外でもコンパスで道案内。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ближайшие места списком, сообщение «Я здесь» семье и компас даже без сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En yakın alanlar tek listede, ailene \"Buradayım\" mesajı ve şebeke olmasa da pusulayla yön bulma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κοντινότερα σημεία σε μια λίστα, μήνυμα «Είμαι εδώ» στην οικογένεια και πυξίδα ακόμη και χωρίς δίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lugares mais próximos em uma lista, mensagem \"Estou aqui\" para a família e bússola mesmo sem rede."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat terdekat dalam satu daftar, pesan \"Aku di sini\" untuk keluarga, dan kompas meski tanpa jaringan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까운 장소를 한 목록으로, 가족에게 \"여기 있어요\", 통신망이 없어도 나침반 길찾기."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近地点一览，给家人发“我在这里”，无网络也能用指南针找路。"
          }
        }
      }
    },
