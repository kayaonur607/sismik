          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guide des premiers secours"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guida al primo soccorso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応急手当ガイド"
          }
        },
        "ru" : {
