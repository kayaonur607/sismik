    "trapped.tip.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابقَ هادئًا وتحرك أقل ما يمكن؛ لا تُثر الغبار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib ruhig und beweg dich so wenig wie möglich; wirble keinen Staub auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay calm and move as little as possible; don't kick up dust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la calma y muévete lo menos posible; no levantes polvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez calme et bougez le moins possible ; ne soulevez pas de poussière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta calmo e muoviti il meno possibile; non sollevare polvere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち着いて、できるだけ動かず、ほこりを立てない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте спокойствие, двигайтесь как можно меньше, не поднимайте пыль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakin kal, gereksiz hareket etme; tozu kaldırma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μείνε ψύχραιμος και κουνήσου όσο λιγότερο γίνεται· μη σηκώνεις σκόνη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique calmo e se mexa o mínimo possível; não levante poeira."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap tenang dan bergeraklah sesedikit mungkin; jangan membuat debu beterbangan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "침착하게 최대한 적게 움직이고 먼지를 일으키지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持冷静，尽量少动，别扬起灰尘。"
          }
        }
      }
    },
    "trapped.tip.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غطِّ فمك وأنفك بقطعة قماش."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedecke Mund und Nase mit Stoff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cover your mouth and nose with cloth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cúbrete la boca y la nariz con un paño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couvrez-vous la bouche et le nez avec un tissu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copri bocca e naso con un panno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布で口と鼻を覆う。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте рот и нос тканью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağzını ve burnunu bir bezle kapat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάλυψε στόμα και μύτη με ύφασμα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubra a boca e o nariz com um pano."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup mulut dan hidungmu dengan kain."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천으로 입과 코를 가리세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用布捂住口鼻。"
          }
        }
      }
    },
    "trapped.tip.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطرق على أنبوب أو جدار على فترات؛ ووفّر صوتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klopf in Abständen an ein Rohr oder eine Wand; schone deine Stimme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap on a pipe or wall at intervals; save your voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golpea una tubería o pared a intervalos; ahorra la voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez à intervalles sur un tuyau ou un mur ; économisez votre voix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batti a intervalli su un tubo o una parete; risparmia la voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定の間隔で配管や壁をたたき、声は温存する。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Периодически стучите по трубе или стене; берегите голос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boruya ya da duvara belirli aralıklarla vur; sesini boşa harcama."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτύπα σωλήνα ή τοίχο κατά διαστήματα· φύλαξε τη φωνή σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bata em um cano ou parede de tempos em tempos; poupe a voz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk pipa atau dinding sesekali; hemat suaramu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간격을 두고 파이프나 벽을 두드리고 목소리는 아끼세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "间隔敲击管道或墙壁；节省体力少喊叫。"
          }
        }
      }
    },
    "trapped.tip.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصرخ عندما تسمع أصواتًا؛ فترات الصمت هي وقت إنصات المنقذين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruf, wenn du Stimmen hörst; in Ruhephasen horchen die Retter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shout when you hear voices; silent periods are when rescuers listen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grita cuando oigas voces; en los silencios los rescatistas escuchan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criez quand vous entendez des voix ; les silences sont les moments d'écoute des secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grida quando senti delle voci; nei silenzi i soccorritori ascoltano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人の声が聞こえたら叫ぶ。静かな時間は救助隊が耳を澄ませている。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кричите, когда слышите голоса: в минуты тишины спасатели слушают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesler duyarsan bağır; sessizlik anları kurtarıcıların dinleme zamanıdır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φώναξε όταν ακούς φωνές· στις σιωπές οι διασώστες ακούνε."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
