    "onboarding.emergency.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدوات لإنقاذ الحياة تشمل الصفارة، وصافرة الإنذار، والرسائل القصيرة للطوارئ، وإشارة SOS الضوئية التي تعمل حتى مع انقطاع الشبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebensrettende Werkzeuge wie Pfeife, Sirene, Notfall-SMS und SOS-Lichtsignal, die auch bei Netzausfall funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Life-saving tools including whistle, siren, emergency SMS, and SOS strobe that work even if cellular networks fail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramientas de rescate como silbato, sirena, SMS de emergencia y señal SOS que funcionan sin cobertura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outils de survie comprenant sifflet, sirène, SMS d'urgence et stroboscope SOS fonctionnant même sans réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strumenti salvavita con fischietto, sirena, SMS di emergenza e luce SOS che funzionano anche in assenza di segnale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圏外でも使えるホイッスル、サイレン、緊急SMS、SOSライト信号など命を守るツール。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты спасения: свисток, сирена, экстренные SMS и сигнал SOS, работающие даже без связи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkaz ve afet anında şebeke kesilse dahi çalışan düdük, siren, acil SMS ve SOS ışık sinyali araçları."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εργαλεία που σώζουν ζωές — σφυρίχτρα, σειρήνα, SMS έκτακτης ανάγκης και φλας SOS — που λειτουργούν ακόμη κι αν πέσει το δίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferramentas que salvam vidas — apito, sirene, SMS de emergência e luz SOS — que funcionam mesmo sem rede celular."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alat penyelamat nyawa — peluit, sirene, SMS darurat, dan lampu SOS — yang tetap bekerja meski jaringan seluler mati."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통신망이 끊겨도 작동하는 호루라기, 사이렌, 긴급 SMS, SOS 점멸등 등 생명을 지키는 도구."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口哨、警报、紧急短信和 SOS 闪光等救命工具，即使移动网络中断也能使用。"
          }
        }
      }
    },
