    "risk.recent.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقارن العام الأخير بالمتوسط السنوي لآخر 20 عامًا. الزيادة وحدها لا تنذر بزلزال كبير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das letzte Jahr wird mit dem Jahresmittel der letzten 20 Jahre verglichen. Ein Anstieg allein kündigt kein großes Beben an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last year is compared with the yearly average of the past 20 years. An increase alone does not signal a large quake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último año se compara con la media anual de los últimos 20 años. Un aumento por sí solo no anuncia un gran sismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière année est comparée à la moyenne annuelle des 20 dernières années. Une hausse seule n'annonce pas un grand séisme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ultimo anno è confrontato con la media annua degli ultimi 20 anni. Un aumento da solo non preannuncia un forte terremoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去1年を直近20年の年平均と比較しています。増加だけで大地震の前兆とはいえません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последний год сравнивается со средним за 20 лет. Сам по себе рост не предвещает сильного землетрясения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son bir yıl, son 20 yılın yıllık ortalamasıyla karşılaştırılır. Artış kendi başına büyük deprem habercisi değildir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τελευταίο έτος συγκρίνεται με τον ετήσιο μέσο όρο των τελευταίων 20 ετών. Μια αύξηση από μόνη της δεν σημαίνει μεγάλο σεισμό."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O último ano é comparado com a média anual dos últimos 20 anos. Um aumento, por si só, não indica um grande terremoto."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahun terakhir dibandingkan dengan rata-rata tahunan 20 tahun terakhir. Kenaikan saja bukan tanda gempa besar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 1년을 지난 20년의 연평균과 비교합니다. 증가만으로 큰 지진을 뜻하지는 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将最近一年与过去 20 年的年均值比较。仅有增加并不预示大地震。"
          }
        }
      }
    },
