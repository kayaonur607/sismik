    "pi.confidence.limited.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu deprem için ShakeMap yok; sonuç yalnızca büyüklük, derinlik ve uzaklığa dayalı yaklaşık bir modeldir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ShakeMap for this quake; the result is an approximation based only on magnitude, depth and distance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Beben gibt es keine ShakeMap; das Ergebnis ist eine Näherung aus Magnitude, Tiefe und Entfernung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ShakeMap para este sismo; el resultado es una aproximación basada solo en magnitud, profundidad y distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de ShakeMap pour ce séisme ; le résultat est une approximation fondée sur magnitude, profondeur et distance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna ShakeMap per questo terremoto; il risultato è un'approssimazione basata su magnitudo, profondità e distanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この地震の ShakeMap はなく、結果は規模・深さ・距離のみに基づく近似値です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого землетрясения нет ShakeMap; результат — приближение только по магнитуде, глубине и расстоянию."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد خريطة ShakeMap لهذا الزلزال؛ النتيجة تقريب يعتمد على القوة والعمق والمسافة فقط."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ShakeMap για αυτόν τον σεισμό· το αποτέλεσμα είναι προσέγγιση βάσει μεγέθους, βάθους και απόστασης."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há ShakeMap para este terremoto; o resultado é uma aproximação baseada só em magnitude, profundidade e distância."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada ShakeMap untuk gempa ini; hasilnya perkiraan berdasarkan magnitudo, kedalaman, dan jarak saja."
          }
        },
        "ko" : {
