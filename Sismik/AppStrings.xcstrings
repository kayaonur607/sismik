    "onboarding.group.tools.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من تحليل الذكاء الاصطناعي إلى أدوات الطوارئ: كل ما تحتاجه بعد الزلزال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der KI-Auswertung bis zu Notfallwerkzeugen – alles, was du nach einem Beben brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From AI commentary to emergency tools — everything you need after a quake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del análisis con IA a las herramientas de emergencia: todo lo que necesitas tras un sismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l’analyse par IA aux outils d’urgence : tout ce dont vous avez besoin après un séisme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dall’analisi con IA agli strumenti di emergenza: tutto ciò che serve dopo un terremoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 解説から緊急ツールまで、地震のあとに必要なものすべて。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От анализа ИИ до аварийных инструментов — всё, что нужно после землетрясения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zeka yorumundan acil durum araçlarına kadar deprem sonrasında ihtiyacın olan her şey."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από σχολιασμό τεχνητής νοημοσύνης ως εργαλεία έκτακτης ανάγκης — ό,τι χρειάζεσαι μετά από σεισμό."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De comentários com IA a ferramentas de emergência — tudo de que você precisa após um terremoto."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari ulasan AI hingga alat darurat — semua yang kamu butuhkan setelah gempa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 해설부터 긴급 도구까지, 지진 후에 필요한 모든 것."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 AI 解读到应急工具——地震后所需的一切。"
          }
        }
      }
    },
