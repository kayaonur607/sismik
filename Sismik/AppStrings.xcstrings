        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayakta durmak zorlaşabilir; dayanıksız yapılarda hasar oluşabilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η όρθια στάση ίσως είναι δύσκολη· ευάλωτα κτίρια μπορεί να πάθουν ζημιές."
