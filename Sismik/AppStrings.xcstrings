    "settings.weeklyDigest.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل صباح اثنين، يخبرك إشعار صامت بعدد الزلازل التي وقعت قرب أماكنك في الأسبوع الماضي وأقواها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Montagmorgen erfährst du per stiller Mitteilung, wie viele Erdbeben es letzte Woche nahe deinen Orten gab und welches das stärkste war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every Monday morning, a silent notification tells you how many earthquakes happened near your saved places last week and the largest one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lunes por la mañana, una notificación silenciosa te dice cuántos sismos hubo cerca de tus lugares la semana pasada y cuál fue el mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque lundi matin, une notification silencieuse indique le nombre de séismes survenus près de vos lieux la semaine passée et le plus fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni lunedì mattina una notifica silenziosa ti dice quanti terremoti ci sono stati vicino ai tuoi luoghi la settimana scorsa e il più forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週月曜の朝、登録した場所の近くで先週起きた地震の数と最大の地震を、音の鳴らない通知でお知らせします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый понедельник утром тихое уведомление сообщит, сколько землетрясений было рядом с вашими местами за прошлую неделю и какое было сильнейшим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pazartesi sabahı, kayıtlı yerlerinin yakınında geçen hafta kaç deprem olduğunu ve en büyüğünü sessiz bir bildirimle gönderir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε Δευτέρα πρωί, μια αθόρυβη ειδοποίηση σού λέει πόσοι σεισμοί έγιναν κοντά στις τοποθεσίες σου την περασμένη εβδομάδα και ποιος ήταν ο μεγαλύτερος."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda segunda de manhã, uma notificação silenciosa diz quantos terremotos ocorreram perto dos seus lugares na semana passada e qual foi o maior."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap Senin pagi, notifikasi senyap memberi tahu berapa gempa terjadi di dekat tempat tersimpanmu minggu lalu dan yang terbesar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 월요일 아침, 지난주 저장한 장소 근처의 지진 수와 가장 큰 지진을 무음 알림으로 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周一早上，一条静默通知会告诉你上周你保存的地点附近发生了多少次地震以及最大的一次。"
          }
        }
      }
    },
