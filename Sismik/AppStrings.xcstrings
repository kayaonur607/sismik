    "family.sms.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل الرسائل عبر الشبكة الخلوية وتصل دون إنترنت. يُضاف موقعك إلى الرسالة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS läuft übers Mobilfunknetz und kommt auch ohne Internet an. Dein Standort wird angehängt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS travels over the cellular network and gets through without internet. Your location is included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El SMS viaja por la red móvil y llega sin internet. Se incluye tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le SMS passe par le réseau mobile, même sans internet. Votre position est ajoutée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'SMS viaggia sulla rete cellulare e arriva anche senza internet. La tua posizione viene inclusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMSは携帯電話網で届くため、ネットがなくても送れます。現在地が添付されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS идёт по сотовой сети и доходит без интернета. К сообщению добавляется ваше местоположение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS hücresel şebekeyle gider; internet olmasa da ulaşır. Mesaja konumun eklenir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το SMS ταξιδεύει μέσω του κινητού δικτύου και φτάνει χωρίς διαδίκτυο. Περιλαμβάνεται η τοποθεσία σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SMS usa a rede celular e chega sem internet. Sua localização vai junto."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS lewat jaringan seluler dan sampai tanpa internet. Lokasimu disertakan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS는 휴대폰 통신망으로 가서 인터넷 없이도 전달됩니다. 위치가 함께 들어갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短信通过移动网络发送，无需网络也能送达。会附上你的位置。"
          }
        }
      }
    },
    "family.sms.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل «أحتاج مساعدة» للجميع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allen „Ich brauche Hilfe“ simsen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text everyone \"I need help\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar \"Necesito ayuda\" a todos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer « J'ai besoin d'aide » à tous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia \"Ho bisogno di aiuto\" a tutti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員に「助けが必要」とSMS"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправить всем «Нужна помощь»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hepsine \"Yardım lazım\" SMS'i gönder"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλε σε όλους «Χρειάζομαι βοήθεια»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar a todos \"Preciso de ajuda\""
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim ke semua \"Aku butuh bantuan\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두에게 \"도움이 필요해요\" 보내기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给所有人发送“我需要帮助”"
          }
        }
      }
    },
