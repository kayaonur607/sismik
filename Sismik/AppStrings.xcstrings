    "pi.action.strong" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasar olası. Güvendeysen binadan dikkatle çık, toplanma alanına git ve resmî duyuruları izle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damage is possible. If it's safe, leave the building carefully, go to an assembly area and follow official announcements."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schäden sind möglich. Wenn es sicher ist, verlasse vorsichtig das Gebäude, geh zu einem Sammelplatz und folge offiziellen Hinweisen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que haya daños. Si es seguro, sal del edificio con cuidado, ve a un punto de reunión y sigue los avisos oficiales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des dégâts sont possibles. Si c'est sûr, sors prudemment du bâtiment, rejoins un point de rassemblement et suis les consignes officielles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono possibili danni. Se è sicuro, esci con cautela dall'edificio, raggiungi un'area di raccolta e segui gli avvisi ufficiali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被害の可能性があります。安全なら建物から慎重に出て避難場所へ向かい、公式の発表に従ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможны разрушения. Если это безопасно, осторожно покиньте здание, идите к месту сбора и следите за официальными сообщениями."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحدث أضرار. إن كان الأمر آمنًا فاخرج من المبنى بحذر، واذهب إلى نقطة التجمع، وتابع الإعلانات الرسمية."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιθανές ζημιές. Αν είναι ασφαλές, βγες προσεκτικά από το κτίριο, πήγαινε σε χώρο συγκέντρωσης και ακολούθησε τις επίσημες ανακοινώσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danos são possíveis. Se for seguro, saia do prédio com cuidado, vá a um ponto de encontro e siga os avisos oficiais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerusakan mungkin terjadi. Jika aman, keluar dari gedung dengan hati-hati, pergi ke titik kumpul, dan ikuti pengumuman resmi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피해가 있을 수 있어요. 안전하다면 건물에서 조심히 나와 대피 장소로 가고 공식 발표를 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能造成破坏。若安全，请小心离开建筑物，前往集合点并关注官方通知。"
          }
        }
      }
    },
