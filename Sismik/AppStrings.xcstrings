    "intro.assembly.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف مسبقًا أين تذهب عند وقوع زلزال. تعرِض هذه الشاشة نقاط التجمع والمستشفيات والصيدليات المحيطة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisse im Voraus, wohin du bei einem Erdbeben gehen musst. Dieser Bildschirm zeigt Sammelstellen, Krankenhäuser und Apotheken in deiner Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Know where to go before an earthquake happens. This screen shows assembly areas, hospitals and pharmacies around you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabe de antemano adónde ir durante un terremoto. Esta pantalla muestra puntos de encuentro, hospitales y farmacias a tu alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sachez où aller en cas de séisme. Cet écran affiche les points de rassemblement, les hôpitaux et les pharmacies autour de vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sappi in anticipo dove andare durante un terremoto. Questa schermata mostra i punti di raccolta, gli ospedali e le farmacie intorno a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震発生時にどこへ避難すべきか事前に把握しましょう。この画面には周辺の避難場所、病院、薬局が表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайте заранее, куда идти при землетрясении. На этом экране показаны пункты сбора, больницы и аптеки поблизости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deprem anında nereye gideceğini önceden bil. Bu ekran çevrende toplanma alanlarını, hastaneleri ve eczaneleri gösterir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μάθε πού να πας πριν γίνει σεισμός. Αυτή η οθόνη δείχνει χώρους συγκέντρωσης, νοσοκομεία και φαρμακεία γύρω σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiba para onde ir antes de um terremoto. Esta tela mostra pontos de encontro, hospitais e farmácias perto de você."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketahui ke mana harus pergi sebelum gempa terjadi. Layar ini menampilkan titik kumpul, rumah sakit, dan apotek di sekitarmu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지진 전에 어디로 갈지 알아 두세요. 이 화면은 주변 대피 장소, 병원, 약국을 보여줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地震发生前知道该去哪里。此页面显示你周围的集合点、医院和药店。"
          }
        }
      }
    },
    "intro.assembly.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعثر على نقاط التجمع القريبة وافتح الاتجاهات إلى الموقع المختار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde nahe Sammelplätze auf der Karte und öffne die Route zum gewählten Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore nearby assembly areas on the map and open directions to your chosen location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta puntos de reunión cercanos y abre indicaciones al lugar elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repérez les points de rassemblement proches et ouvrez un itinéraire vers le lieu choisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova aree di raccolta vicine e apri le indicazioni per il punto scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの集合場所を地図で確認し、選んだ場所への経路を開けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите места сбора поблизости и откройте маршрут к выбранной точке."
