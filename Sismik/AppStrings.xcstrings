    "paywall.legal" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجدد الاشتراكات تلقائياً ما لم يتم الإلغاء قبل 24 ساعة على الأقل من نهاية الفترة الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf gekündigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically unless cancelled at least 24 hours before the end of the period. You can cancel anytime in your App Store account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente salvo cancelación al menos 24 h antes del fin del período."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24h avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente a meno che non vengano annullati almeno 24 ore prima della scadenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間終了の24時間前までに解約されない限り自動更新されます。App Storeのアカウント設定からいつでも解約できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка продлевается автоматически, если не отменена минимум за 24 часа до окончания срока."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik, dönem bitiminden en az 24 saat önce iptal edilmediği sürece otomatik yenilenir. App Store hesap ayarlarından istediğin an iptal edebilirsin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνδρομές ανανεώνονται αυτόματα, εκτός αν ακυρωθούν τουλάχιστον 24 ώρες πριν από τη λήξη της περιόδου. Μπορείς να ακυρώσεις οποτεδήποτε από τις ρυθμίσεις λογαριασμού App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas renovam automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período. Você pode cancelar quando quiser nos ajustes da conta da App Store."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperpanjang otomatis kecuali dibatalkan paling lambat 24 jam sebelum periode berakhir. Kamu bisa membatalkan kapan saja di pengaturan akun App Store."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 기간 종료 최소 24시간 전에 해지하지 않으면 자동 갱신됩니다. App Store 계정 설정에서 언제든 해지할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在当期结束前至少 24 小时取消，否则订阅将自动续订。你可以随时在 App Store 账户设置中取消。"
          }
        }
      }
    },
