    "ob2.emergency.trapped.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكرر الصافرة وضوء SOS تلقائيًا ويبقي الشاشة مضاءة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholt Pfeife und SOS-Licht selbstständig und hält den Bildschirm an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeats the whistle and SOS light on its own and keeps the screen on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite solo el silbato y la luz SOS y mantiene la pantalla encendida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète seul le sifflet et la lumière SOS et garde l'écran allumé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripete da solo fischietto e luce SOS e tiene lo schermo acceso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笛とSOSライトを自動で繰り返し、画面を点けたままにします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам повторяет свисток и SOS-свет и не даёт экрану погаснуть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düdük ve SOS ışığını kendiliğinden tekrarlar, ekranı açık tutar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναλαμβάνει μόνο του τη σφυρίχτρα και το φως SOS και κρατά την οθόνη αναμμένη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repete sozinho o apito e a luz SOS e mantém a tela acesa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengulang peluit dan lampu SOS sendiri serta menjaga layar tetap menyala."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호루라기와 SOS 빛을 스스로 반복하고 화면을 켜 둡니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动重复口哨和 SOS 灯光，并保持屏幕常亮。"
          }
        }
      }
    },
