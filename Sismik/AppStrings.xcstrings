    "ob3.alerts.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev, iş ya da ailenin şehri. Her yer için alanı ve eşiği sen seçersin; bildirim yerin adıyla gelir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home, work or your family's city. You choose the area and threshold for each place; the alert names the place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuhause, Arbeit oder die Stadt deiner Familie. Du wählst Bereich und Schwelle für jeden Ort; die Warnung nennt den Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, trabajo o la ciudad de tu familia. Tú eliges el área y el umbral de cada lugar; la alerta lleva su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maison, travail ou la ville de ta famille. Tu choisis la zone et le seuil de chaque lieu ; l'alerte le nomme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, lavoro o la città della tua famiglia. Scegli area e soglia per ogni luogo; l'avviso ne riporta il nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅、職場、家族の街。場所ごとに範囲としきい値を選べ、通知には場所の名前が表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дом, работа или город семьи. Для каждого места вы выбираете зону и порог; в уведомлении будет название места."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنزل أو العمل أو مدينة عائلتك. تختار المنطقة والعتبة لكل مكان، ويحمل التنبيه اسم المكان."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σπίτι, δουλειά ή η πόλη της οικογένειάς σου. Επιλέγεις περιοχή και όριο για κάθε μέρος· η ειδοποίηση γράφει το όνομά του."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, trabalho ou a cidade da sua família. Você escolhe a área e o limite de cada lugar; o alerta traz o nome dele."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah, kantor, atau kota keluargamu. Kamu memilih area dan ambang untuk tiap tempat; peringatan menyebut nama tempatnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집, 직장, 가족이 사는 도시. 장소마다 범위와 기준을 고르면 알림에 장소 이름이 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家、公司或家人所在的城市。你为每个地点选择范围和阈值，提醒会写明地点名称。"
          }
        }
      }
    },
    "ob3.alerts.felt.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alanın dışındaki güçlü depremler de, yerinde seçtiğin şiddette (III–V) hissedilecekse bildirilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strong quakes outside your area are alerted too, if they'll be felt at your place at the intensity you choose (III–V)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch starke Beben außerhalb deines Bereichs, wenn sie an deinem Ort mit der gewählten Intensität (III–V) spürbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También sismos fuertes fuera de tu área, si se sentirán en tu lugar con la intensidad que elijas (III–V)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séismes forts hors de ta zone aussi, s'ils seront ressentis chez toi à l'intensité choisie (III–V)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche terremoti forti fuori dalla tua area, se saranno avvertiti nel tuo luogo con l'intensità scelta (III–V)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲外の強い地震でも、あなたの場所で選んだ震度（III〜V）の揺れが予想されれば通知します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильные толчки за пределами зоны тоже, если в вашем месте они будут ощутимы с выбранной интенсивностью (III–V)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرسَل أيضًا تنبيهات الزلازل القوية خارج منطقتك إن كانت ستُحَس في مكانك بالشدة التي تختارها (III–V)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και ισχυροί σεισμοί εκτός περιοχής, αν θα γίνουν αισθητοί στο μέρος σου με την ένταση που επιλέγεις (III–V)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também terremotos fortes fora da sua área, se forem sentidos no seu lugar com a intensidade escolhida (III–V)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gempa kuat di luar areamu juga diberitahukan jika akan terasa di tempatmu dengan intensitas pilihanmu (III–V)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범위 밖의 강한 지진도 내 장소에서 선택한 진도(III–V)로 느껴진다면 알립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "范围外的强震若在你的地点达到所选烈度（III–V）也会提醒。"
          }
        }
      }
    },
