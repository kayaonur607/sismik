        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow one place up to 50 km and M6+ quakes worldwide for free; up to 8 places with Premium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue gratis un lugar hasta 50 km y los sismos M6+ del mundo; hasta 8 lugares con Premium."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez gratuitement un lieu jusqu'à 50 km et les séismes M6+ mondiaux ; jusqu'à 8 lieux avec Premium."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui gratis un luogo fino a 50 km e i terremoti M6+ nel mondo; fino a 8 luoghi con Premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1か所(半径50kmまで)と世界のM6以上は無料。Premiumなら8か所まで。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно: одно место в радиусе 50 км и M6+ по всему миру; с Premium до 8 мест."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yeri 50 km'ye kadar ve dünyadaki M6+ depremleri ücretsiz takip et; Premium ile 8 yere kadar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολούθησε δωρεάν μία τοποθεσία έως 50 km και σεισμούς M6+ παγκοσμίως· έως 8 τοποθεσίες με Premium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe grátis um lugar em até 50 km e terremotos M6+ no mundo; até 8 lugares com Premium."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantau gratis satu tempat hingga 50 km dan gempa M6+ di seluruh dunia; hingga 8 tempat dengan Premium."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1곳(반경 50km까지)과 전 세계 M6 이상 지진은 무료, Premium은 최대 8곳."
          }
        },
        "zh-Hans" : {
