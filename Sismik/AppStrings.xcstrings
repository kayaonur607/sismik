          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы почувствовали это землетрясение?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu depremi hissettin mi?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
