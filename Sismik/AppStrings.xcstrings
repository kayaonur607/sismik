    "impact.source" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GDACS (BM/AB) ve USGS PAGER'ın nüfus ve hasar modeline dayalı tahmini; resmî hasar tespiti değildir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimate by GDACS (UN/EU) and USGS PAGER based on population and damage models; not an official damage assessment."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung von GDACS (UN/EU) und USGS PAGER auf Basis von Bevölkerungs- und Schadensmodellen; keine offizielle Schadensbewertung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación de GDACS (ONU/UE) y USGS PAGER según modelos de población y daños; no es una evaluación oficial de daños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation de GDACS (ONU/UE) et de l'USGS PAGER d'après des modèles de population et de dégâts ; pas une évaluation officielle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima di GDACS (ONU/UE) e USGS PAGER basata su modelli di popolazione e danni; non è una valutazione ufficiale dei danni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GDACS（国連/EU）と USGS PAGER が人口・被害モデルに基づいて推定したもので、公式な被害評価ではありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка GDACS (ООН/ЕС) и USGS PAGER по моделям населения и ущерба; не является официальной оценкой ущерба."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير من GDACS (الأمم المتحدة/الاتحاد الأوروبي) وUSGS PAGER استنادًا إلى نماذج السكان والأضرار؛ وليس تقييمًا رسميًا للأضرار."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτίμηση του GDACS (ΟΗΕ/ΕΕ) και του USGS PAGER με βάση μοντέλα πληθυσμού και ζημιών· δεν είναι επίσημη αποτίμηση ζημιών."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa do GDACS (ONU/UE) e do USGS PAGER com base em modelos de população e danos; não é uma avaliação oficial."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan GDACS (PBB/UE) dan USGS PAGER berdasarkan model populasi dan kerusakan; bukan penilaian kerusakan resmi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GDACS(UN/EU)와 USGS PAGER가 인구·피해 모델로 추정한 값이며, 공식 피해 평가가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 GDACS（联合国/欧盟）和 USGS PAGER 根据人口与损失模型估算，并非官方灾损评估。"
          }
        }
      }
    },
