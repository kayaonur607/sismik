    "Distance, magnitude and depth are evaluated together. This is a model estimate, not a measurement." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تقييم المسافة والقدر والعمق معًا. هذا تقدير نموذجي وليس قياسًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernung, Stärke und Tiefe werden zusammen bewertet. Dies ist eine Modellschätzung, keine Messung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance, magnitude and depth are evaluated together. This is a model estimate, not a measurement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distancia, la magnitud y la profundidad se evalúan juntas. Esta es una estimación del modelo, no una medición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distance, la magnitude et la profondeur sont évaluées ensemble. Il s'agit d'une estimation de modèle, pas d'une mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanza, magnitudo e profondità vengono valutate insieme. Questa è una stima del modello, non una misurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離、規模、震源の深さは総合的に評価されます。これはモデルによる推定値であり、測定値ではありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расстояние, магнитуда и глубина оцениваются вместе. Это модельная оценка, а не измерение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesafe, büyüklük ve derinlik birlikte değerlendirilir. Bu bir model tahminidir, ölçüm değildir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόσταση, μέγεθος και βάθος αξιολογούνται μαζί. Είναι εκτίμηση μοντέλου, όχι μέτρηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância, magnitude e profundidade são avaliadas juntas. É uma estimativa de modelo, não uma medição."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarak, magnitudo, dan kedalaman dinilai bersama. Ini perkiraan model, bukan pengukuran."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거리, 규모, 깊이를 함께 평가합니다. 측정값이 아닌 모델 추정치입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合评估距离、震级和深度。这是模型估算，而非实测。"
          }
        }
      }
    },
