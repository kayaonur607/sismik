    "ob3.felt.button.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek dokunuşla bildir; 112, toplanma alanı ve yapılacaklar hemen açılır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report it with one tap; emergency call, assembly area and a checklist open right away."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Tippen melden; Notruf, Sammelplatz und Checkliste öffnen sich sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infórmalo con un toque; se abren al momento la llamada de emergencia, el punto de reunión y una lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale-le d'un geste ; appel d'urgence, point de rassemblement et liste s'ouvrent aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnalalo con un tocco; si aprono subito chiamata d'emergenza, area di raccolta e checklist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンタップで報告すると、緊急通報・避難場所・やることリストがすぐに開きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщите одним касанием — сразу откроются экстренный вызов, место сбора и список действий."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغ بلمسة واحدة؛ ويُفتح فورًا الاتصال بالطوارئ ونقطة التجمع وقائمة المهام."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανέφερέ το με ένα άγγιγμα· ανοίγουν αμέσως κλήση έκτακτης ανάγκης, χώρος συγκέντρωσης και λίστα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe com um toque; chamada de emergência, ponto de encontro e checklist abrem na hora."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporkan dengan satu ketukan; panggilan darurat, titik kumpul, dan daftar langkah langsung terbuka."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 눌러 알리면 긴급 전화, 대피 장소, 체크리스트가 바로 열립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一键报告，紧急呼叫、集合点和行动清单立即打开。"
          }
        }
      }
    },
