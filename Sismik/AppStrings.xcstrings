    "places.auto.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulunduğun yerin %1$d km çevresindeki M%2$@ ve üzeri depremler ile dünyadaki M6+ büyük depremler için bildirim alacaksın. Yeri, yarıçapı ve eşiği Ayarlar'daki takip ettiğin yerlerden değiştirebilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll be alerted to M%2$@+ quakes within %1$d km of where you are and M6+ quakes worldwide. Change the place, radius and threshold in Settings under your followed places."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst bei Beben ab M%2$@ im Umkreis von %1$d km um deinen Standort und bei weltweiten Beben ab M6 gewarnt. Ort, Radius und Schwelle änderst du in den Einstellungen unter deinen Orten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás alertas de sismos M%2$@+ a menos de %1$d km de donde estás y de sismos M6+ en todo el mundo. Cambia el lugar, el radio y el umbral en Ajustes, en tus lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu seras alerté des séismes M%2$@+ à moins de %1$d km de ta position et des séismes M6+ dans le monde. Modifie le lieu, le rayon et le seuil dans Réglages, sous tes lieux suivis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverai avvisi per terremoti M%2$@+ entro %1$d km da dove ti trovi e per terremoti M6+ nel mondo. Cambia luogo, raggio e soglia nelle Impostazioni, tra i tuoi luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地から %1$d km 以内の M%2$@ 以上の地震と、世界の M6 以上の地震を通知します。場所・半径・しきい値は設定のフォロー中の場所から変更できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы будете получать уведомления о землетрясениях M%2$@+ в радиусе %1$d км от вас и о землетрясениях M6+ по всему миру. Место, радиус и порог можно изменить в Настройках, в разделе ваших мест."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستصلك تنبيهات للزلازل M%2$@+ ضمن %1$d كم من موقعك وللزلازل M6+ حول العالم. غيّر المكان ونصف القطر والعتبة من الإعدادات ضمن الأماكن التي تتابعها."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα ειδοποιείσαι για σεισμούς M%2$@+ σε %1$d χλμ. από το σημείο σου και για σεισμούς M6+ παγκοσμίως. Άλλαξε μέρος, ακτίνα και όριο στις Ρυθμίσεις, στα μέρη που ακολουθείς."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você receberá alertas de terremotos M%2$@+ a até %1$d km de onde está e de terremotos M6+ no mundo. Altere o lugar, o raio e o limite em Ajustes, nos seus lugares."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu akan diberi tahu gempa M%2$@+ dalam %1$d km dari lokasimu dan gempa M6+ di seluruh dunia. Ubah tempat, radius, dan ambang di Pengaturan, pada tempat yang kamu ikuti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치 %1$dkm 이내의 M%2$@ 이상 지진과 전 세계 M6 이상 지진을 알려 드려요. 장소, 반경, 기준은 설정의 팔로우 중인 장소에서 바꿀 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将收到所在位置 %1$d 公里内 M%2$@ 以上地震及全球 M6 以上地震的提醒。可在设置的关注地点中更改地点、半径和阈值。"
          }
        }
      }
    },
