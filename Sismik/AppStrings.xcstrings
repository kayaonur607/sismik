    "felt.map.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المواقع التقريبية لمن شعروا به (مناطق بعرض ~11 كم). اللون الأغمق يعني بلاغات أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungefähre Orte der Personen, die es gespürt haben (~11-km-Bereiche). Dunkler bedeutet mehr Meldungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approximate locations of people who felt it (~11 km areas). Darker means more reports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación aproximada de quienes lo sintieron (zonas de ~11 km). Más oscuro significa más reportes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positions approximatives des personnes l'ayant ressenti (zones d'~11 km). Plus foncé = plus de signalements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizioni approssimative di chi l'ha avvertito (aree di ~11 km). Più scuro significa più segnalazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揺れを感じた人のおおよその位置（約11 kmの区域）。色が濃いほど報告が多いことを示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примерное расположение тех, кто его почувствовал (зоны ~11 км). Чем темнее, тем больше сообщений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hissettiğini bildirenlerin yaklaşık konumları (~11 km'lik bölgeler). Koyu renk daha çok rapor demek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά προσέγγιση θέσεις όσων τον ένιωσαν (περιοχές ~11 km). Πιο σκούρο σημαίνει περισσότερες αναφορές."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locais aproximados de quem sentiu (áreas de ~11 km). Mais escuro significa mais relatos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan lokasi orang yang merasakannya (area ~11 km). Makin gelap berarti makin banyak laporan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느낀 사람들의 대략적 위치(약 11 km 구역). 진할수록 보고가 많습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有震感者的大致位置（约 11 公里区域）。颜色越深表示报告越多。"
          }
        }
      }
    },
