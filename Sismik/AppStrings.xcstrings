        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心肺复苏"
          }
        }
      }
    },
    "firstaid.crush.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل تحرير طرف محصور لساعات، انتظر الفريق الطبي أو أبلغه إن أمكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor ein stundenlang eingeklemmtes Körperteil befreit wird, möglichst auf den Rettungsdienst warten oder ihn verständigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before freeing a limb that has been pinned for hours, wait for or alert medical teams if at all possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de liberar un miembro atrapado durante horas, espera o avisa a los equipos médicos si es posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de dégager un membre coincé depuis des heures, attendez ou prévenez les secours médicaux si possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di liberare un arto schiacciato da ore, se possibile attendi o avvisa i sanitari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何時間も挟まれている手足を解放する前に、可能なら医療チームを待つか知らせる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем освободить конечность, сдавленную часами, по возможности дождитесь медиков или сообщите им."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uzvu saatlerce sıkışmış kişiyi serbest bırakmadan önce mümkünse sağlık ekibini bekle ya da haber ver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν απελευθερώσεις άκρο που είναι παγιδευμένο για ώρες, περίμενε ή ειδοποίησε ιατρική ομάδα αν είναι δυνατόν."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de liberar um membro preso por horas, espere ou avise equipes médicas, se possível."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum membebaskan anggota tubuh yang terjepit berjam-jam, tunggu atau beri tahu tim medis bila memungkinkan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 시간 동안 끼어 있던 팔다리를 빼기 전에 가능하면 의료진을 기다리거나 알리세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在解救被压数小时的肢体前，尽可能等待或通知医疗人员。"
          }
        }
      }
    },
    "firstaid.crush.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الشخص المنقَذ ساكنًا وغطِّه كي لا يبرد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gerettete Person ruhig halten und zudecken, damit sie nicht auskühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the rescued person still and covered so they don't get cold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén quieta a la persona rescatada y abrígala para que no se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la personne dégagée immobile et couverte pour qu'elle n'ait pas froid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni ferma la persona soccorsa e coprila perché non prenda freddo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "救出した人は動かさず、体が冷えないよう覆う。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите спасённого неподвижно и укройте, чтобы он не замёрз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurtarılan kişiyi hareketsiz tut, üşümemesi için üstünü ört."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτησε τον διασωθέντα ακίνητο και σκεπασμένο για να μην κρυώσει."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a pessoa resgatada parada e coberta para não sentir frio."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga orang yang diselamatkan tetap diam dan berselimut agar tidak kedinginan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구조된 사람을 움직이지 말고 덮어 체온을 유지하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让获救者保持不动并盖好，以免受凉。"
          }
        }
      }
    },
    "firstaid.crush.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على أي نزيف؛ ولا تدلّك المنطقة المنضغطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blutungen abdrücken; die gequetschte Stelle nicht massieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply pressure to any bleeding; don't massage the crushed area."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona si hay hemorragia; no masajees la zona aplastada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimez tout saignement ; ne massez pas la zone écrasée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi su eventuali emorragie; non massaggiare la zona schiacciata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出血があれば圧迫し、挟まれていた部分をもまない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При кровотечении прижмите рану; не массируйте сдавленную область."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanama varsa bası uygula; ezilen bölgeye masaj yapma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πίεσε κάθε αιμορραγία· μην κάνεις μασάζ στη συνθλιμμένη περιοχή."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione qualquer sangramento; não massageie a área esmagada."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan setiap perdarahan; jangan memijat area yang terjepit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출혈 부위를 압박하고, 눌렸던 부위는 문지르지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按压止血；不要按摩受挤压的部位。"
          }
        }
      }
    },
    "firstaid.crush.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب نقله إلى المستشفى حتى لو شعر بأنه بخير؛ البول الداكن والضعف علامات خطر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn es der Person gut geht, muss sie ins Krankenhaus; dunkler Urin und Schwäche sind Warnzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They must reach a hospital even if they feel fine; dark urine and weakness are warning signs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe ir al hospital aunque se sienta bien; orina oscura y debilidad son señales de alarma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne doit aller à l'hôpital même si elle se sent bien ; urines foncées et faiblesse sont des signes d'alerte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deve arrivare in ospedale anche se si sente bene; urine scure e debolezza sono segnali d'allarme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人が元気そうでも必ず病院へ。濃い色の尿やだるさは危険な兆候です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при хорошем самочувствии нужна больница; тёмная моча и слабость — тревожные признаки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendini iyi hissetse bile mutlaka hastaneye ulaştırılmalı; koyu idrar ve halsizlik tehlike işaretidir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρέπει να πάει στο νοσοκομείο ακόμη κι αν νιώθει καλά· σκούρα ούρα και αδυναμία είναι σημάδια κινδύνου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pessoa precisa ir ao hospital mesmo que se sinta bem; urina escura e fraqueza são sinais de alerta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka harus ke rumah sakit meski merasa baik; urine gelap dan lemas adalah tanda bahaya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "괜찮다고 느껴도 반드시 병원에 가야 합니다. 짙은 소변과 무력감은 위험 신호입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使感觉良好也必须送医；尿色深和乏力是危险信号。"
          }
        }
      }
    },
    "firstaid.crush.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تسوء حالة من انحُصر لفترة طويلة فجأة بعد تحريره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer lange eingeklemmt war, kann sich nach der Befreiung plötzlich verschlechtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone pinned for a long time can suddenly worsen once freed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien atrapado mucho tiempo puede empeorar de repente al ser liberado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une personne longtemps coincée peut se dégrader brusquement une fois dégagée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi è rimasto a lungo schiacciato può peggiorare all'improvviso una volta liberato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長時間挟まれていた人は、救出後に急に容体が悪化することがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У человека, долго находившегося под завалом, после освобождения состояние может резко ухудшиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun süre sıkışan kişi kurtarılınca durumu aniden kötüleşebilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος ήταν εγκλωβισμένος για ώρα μπορεί να επιδεινωθεί ξαφνικά μόλις απελευθερωθεί."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem ficou preso por muito tempo pode piorar de repente ao ser libertado."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang lama terjepit bisa tiba-tiba memburuk setelah dibebaskan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래 깔려 있던 사람은 풀려난 뒤 갑자기 상태가 나빠질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被长时间压住的人获救后情况可能突然恶化。"
          }
        }
      }
    },
