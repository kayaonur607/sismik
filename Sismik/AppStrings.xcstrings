    "Sarsıntının bulunduğun yerdeki tahmini etkisini hesaplamak için konum erişimine izin ver." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع لتقدير الاهتزاز في موقعك الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standortzugriff, um die Erschütterung an deinem aktuellen Standort zu schätzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location access to estimate shaking at your current position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la ubicación para estimar el temblor en tu posición actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l'accès à la localisation pour estimer les secousses à ta position actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l'accesso alla posizione per stimare lo scuotimento nel punto in cui ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地での揺れを推定するために、位置情報へのアクセスを許可してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к геопозиции, чтобы оценить сотрясение в вашем текущем местоположении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarsıntının bulunduğun yerdeki tahmini etkisini hesaplamak için konum erişimine izin ver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε την πρόσβαση στην τοποθεσία για εκτίμηση της δόνησης στη θέση σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
