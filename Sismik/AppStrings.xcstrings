    "ob2.list.major.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في أعلى القائمة للزلازل M5.5 فأكثر في تركيا؛ تابع الهزات الارتدادية مباشرة على شاشة القفل وفي Dynamic Island."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei M5.5+ in der Türkei ganz oben in der Liste; verfolge Nachbeben live auf dem Sperrbildschirm und in der Dynamic Island."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the top of the list for M5.5+ in Türkiye; follow aftershocks live on your Lock Screen and in the Dynamic Island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba de la lista con M5.5+ en Turquía; sigue las réplicas en directo en la pantalla bloqueada y en la Dynamic Island."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tête de liste pour les séismes M5.5+ en Turquie ; suis les répliques en direct sur l'écran verrouillé et dans la Dynamic Island."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In cima alla lista per i terremoti M5.5+ in Turchia; segui le repliche dal vivo sulla schermata di blocco e nella Dynamic Island."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トルコでの M5.5 以上はリストの先頭に。余震をロック画面とダイナミックアイランドでライブ追跡できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При M5.5+ в Турции — наверху списка; следите за афтершоками на экране блокировки и в Dynamic Island."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Türkiye'de M5.5 ve üzeri depremde listenin başında; artçıları kilit ekranında ve Dynamic Island'da canlı takip et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην κορυφή της λίστας για M5.5+ στην Τουρκία· παρακολουθήστε τους μετασεισμούς ζωντανά στην οθόνη κλειδώματος και στο Dynamic Island."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No topo da lista em terremotos M5.5+ na Turquia; acompanhe as réplicas ao vivo na Tela Bloqueada e na Dynamic Island."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di bagian atas daftar untuk M5.5+ di Turki; pantau gempa susulan langsung di Layar Terkunci dan Dynamic Island."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "튀르키예 M5.5 이상은 목록 맨 위에. 여진을 잠금 화면과 Dynamic Island에서 실시간으로 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土耳其 M5.5 及以上地震置顶显示；在锁定屏幕和灵动岛上实时追踪余震。"
          }
        }
      }
    },
