    "intensity.desc.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقعك خارج نطاق التأثير المحسوس للزلزال. لا يُتوقع أي اهتزاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Standort liegt außerhalb des Spürbarkeitsbereichs. Keine Erschütterungen erwartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is outside the felt area of this event. No shaking expected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación está fuera del área de impacto. No se esperan sacudidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position est hors de la zone d'impact. Aucune secousse attendue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua posizione è fuori dall'area di risentimento. Nessuno scuotimento previsto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地は地震の影響範囲外です。揺れは感知されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше местоположение вне зоны воздействия. Колебания не ощущаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunuz depremin etki alanının dışındadır. Herhangi bir sarsıntı hissedilmez."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η θέση σου είναι εκτός της περιοχής όπου έγινε αισθητό το συμβάν. Δεν αναμένεται δόνηση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu local está fora da área em que o evento foi sentido. Não se espera tremor."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasimu di luar area terasa kejadian ini. Tidak ada guncangan yang diperkirakan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 위치는 이 지진의 감지 범위 밖입니다. 흔들림이 예상되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的位置不在此次事件的有感范围内，预计无震感。"
          }
        }
      }
    },
    "intensity.desc.1_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير محسوس لمعظم الأشخاص؛ يُلاحظ فقط في ظروف السكون التام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meist unbemerkt; nur unter sehr ruhigen Bedingungen spürbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually not felt; may be noticed under quiet conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generalmente imperceptible; solo en condiciones de reposo total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Généralement non ressenti ; uniquement au repos complet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generalmente non avvertito; solo in condizioni di perfetto riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどの人は感じません。極めて静止した状態でのみ感じることがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как правило, не ощущается; возможно лишь в состоянии полного покоя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu kişi tarafından hissedilmez; sakin koşullarda fark edilebilir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνήθως δεν γίνεται αισθητός· μπορεί να γίνει αντιληπτός σε ησυχία."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geralmente não é sentido; pode ser notado em silêncio."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biasanya tidak terasa; mungkin terasa dalam kondisi tenang."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대개 느껴지지 않지만 조용할 때는 알아챌 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常无震感；安静时可能察觉。"
          }
        }
      }
    },
    "intensity.desc.3_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسوس بوضوح في الأماكن المغلقة؛ قد تتأرجح الأجسام المعلقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
