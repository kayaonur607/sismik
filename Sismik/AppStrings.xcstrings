    "places.legacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستستمر التنبيهات بهذه الإعدادات حتى تحفظ أول مكان. بعد ذلك، تصلك التنبيهات للأماكن التي تحفظها فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis du deinen ersten Ort speicherst, kommen Warnungen weiter mit diesen Einstellungen. Danach richten sie sich nur nach deinen gespeicherten Orten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts keep arriving with these settings until you save your first place. Once you add one, alerts follow only the places you save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas seguirán llegando con esta configuración hasta que guardes tu primer lugar. Después, solo seguirán los lugares que guardes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes continuent avec ces réglages jusqu’à ce que vous enregistriez un premier lieu. Ensuite, elles suivent uniquement vos lieux enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi continuano con queste impostazioni finché non salvi il primo luogo. Dopo, seguono solo i luoghi salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の場所を保存するまで、この設定で通知が届きます。場所を追加すると、保存した場所だけが通知の対象になります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы не сохраните первое место, оповещения приходят по этим настройкам. После этого — только по сохранённым местам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk yerini kaydedene kadar bildirimler bu ayarla gelmeye devam eder. Yer eklediğinde bildirimler yalnızca kaydettiğin yerlere göre gelir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις έρχονται με αυτές τις ρυθμίσεις μέχρι να αποθηκεύσεις την πρώτη σου τοποθεσία. Μετά ακολουθούν μόνο τις τοποθεσίες σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os alertas continuam chegando com estas configurações até você salvar seu primeiro lugar. Depois disso, seguem apenas os lugares salvos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan tetap datang dengan pengaturan ini sampai kamu menyimpan tempat pertama. Setelah itu, peringatan hanya mengikuti tempat yang kamu simpan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 장소를 저장할 때까지 이 설정으로 알림이 계속 옵니다. 장소를 추가하면 저장한 장소 기준으로만 알립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你保存第一个地点之前，提醒会按此设置继续发送。添加地点后，仅针对你保存的地点提醒。"
          }
