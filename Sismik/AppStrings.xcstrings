    "risk.building.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفعت اللوائح بعد 1999 وكود الزلازل التركي لعام 2018 متانة المباني بشكل ملحوظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorschriften nach 1999 und die türkische Erdbebenbauvorschrift 2018 haben die Widerstandsfähigkeit deutlich erhöht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codes introduced after 1999 and Türkiye’s 2018 Building Earthquake Code markedly improved building resilience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las normas posteriores a 1999 y el código sísmico turco de 2018 mejoraron notablemente la resistencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les normes après 1999 et le code sismique turc de 2018 ont nettement amélioré la résistance des bâtiments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le norme dopo il 1999 e il codice sismico turco del 2018 hanno migliorato nettamente la resistenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1999年以降の基準と2018年のトルコ建築耐震基準により、建物の耐震性は大きく向上しました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нормы после 1999 года и турецкий сейсмический кодекс 2018 года заметно повысили прочность зданий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1999 sonrası yönetmelikler ve 2018 Türkiye Bina Deprem Yönetmeliği binaların dayanımını belirgin artırdı."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κανονισμοί μετά το 1999 και ο Αντισεισμικός Κανονισμός της Τουρκίας του 2018 βελτίωσαν σημαντικά την αντοχή των κτιρίων."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As normas criadas após 1999 e o Código Sísmico de Edificações da Turquia de 2018 melhoraram muito a resistência dos prédios."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan setelah 1999 dan Kode Gempa Bangunan Türkiye 2018 sangat meningkatkan ketahanan bangunan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1999년 이후 도입된 기준과 튀르키예의 2018년 건축물 내진 기준으로 건물 내구성이 크게 향상되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1999 年后出台的规范及土耳其 2018 年建筑抗震规范显著提升了建筑的抗震能力。"
          }
        }
      }
    },
    "risk.building.footer.global" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncel deprem yönetmeliğine göre yapılan binalar genellikle daha dayanıklıdır; ülkendeki yönetmeliğin değiştiği yılı yerel yetkililerden öğrenebilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buildings built to current seismic codes are usually stronger; local authorities can tell you when your country's code changed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach aktuellen Erdbebennormen errichtete Gebäude sind meist widerstandsfähiger; wann sich die Norm in deinem Land geändert hat, erfährst du bei den örtlichen Behörden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los edificios construidos según la normativa sísmica actual suelen ser más resistentes; las autoridades locales pueden decirte cuándo cambió la de tu país."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bâtiments conformes aux normes parasismiques actuelles sont généralement plus solides ; les autorités locales peuvent te dire quand la norme de ton pays a changé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli edifici costruiti secondo le norme sismiche attuali sono in genere più resistenti; le autorità locali possono dirti quando è cambiata la norma nel tuo paese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現行の耐震基準で建てられた建物は一般に丈夫です。基準が変わった年は自治体に確認できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здания, построенные по действующим сейсмическим нормам, обычно прочнее; когда нормы в вашей стране изменились, подскажут местные власти."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المباني المشيدة وفق كود الزلازل الحالي تكون عادةً أمتن؛ يمكن للسلطات المحلية إخبارك متى تغيّر الكود في بلدك."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κτίρια που χτίστηκαν με τους τρέχοντες αντισεισμικούς κανονισμούς είναι συνήθως πιο ανθεκτικά· οι τοπικές αρχές μπορούν να σου πουν πότε άλλαξε ο κανονισμός στη χώρα σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prédios construídos pelas normas sísmicas atuais costumam ser mais resistentes; as autoridades locais podem informar quando a norma do seu país mudou."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bangunan yang dibangun sesuai standar gempa terkini umumnya lebih kuat; pemerintah setempat bisa memberi tahu kapan standar di negaramu berubah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현행 내진 기준으로 지은 건물은 대체로 더 튼튼합니다. 기준이 바뀐 해는 지자체에 문의하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按现行抗震规范建造的建筑通常更坚固；当地主管部门可以告诉你所在国家规范的变更年份。"
          }
        }
      }
    },
    "risk.building.subtitle" : {
