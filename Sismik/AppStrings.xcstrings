    "Sistem uzaklık, büyüklük ve derinliği birlikte değerlendirir. Bu değer bir ölçüm değil, bilimsel model tahminidir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيم النظام المسافة والقدر والعمق معًا. هذه القيمة ليست قياسًا، بل هي تقدير لنموذج علمي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System bewertet Entfernung, Magnitude und Tiefe gemeinsam. Dieser Wert ist keine Messung, sondern eine wissenschaftliche Modellschätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system evaluates distance, magnitude, and depth together. This value is not a measurement, but a scientific model estimation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema evalúa conjuntamente la distancia, la magnitud y la profundidad. Este valor no es una medición, sino una estimación de un modelo científico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système évalue conjointement la distance, la magnitude et la profondeur. Cette valeur n'est pas une mesure, mais une estimation de modèle scientifique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sistema valuta congiuntamente distanza, magnitudo e profondità. Questo valore non è una misurazione, ma una stima del modello scientifico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムは距離、規模（マグニチュード）、震源の深さを総合的に評価します。この値は測定値ではなく、科学的モデルによる予測値です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Система оценивает расстояние, магнитуду и глубину вместе. Это значение является не измерением, а оценкой научной модели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem uzaklık, büyüklük ve derinliği birlikte değerlendirir. Bu değer bir ölçüm değil, bilimsel model tahminidir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το σύστημα αξιολογεί μαζί απόσταση, μέγεθος και βάθος. Η τιμή αυτή δεν είναι μέτρηση, αλλά εκτίμηση επιστημονικού μοντέλου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema avalia distância, magnitude e profundidade juntas. Este valor não é uma medição, e sim uma estimativa de modelo científico."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem menilai jarak, magnitudo, dan kedalaman bersama-sama. Nilai ini bukan pengukuran, melainkan estimasi model ilmiah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거리, 규모, 깊이를 함께 평가합니다. 이 값은 측정값이 아니라 과학적 모델 추정치입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统综合评估距离、震级和深度。该数值不是实测，而是科学模型估算。"
          }
        }
      }
    },
