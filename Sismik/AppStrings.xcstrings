    "onboarding.group.tracking.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تندمج المصادر الرسمية في تدفّق واحد: الخريطة والصدوع والتأثير الشخصي في شاشة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offizielle Quellen fließen in einem Stream zusammen – Karte, Verwerfungen und persönliche Auswirkung auf einem Bildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Official sources merge into one stream — map, fault lines, and personal impact on one screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes oficiales se unen en un solo flujo: mapa, fallas e impacto personal en una pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources officielles fusionnent en un seul flux : carte, failles et impact personnel sur un même écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fonti ufficiali confluiscono in un unico flusso: mappa, faglie e impatto personale in una schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式データを一つの流れに統合。地図・断層・体感影響を同じ画面で。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Официальные источники объединяются в один поток: карта, разломы и личное воздействие на одном экране."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resmî kaynaklar tek akışta birleşir; harita, faylar ve kişisel etki tahmini aynı ekranda."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επίσημες πηγές ενώνονται σε μία ροή — χάρτης, ρήγματα και προσωπική επίπτωση σε μία οθόνη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontes oficiais em um só fluxo — mapa, falhas e impacto pessoal em uma tela."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber resmi menyatu dalam satu aliran — peta, garis sesar, dan dampak pribadi dalam satu layar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공식 출처가 하나로 모입니다 — 지도, 단층, 개인 영향이 한 화면에."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "官方来源汇成一个信息流——地图、断层和个人影响尽在一屏。"
          }
        }
      }
    },
    "onboarding.group.tracking.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد كل زلزال في لحظة وقوعه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Beben im Moment seines Auftretens sehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See every quake the moment it happens"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa cada sismo en el momento en que ocurre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez chaque séisme dès qu’il se produit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi ogni terremoto nell’istante in cui accade"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震が起きたその瞬間に把握"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видьте каждое землетрясение в момент его возникновения"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depremi oluştuğu anda gör"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες κάθε σεισμό τη στιγμή που γίνεται"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja cada terremoto no momento em que acontece"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat setiap gempa saat terjadi"
          }
        },
        "ko" : {
