    "ob2.welcome.live.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD وKandilli وEMSC وUSGS والوكالات الإقليمية مثل JMA وBMKG وGeoNet في قائمة واحدة؛ يظهر سجل أول جهة تنشر فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS und regionale Dienste wie JMA, BMKG und GeoNet in einer Liste; die zuerst veröffentlichte Meldung erscheint sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS and regional agencies like JMA, BMKG and GeoNet in one list; the first agency to publish shows up instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS y agencias regionales como JMA, BMKG y GeoNet en una sola lista; la primera en publicar aparece al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS et des agences régionales comme la JMA, le BMKG et GeoNet dans une seule liste ; la première à publier apparaît aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS e agenzie regionali come JMA, BMKG e GeoNet in un'unica lista; la prima a pubblicare compare subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD、Kandilli、EMSC、USGS に加え、気象庁・BMKG・GeoNet などの地域機関をひとつのリストに。最初に発表された情報がすぐに表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS и региональные службы — JMA, BMKG, GeoNet — в одном списке; данные первой опубликовавшей службы видны сразу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS ve JMA, BMKG, GeoNet gibi bölgesel ajanslar tek listede; depremi ilk yayımlayan kaynağın kaydı hemen görünür."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS και περιφερειακές υπηρεσίες όπως JMA, BMKG και GeoNet σε μία λίστα· η πρώτη καταγραφή εμφανίζεται αμέσως."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS e agências regionais como JMA, BMKG e GeoNet em uma só lista; o registro de quem publica primeiro aparece na hora."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS, dan lembaga regional seperti JMA, BMKG, dan GeoNet dalam satu daftar; data yang pertama terbit langsung tampil."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AFAD, Kandilli, EMSC, USGS와 JMA·BMKG·GeoNet 등 지역 기관을 한 목록에서. 가장 먼저 발표된 정보가 바로 표시됩니다."
