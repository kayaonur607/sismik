    "ob3.felt.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınında ya da uzakta olup hissedebileceğin bir deprem olduğunda listenin başında bir kart çıkar. Kural herkes için aynı; kartı istediğin an kapatabilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a quake you may have felt happens — nearby or far away — a card appears at the top of the list. The rule is the same for everyone, and you can dismiss it anytime."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es ein Beben, das du gespürt haben könntest – nah oder fern –, erscheint oben in der Liste eine Karte. Die Regel gilt für alle, und du kannst sie jederzeit schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando ocurre un sismo que pudiste sentir, cerca o lejos, aparece una tarjeta al inicio de la lista. La regla es igual para todos y puedes cerrarla cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un séisme que tu as pu ressentir se produit, proche ou lointain, une carte apparaît en haut de la liste. La règle est la même pour tous et tu peux la fermer à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando avviene un terremoto che potresti aver sentito, vicino o lontano, in cima alla lista compare una scheda. La regola è uguale per tutti e puoi chiuderla quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くでも遠くでも、あなたが感じた可能性のある地震が起きるとリストの一番上にカードが表示されます。ルールは全員共通で、いつでも閉じられます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда происходит землетрясение, которое вы могли почувствовать — рядом или далеко, — вверху списка появляется карточка. Правило одно для всех, закрыть её можно в любой момент."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند وقوع زلزال ربما شعرت به، قريبًا كان أو بعيدًا، تظهر بطاقة أعلى القائمة. القاعدة نفسها للجميع، ويمكنك إغلاقها متى شئت."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν γίνει σεισμός που ίσως ένιωσες, κοντά ή μακριά, εμφανίζεται μια κάρτα στην κορυφή της λίστας. Ο κανόνας είναι ίδιος για όλους και μπορείς να την κλείσεις όποτε θέλεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando acontece um terremoto que você pode ter sentido, perto ou longe, um cartão aparece no topo da lista. A regra é igual para todos e você pode fechá-lo quando quiser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat terjadi gempa yang mungkin kamu rasakan, dekat atau jauh, sebuah kartu muncul di atas daftar. Aturannya sama untuk semua orang, dan kamu bisa menutupnya kapan saja."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까이든 멀리든 내가 느꼈을 수 있는 지진이 나면 목록 맨 위에 카드가 나타납니다. 규칙은 모두에게 같고, 언제든 닫을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当发生你可能感受到的地震（无论远近），列表顶部会出现一张卡片。规则对所有人相同，你可以随时关闭。"
          }
        }
      }
    },
    "ob3.felt.live.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük depremde artçılar kilit ekranında ve Dynamic Island'da güncellenir, uygulama kapalıyken bile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a major quake, aftershocks update on your Lock Screen and in the Dynamic Island, even with the app closed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem starken Beben aktualisieren sich Nachbeben auf dem Sperrbildschirm und in der Dynamic Island, auch bei geschlossener App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un sismo grande, las réplicas se actualizan en la pantalla bloqueada y la Dynamic Island, incluso con la app cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un fort séisme, les répliques s'actualisent sur l'écran verrouillé et dans la Dynamic Island, même app fermée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un forte terremoto le repliche si aggiornano su schermata di blocco e Dynamic Island, anche ad app chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大地震の後、余震はロック画面と Dynamic Island で更新されます。アプリを閉じていても届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сильного землетрясения афтершоки обновляются на экране блокировки и в Dynamic Island, даже когда приложение закрыто."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد زلزال كبير تتحدث الهزات الارتدادية على شاشة القفل وفي Dynamic Island حتى والتطبيق مغلق."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από μεγάλο σεισμό οι μετασεισμοί ενημερώνονται στην οθόνη κλειδώματος και στο Dynamic Island, ακόμη και με κλειστή εφαρμογή."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após um grande terremoto, as réplicas atualizam na tela bloqueada e na Dynamic Island, mesmo com o app fechado."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah gempa besar, gempa susulan diperbarui di Layar Terkunci dan Dynamic Island, bahkan saat aplikasi ditutup."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 지진 후 여진이 잠금 화면과 Dynamic Island에서 업데이트됩니다. 앱을 닫아도 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大地震后，余震会在锁定屏幕和灵动岛上更新，即使应用已关闭。"
          }
        }
      }
    },
