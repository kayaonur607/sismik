            "value" : "Vous guide vers le point sûr le plus proche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti guida al punto sicuro più vicino"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最寄りの安全な場所まで案内します"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводит вас к ближайшей безопасной точке"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana en yakın güvenli noktaya yönlendirir"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε οδηγεί στο πλησιέστερο ασφαλές σημείο"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guia você até o ponto seguro mais próximo"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memandumu ke titik aman terdekat"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 가까운 안전 지점으로 안내합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引导你前往最近的安全点"
