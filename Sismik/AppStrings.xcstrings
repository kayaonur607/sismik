    "intro.assembly.favorite.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد نقطة واضغط على النجمة. تُحفظ المفضلة على جهازك وتفتح حتى بدون إنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ort aus und tippe auf den Stern. Favoriten werden auf deinem Gerät gespeichert und öffnen sich auch ohne Internet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a place and tap the star. Favorites live on your device and open without internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un punto y toca la estrella. Los favoritos se guardan en tu dispositivo y se abren incluso sin internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un point et touchez l'étoile. Les favoris sont enregistrés sur votre appareil et s'ouvrent même sans connexion internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un punto e tocca la stella. I preferiti vengono salvati sul tuo dispositivo e si aprono anche senza internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地点を選択して星のアイコンをタップします。お気に入りは端末に保存され、インターネットがなくても表示できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите точку и нажмите на звездочку. Избранное сохраняется на устройстве и доступно без интернета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir noktayı seçip yıldıza dokun. Favoriler cihazında saklanır ve internet olmadan da açılır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε ένα μέρος και πάτα το αστέρι. Τα αγαπημένα μένουν στη συσκευή σου και ανοίγουν χωρίς διαδίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um lugar e toque na estrela. Os favoritos ficam no seu aparelho e abrem sem internet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempat dan ketuk bintang. Favorit tersimpan di perangkatmu dan terbuka tanpa internet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소를 고르고 별을 누르세요. 즐겨찾기는 기기에 있어 인터넷 없이 열립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择地点并点按星标。收藏保存在设备上，无需网络即可打开。"
          }
        }
      }
    },
