    "ob3.sources.map.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depremin haritasında artçı alanını, artçıları ve kayıtlı yerlerini gör; istediğin katmanı gizle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the aftershock zone, aftershocks and your places on the quake's map; hide any layer you like."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh Nachbebenzone, Nachbeben und deine Orte auf der Karte des Bebens; blende Ebenen nach Wunsch aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la zona de réplicas, las réplicas y tus lugares en el mapa del sismo; oculta la capa que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois la zone de répliques, les répliques et tes lieux sur la carte du séisme ; masque les calques voulus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi zona delle repliche, repliche e i tuoi luoghi sulla mappa del terremoto; nascondi i livelli che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震の地図で余震域・余震・登録した場所を確認し、不要なレイヤーは非表示にできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карте землетрясения видны зона афтершоков, сами афтершоки и ваши места; любой слой можно скрыть."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد منطقة الهزات الارتدادية والهزات وأماكنك على خريطة الزلزال، وأخفِ أي طبقة تريدها."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες τη ζώνη μετασεισμών, τους μετασεισμούς και τα μέρη σου στον χάρτη του σεισμού· κρύψε όποιο επίπεδο θέλεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a zona de réplicas, as réplicas e seus lugares no mapa do terremoto; oculte a camada que quiser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat zona gempa susulan, gempa susulan, dan tempatmu di peta gempa; sembunyikan lapisan sesukamu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지진 지도에서 여진 구역, 여진, 내 장소를 보고 원하는 레이어는 숨길 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地震地图上查看余震区、余震和你的地点，可隐藏任意图层。"
          }
        }
      }
    },
