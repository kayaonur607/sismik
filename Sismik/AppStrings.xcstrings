    "Karanlıkta görünürlük sağlamak için ekran ve kamera flaşı sinyali." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشارة بالشاشة وفلاش الكاميرا لتكون مرئيًا في الظلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
