    "places.rules.disabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الإشعارات لإضافة أماكنك وتحديد نطاق وعتبة لكل منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Benachrichtigungen, um Orte hinzuzufügen und je Radius und Schwelle festzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn notifications on to add the places you follow and set a radius and magnitude threshold for each."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa los avisos para añadir lugares y definir radio y umbral para cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les alertes pour ajouter vos lieux et définir rayon et seuil pour chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva le notifiche per aggiungere luoghi e impostare raggio e soglia per ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知をオンにすると、フォローする地点と地点ごとの半径・しきい値を設定できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите уведомления, чтобы добавить места и задать радиус и порог для каждого."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimleri açtığında takip ettiğin yerleri, her biri için yarıçap ve büyüklük eşiğini buradan belirlersin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίησε τις ειδοποιήσεις για να προσθέσεις τις τοποθεσίες που παρακολουθείς και να ορίσεις ακτίνα και όριο μεγέθους για καθεμία."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative as notificações para adicionar os lugares que acompanha e definir raio e magnitude mínima para cada um."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan notifikasi untuk menambah tempat yang kamu pantau serta mengatur radius dan ambang magnitudo masing-masing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림을 켜면 지켜볼 장소를 추가하고 장소마다 반경과 최소 규모를 정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启通知后即可添加关注地点，并为每个地点设定半径和震级阈值。"
          }
        }
      }
    },
