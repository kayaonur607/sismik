    "pi.action.authorities" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasar görüyorsan, gaz kokusu alıyorsan ya da resmî tahliye çağrısı varsa yerel yetkililerin yönlendirmesini izle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you see damage, smell gas or receive an official evacuation order, follow local authorities."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Schäden siehst, Gas riechst oder eine Evakuierungsanordnung erhältst, folge den örtlichen Behörden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ves daños, hueles gas o recibes una orden oficial de evacuación, sigue a las autoridades locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu vois des dégâts, sens le gaz ou reçois un ordre d'évacuation, suis les autorités locales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vedi danni, senti odore di gas o ricevi un ordine di evacuazione, segui le autorità locali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被害が見られる、ガスの臭いがする、避難指示が出た場合は、地元当局の指示に従ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если видите повреждения, чувствуете запах газа или получили приказ об эвакуации, следуйте указаниям властей."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا رأيت أضرارًا أو شممت رائحة غاز أو صدر أمر رسمي بالإخلاء، فاتبع توجيهات السلطات المحلية."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεις ζημιές, μυρίσεις αέριο ή λάβεις εντολή εκκένωσης, ακολούθησε τις τοπικές αρχές."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vir danos, sentir cheiro de gás ou receber ordem de evacuação, siga as autoridades locais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika melihat kerusakan, mencium bau gas, atau ada perintah evakuasi resmi, ikuti arahan otoritas setempat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피해가 보이거나 가스 냄새가 나거나 공식 대피 명령이 있으면 지역 당국의 안내를 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如发现损坏、闻到燃气味或收到官方疏散指令，请听从当地政府指引。"
          }
        }
      }
    },
    "pi.action.light" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafif bir sarsıntı. Sakin ol; artçı depremler olabileceğini unutma."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light shaking. Stay calm and remember aftershocks are possible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leichte Erschütterung. Bleib ruhig; Nachbeben sind möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sacudida leve. Mantén la calma; puede haber réplicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secousse légère. Reste calme ; des répliques sont possibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scossa leggera. Mantieni la calma; possono esserci repliche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弱い揺れです。落ち着いて、余震の可能性に注意してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слабые сотрясения. Сохраняйте спокойствие; возможны афтершоки."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اهتزاز خفيف. حافظ على هدوئك وتذكّر أن الهزات الارتدادية ممكنة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελαφριά δόνηση. Μείνε ψύχραιμος· μπορεί να ακολουθήσουν μετασεισμοί."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tremor leve. Mantenha a calma; réplicas são possíveis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guncangan ringan. Tetap tenang; gempa susulan mungkin terjadi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약한 흔들림이에요. 침착하게, 여진 가능성을 기억하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻微震动。保持冷静，注意可能发生余震。"
          }
        }
      }
    },
    "pi.action.moderate" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşyalar düşmüş olabilir. Çevreni kontrol et, gaz ve elektrik kaçağına dikkat et, artçılara hazırlıklı ol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objects may have fallen. Check your surroundings, watch for gas or electrical hazards and be ready for aftershocks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegenstände könnten gefallen sein. Prüfe deine Umgebung, achte auf Gas- oder Stromgefahren und sei auf Nachbeben vorbereitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pueden haber caído objetos. Revisa tu entorno, vigila fugas de gas o problemas eléctricos y prepárate para réplicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des objets ont pu tomber. Vérifie les alentours, attention au gaz et à l'électricité, prépare-toi aux répliques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbero essere caduti oggetti. Controlla l'ambiente, attenzione a gas ed elettricità, preparati alle repliche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物が落ちている可能性があります。周囲を確認し、ガスや電気の異常に注意し、余震に備えてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предметы могли упасть. Осмотритесь, проверьте утечки газа и электричество, будьте готовы к афтершокам."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما سقطت أشياء. تفقّد محيطك، وانتبه لتسرب الغاز أو أعطال الكهرباء، واستعد للهزات الارتدادية."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορεί να έπεσαν αντικείμενα. Έλεγξε τον χώρο, πρόσεξε για διαρροή αερίου ή ηλεκτρικούς κινδύνους και να είσαι έτοιμος για μετασεισμούς."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetos podem ter caído. Verifique o ambiente, atenção a vazamentos de gás e riscos elétricos e prepare-se para réplicas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benda mungkin jatuh. Periksa sekitarmu, waspadai kebocoran gas atau bahaya listrik, dan bersiaplah untuk gempa susulan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물건이 떨어졌을 수 있어요. 주변을 확인하고 가스·전기 위험에 주의하며 여진에 대비하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物品可能已掉落。检查周围环境，注意燃气和用电安全，做好余震准备。"
          }
        }
      }
    },
    "pi.action.none" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu depremi büyük olasılıkla hissetmedin; bir şey yapman gerekmiyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You most likely didn't feel this quake; there's nothing you need to do."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dieses Beben wahrscheinlich nicht gespürt; es gibt nichts zu tun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más probable es que no sintieras este sismo; no necesitas hacer nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n'as très probablement pas ressenti ce séisme ; rien à faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molto probabilmente non hai sentito questo terremoto; non devi fare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この地震はおそらく感じなかったはずです。特に何もする必要はありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
