    "safety.before.bag.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهّز الماء، حقيبة الإسعافات، مصباحاً يدوياً وصوراً من وثائقك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser, Erste-Hilfe-Set, Taschenlampe und Dokumente bereithalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep water, first aid, a flashlight and important documents ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten agua, botiquín, linterna y copias de documentos listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez eau, trousse de secours, lampe torche et copies de papiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni pronti acqua, kit di pronto soccorso, torcia e documenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飲料水、救急用品、懐中電灯、重要書類のコピーを準備します。"
