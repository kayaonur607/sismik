    "intro.assembly.offline.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب الاتجاهات إنترنت؛ بينما لا تحتاجه البوصلة. يعرض «تحديد الاتجاه» الاتجاه والمسافة إلى الهدف باستخدام نظام GPS والبوصلة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegbeschreibungen benötigen Internet; der Kompass nicht. «Orientierung» zeigt dir nur mit GPS und Kompass, in welcher Richtung und wie weit das Ziel entfernt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directions need the internet; a compass doesn't. Find Direction uses only GPS and the compass to show where your target is and how far."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las indicaciones requieren internet; la brújula no. «Orientación» muestra en qué dirección y a qué distancia está el destino usando solo GPS y brújula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'itinéraire nécessite internet ; la boussole non. « Trouver la direction » indique la direction et la distance de la destination avec seulement le GPS et la boussole."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le indicazioni richiedono internet; la bussola no. «Trova direzione» mostra in quale direzione e a quale distanza si trova la destinazione usando solo GPS e bussola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経路案内にはインターネットが必要ですが、コンパスは不要です。「方向を確認」は、GPSとコンパスのみを使用して、目的地の方角と距離を表示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для маршрута нужен интернет; для компаса — нет. Функция «Найти направление» показывает направление и расстояние до цели с помощью GPS и компаса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yol tarifi internet ister; pusula istemez. Yön Bul, hedefin hangi yönde ve ne kadar uzakta olduğunu sadece GPS ve pusulayla gösterir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οδηγίες χρειάζονται διαδίκτυο· η πυξίδα όχι. Η «Εύρεση κατεύθυνσης» δείχνει πού και πόσο μακριά είναι ο στόχος σου μόνο με GPS και πυξίδα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotas precisam de internet; a bússola não. O Encontrar Direção usa só GPS e bússola para mostrar onde está seu destino e a que distância."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petunjuk arah butuh internet; kompas tidak. Cari Arah hanya memakai GPS dan kompas untuk menunjukkan letak dan jarak tujuanmu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길찾기는 인터넷이 필요하지만 나침반은 필요 없습니다. 방향 찾기는 GPS와 나침반만으로 목적지의 방향과 거리를 보여줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导航需要网络，指南针不需要。“寻找方向”仅用 GPS 和指南针显示目标的方位和距离。"
          }
        }
      }
    },
