    "settings.feltCard.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunun ya da yerlerinin 30 km yakınında M3+ ya da hissedilecek kadar güçlü uzak bir deprem olunca listenin başında gösterilir. Karttan kapatabilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown at the top of the list when an M3+ quake hits within 30 km of you or your places, or a distant one is strong enough to be felt. You can dismiss it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint oben in der Liste bei einem Beben ab M3 im Umkreis von 30 km um dich oder deine Orte oder einem fernen, aber spürbaren Beben. Du kannst sie schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece arriba en la lista cuando hay un sismo M3+ a menos de 30 km de ti o de tus lugares, o uno lejano lo bastante fuerte para sentirse. Puedes cerrarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'affiche en haut de la liste lors d'un séisme M3+ à moins de 30 km de toi ou de tes lieux, ou d'un séisme lointain assez fort pour être ressenti. Tu peux la fermer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare in cima alla lista per un terremoto M3+ entro 30 km da te o dai tuoi luoghi, o uno lontano abbastanza forte da essere avvertito. Puoi chiuderla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地や登録地点から 30 km 以内の M3 以上、または揺れを感じるほどの遠方の地震があると、リストの先頭に表示されます。閉じることもできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается вверху списка при землетрясении M3+ в пределах 30 км от вас или ваших мест либо при далёком, но ощутимом. Её можно закрыть."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر أعلى القائمة عند وقوع زلزال M3+ على بعد 30 كم منك أو من أماكنك، أو زلزال بعيد قوي بما يكفي لتشعر به. يمكنك إغلاقها."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται στην κορυφή της λίστας για σεισμό M3+ έως 30 km από εσάς ή τα μέρη σας, ή για μακρινό σεισμό αρκετά ισχυρό ώστε να γίνει αισθητός. Μπορείτε να την κλείσετε."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece no topo da lista quando há um terremoto M3+ a até 30 km de você ou dos seus lugares, ou um distante forte o bastante para ser sentido. Você pode fechá-lo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan di atas daftar saat gempa M3+ terjadi dalam 30 km dari Anda atau tempat Anda, atau gempa jauh yang cukup kuat untuk terasa. Anda bisa menutupnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치나 등록한 장소 30km 이내의 M3 이상 지진, 또는 느낄 만큼 강한 먼 지진이 발생하면 목록 맨 위에 표시됩니다. 닫을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你或你的地点 30 公里内发生 M3+ 地震，或远处地震强到足以有感时，显示在列表顶部。你可以关闭它。"
          }
        }
      }
    },
