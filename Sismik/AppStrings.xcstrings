    "notice.critical.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonun sessizdeyken ya da Odak açıkken güçlü bir deprem bildirimi sesli çalmayabilir. Kritik uyarıları açarak her durumda duy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your phone is on silent or a Focus is on, a strong-quake alert may not make a sound. Turn on critical alerts to hear it no matter what."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist dein iPhone stumm oder ein Fokus aktiv, ertönt eine Warnung vor starken Beben vielleicht nicht. Aktiviere kritische Hinweise, um sie immer zu hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el teléfono está en silencio o con un Enfoque activo, la alerta de un sismo fuerte podría no sonar. Activa las alertas críticas para oírla siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ton téléphone est en silencieux ou en mode Concentration, l'alerte d'un fort séisme peut ne pas sonner. Active les alertes critiques pour l'entendre à coup sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il telefono è silenzioso o una Full immersion è attiva, l'avviso di un forte terremoto potrebbe non suonare. Attiva gli avvisi critici per sentirlo sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マナーモードや集中モード中は、強い地震の通知が鳴らないことがあります。重大な通知をオンにすると、どんなときも音で知らせます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В беззвучном режиме или с включённым фокусированием оповещение о сильном землетрясении может не прозвучать. Включите критические оповещения, чтобы слышать его всегда."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هاتفك صامتًا أو كان وضع التركيز مفعّلًا، فقد لا يصدر تنبيه الزلزال القوي صوتًا. فعّل التنبيهات الحرجة لتسمعه في كل الأحوال."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το τηλέφωνο είναι σε σίγαση ή έχεις ενεργή Εστίαση, η ειδοποίηση ισχυρού σεισμού μπορεί να μην ακουστεί. Ενεργοποίησε τις κρίσιμες ειδοποιήσεις για να την ακούς πάντα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o celular estiver no silencioso ou com um Foco ativo, o alerta de terremoto forte pode não tocar. Ative os alertas críticos para ouvi-lo sempre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ponsel dalam mode senyap atau Fokus aktif, peringatan gempa kuat mungkin tidak berbunyi. Aktifkan peringatan kritis agar selalu terdengar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이 무음이거나 집중 모드가 켜져 있으면 강한 지진 알림이 울리지 않을 수 있어요. 중요 알림을 켜면 언제든 들을 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机处于静音或专注模式时，强震提醒可能不会响铃。开启关键提醒，任何情况下都能听到。"
          }
        }
      }
    },
