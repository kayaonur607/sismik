    "places.felt.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şiddet, depremin büyüklüğü, derinliği ve bu yere uzaklığıyla tahmin edilir. M3.0 altı depremler için yalnızca yarıçap ve büyüklük eşiği geçerlidir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensity is estimated from the quake's magnitude, depth and distance to this place. Below M3.0 only the radius and magnitude threshold apply."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Intensität wird aus Magnitude, Tiefe und Entfernung geschätzt. Unter M3.0 gelten nur Radius und Magnitudenschwelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La intensidad se estima según magnitud, profundidad y distancia a este lugar. Por debajo de M3.0 solo cuentan el radio y el umbral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intensité est estimée d'après la magnitude, la profondeur et la distance. Sous M3.0, seuls le rayon et le seuil comptent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intensità è stimata da magnitudo, profondità e distanza da questo luogo. Sotto M3.0 valgono solo raggio e soglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "震度は地震の規模・深さ・この場所までの距離から推定します。M3.0 未満は半径とマグニチュードの条件のみ適用されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интенсивность оценивается по магнитуде, глубине и расстоянию. Ниже M3.0 действуют только радиус и порог магнитуды."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقدَّر الشدة من قوة الزلزال وعمقه وبعده عن هذا المكان. دون M3.0 يُطبَّق نصف القطر وعتبة القوة فقط."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ένταση εκτιμάται από μέγεθος, βάθος και απόσταση. Κάτω από M3.0 ισχύουν μόνο ακτίνα και όριο μεγέθους."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A intensidade é estimada pela magnitude, profundidade e distância. Abaixo de M3.0 valem só o raio e o limite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensitas diperkirakan dari magnitudo, kedalaman, dan jarak ke tempat ini. Di bawah M3.0 hanya radius dan ambang magnitudo yang berlaku."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진도는 지진의 규모, 깊이, 이곳까지의 거리로 추정합니다. M3.0 미만은 반경과 규모 조건만 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烈度根据震级、深度和到此处的距离估算。M3.0 以下仅适用半径和震级阈值。"
          }
        }
      }
    },
