    "intro.assembly.search.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن المدينة التي تعيش فيها عائلتك؛ يمكنك رؤية أقرب منطقة تجمع قبل الذهاب إلى هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach der Stadt deiner Familie; du kannst den nächstgelegenen Sammelplatz sehen, bevor du dorthin reist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search the city your family lives in and see its nearest assembly areas before you travel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca la ciudad donde vive tu familia; puedes ver el punto de encuentro más cercano antes de ir allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez la ville où vit votre famille ; vous pouvez voir la zone de regroupement la plus proche avant de vous y rendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca la città in cui vive la tua famiglia; puoi vedere il punto di raccolta più vicino prima di andarci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご家族が住む街を検索すると、現地に行く前に最寄りの避難場所を確認できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите город, где живет ваша семья; вы сможете увидеть ближайшую точку сбора еще до поездки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ailenin yaşadığı şehri arat; oraya gitmeden önce en yakın toplanma alanını görebilirsin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζήτησε την πόλη όπου ζει η οικογένειά σου και δες τους κοντινότερους χώρους συγκέντρωσης πριν ταξιδέψεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque a cidade onde sua família mora e veja os pontos de encontro mais próximos antes de viajar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari kota tempat keluargamu tinggal dan lihat titik kumpul terdekatnya sebelum bepergian."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족이 사는 도시를 검색해 가기 전에 가까운 대피 장소를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索家人所在城市，出发前查看附近的集合点。"
          }
        }
      }
    },
