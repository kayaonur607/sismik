    "permissions.location.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لحساب مسافة الزلازل منك، وإظهار مناطق التجمع وموقع الطوارئ الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um die Entfernung von Erdbeben zu Ihnen zu berechnen sowie Sammelstellen und Ihren Notfallstandort anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to calculate the distance of earthquakes to you, show assembly areas, and display your emergency location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para calcular la distancia de los terremotos hacia ti, mostrar zonas de reunión y tu ubicación de emergencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour calculer la distance des séismes par rapport à vous, afficher les points de rassemblement et votre position d'urgence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzato per calcolare la distanza dei terremoti da te, mostrare le aree di raccolta e la tua posizione di emergenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地震のあなたからの距離の計算、避難場所や緊急時の位置情報の表示に使用されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для расчета расстояния от вас до землетрясений, отображения пунктов сбора и вашего местоположения в чрезвычайной ситуации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depremlerin sana olan mesafesini hesaplamak, toplanma alanlarını ve acil durum konumunu göstermek için kullanılır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για τον υπολογισμό της απόστασης των σεισμών από σένα, την εμφάνιση χώρων συγκέντρωσης και της θέσης σου σε έκτακτη ανάγκη."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada para calcular a distância dos terremotos até você, mostrar pontos de encontro e exibir sua localização de emergência."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai untuk menghitung jarak gempa darimu, menampilkan titik kumpul, dan lokasi daruratmu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지진과의 거리 계산, 대피 장소 표시, 비상 위치 표시에 쓰입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于计算地震与你的距离、显示集合点以及你的紧急位置。"
          }
        }
      }
    },
