    "pi.timing.gap" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk titreşimden ana sarsıntıya yaklaşık %@ saniye vardı. Erken uyarı sistemleri bu farkı kullanır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There were about %@ seconds between the first tremor and the main shaking. Early-warning systems use this gap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen erster Welle und Hauptstoß lagen etwa %@ Sekunden. Frühwarnsysteme nutzen diese Lücke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubo unos %@ segundos entre el primer temblor y la sacudida principal. Los sistemas de alerta temprana usan este margen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %@ secondes séparaient la première onde de la secousse principale. Les systèmes d'alerte précoce exploitent cet écart."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra la prima onda e la scossa principale ci sono stati circa %@ secondi. I sistemi di allerta precoce sfruttano questo intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期微動から主要動まで約 %@ 秒ありました。緊急地震速報はこの差を利用しています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Между первой волной и основным толчком прошло около %@ с. Системы раннего оповещения используют этот интервал."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان بين الهزة الأولى والاهتزاز الرئيسي نحو %@ ثانية. تستخدم أنظمة الإنذار المبكر هذا الفارق."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεσολάβησαν περίπου %@ δευτερόλεπτα από την πρώτη δόνηση ως την κύρια. Τα συστήματα έγκαιρης προειδοποίησης αξιοποιούν αυτό το κενό."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houve cerca de %@ segundos entre o primeiro tremor e o principal. Sistemas de alerta antecipado usam esse intervalo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada sekitar %@ detik antara getaran pertama dan guncangan utama. Sistem peringatan dini memanfaatkan jeda ini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초기 진동과 주요 흔들림 사이에 약 %@초가 있었어요. 지진 조기경보는 이 차이를 이용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初始震动与主震动之间约有 %@ 秒。地震预警系统正是利用这一时间差。"
          }
        }
      }
    },
