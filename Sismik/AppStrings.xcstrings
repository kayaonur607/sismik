    "family.meeting.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مكانًا مفتوحًا بعيدًا عن المباني واتفق عليه مسبقًا مع عائلتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen offenen Ort fern von Gebäuden und sprich ihn vorher mit deiner Familie ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an open place away from buildings and agree on it with your family in advance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un lugar abierto lejos de edificios y acuérdalo antes con tu familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un lieu dégagé, loin des bâtiments, et convenez-en à l'avance avec votre famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un luogo aperto lontano dagli edifici e concordalo prima con la famiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建物から離れた開けた場所を選び、家族と事前に決めておきましょう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите открытое место вдали от зданий и заранее договоритесь о нём с семьёй."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binalardan uzak, açık bir yer seç ve aile bireyleriyle önceden konuş."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε ανοιχτό χώρο μακριά από κτίρια και συμφώνησέ τον εκ των προτέρων με την οικογένειά σου."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um lugar aberto longe de prédios e combine com sua família antes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempat terbuka jauh dari bangunan dan sepakati dengan keluargamu sebelumnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
