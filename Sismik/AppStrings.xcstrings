    "intro.emergency.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا حوصرت تحت الأنقاض أو احتجت إلى المساعدة، فإن الأدوات هنا تستخدم العتاد الخاص بهاتفك — ولا يتطلب أي منها الاتصال بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie unter Trümmern gefangen sind oder Hilfe benötigen, nutzen diese Werkzeuge die Hardware Ihres Telefons — keines davon benötigt Internet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're trapped or need help, the tools here use your phone's hardware — none of them need the internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quedas atrapado bajo los escombros o necesitas ayuda, las herramientas aquí usan el hardware de tu teléfono; ninguna requiere internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous êtes coincé sous des décombres ou avez besoin d'aide, les outils ici utilisent le matériel de votre téléphone — aucun ne nécessite internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rimani bloccato sotto le macerie o hai bisogno di aiuto, gli strumenti qui utilizzano l'hardware del tuo telefono: nessuno richiede internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "がれきの下に閉じ込められた場合や助けが必要な場合、ここにあるツールは電話のハードウェアを使用します。インターネットは不要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы окажетесь под завалами или вам понадобится помощь, эти инструменты используют аппаратное обеспечение вашего телефона — ни один из них не требует интернета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkaz altında kalırsan ya da yardıma ihtiyacın olursa buradaki araçlar telefonun donanımını kullanır — hiçbiri internet gerektirmez."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν είσαι παγιδευμένος ή χρειάζεσαι βοήθεια, τα εργαλεία εδώ χρησιμοποιούν το υλικό του τηλεφώνου — κανένα δεν χρειάζεται διαδίκτυο."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver preso ou precisar de ajuda, as ferramentas aqui usam o hardware do telefone — nenhuma precisa de internet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kamu terjebak atau butuh bantuan, alat di sini memakai perangkat keras ponselmu — tidak ada yang butuh internet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갇혔거나 도움이 필요할 때, 여기 도구는 휴대폰 하드웨어만 씁니다. 인터넷이 필요 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若被困或需要帮助，这里的工具只用手机硬件——都不需要网络。"
          }
        }
      }
    },
    "intro.emergency.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكالمات الطوارئ وأدوات الصوت والضوء ومشاركة الموقع في شاشة واحدة. تعرّف عليها قبل الحاجة إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notruf, Ton- und Lichtwerkzeuge sowie Standortfreigabe auf einem Bildschirm. Mach dich vorher damit vertraut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergency calls, sound and light tools, and location sharing on one screen. Get familiar with them before you need them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llamadas de emergencia, sonido, luz y ubicación en una pantalla. Conócelos antes de necesitarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appels d’urgence, son, lumière et partage de position sur un écran. Familiarisez-vous avec eux à l’avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiamate di emergenza, suoni, luci e condivisione della posizione in una schermata. Scoprili prima di averne bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急通報、音と光のツール、位置情報の共有をひとつの画面に。必要になる前に確認しましょう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экстренные вызовы, звук, свет и отправка местоположения на одном экране. Ознакомьтесь с ними заранее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acil çağrı, ses ve ışık araçları ile konum paylaşımı aynı ekranda. İhtiyacın olmadan önce nerede olduklarını öğren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλήσεις έκτακτης ανάγκης, εργαλεία ήχου και φωτός και κοινοποίηση τοποθεσίας σε μία οθόνη. Εξοικειώσου μαζί τους πριν τα χρειαστείς."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chamadas de emergência, ferramentas de som e luz e compartilhamento de localização em uma tela. Conheça-as antes de precisar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan darurat, alat suara dan cahaya, serta berbagi lokasi dalam satu layar. Kenali sebelum kamu membutuhkannya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급 전화, 소리·빛 도구, 위치 공유가 한 화면에. 필요해지기 전에 익혀 두세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧急电话、声光工具和位置分享集于一屏。请在需要之前先熟悉它们。"
          }
        }
      }
    },
