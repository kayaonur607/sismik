    "safety.before.plan.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حددوا معاً نقطة الالتقاء وأرقام الطوارئ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treffpunkte und Notfallkontakte gemeinsam festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide on a meeting point and communication plan together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acuerda puntos de reunión y contactos de emergencia."
          }
