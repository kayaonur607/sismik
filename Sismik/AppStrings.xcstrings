    "safety.during.cover.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احمِ رأسك ورقبتك بذراعيك جيداً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützen Sie Kopf und Nacken mit Ihren Armen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cover your head and neck, protecting them with your arms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege tu cabeza y cuello con tus brazos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégez votre tête et votre nuque avec vos bras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi testa e collo con le braccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕や手荷物などで頭部と首をしっかり保護します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитите голову и шею руками."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baş ve boynunu kollarınla koruyarak kapan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάλυψε κεφάλι και λαιμό, προστατεύοντάς τα με τα χέρια."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubra a cabeça e o pescoço, protegendo-os com os braços."
