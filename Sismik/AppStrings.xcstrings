    "premiumPreview.map.feature.location.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض المسافة إلى مركز الزلزال، وتوجيه الخريطة إلى موقعك، والانتقال إلى تفاصيل الزلزال"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine Entfernung zum Epizentrum, zentriere die Karte auf deinen Standort, rufe Erdbeben-Details auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your distance to the epicenter, center the map to your location, go to earthquake details"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la distancia al epicentro, centra el mapa en tu ubicación y accede a los detalles del terremoto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez votre distance par rapport à l'épicentre, centrez la carte sur votre position et accédez aux détails du séisme"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi la distanza dall'epicentro, centra la mappa sulla tua posizione e passa ai dettagli del terremoto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "震央までの距離を表示し、マップを現在地に移動して、地震の詳細画面に移動"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите расстояние до эпицентра, перемещайте карту к своему местоположению и переходите к деталям землетрясения"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
