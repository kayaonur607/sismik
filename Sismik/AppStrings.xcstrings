    "settings.list.defaultSource.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح القائمة بهذا المصدر؛ ويحدده خيار «تلقائي» حسب منطقتك. أما المصدر المختار داخل القائمة فيسري على تلك الجلسة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste startet mit dieser Quelle; „Automatisch“ wählt sie anhand deiner Region. Eine im Listenbereich gewählte Quelle gilt nur für die aktuelle Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list opens with this source; “Automatic” picks it based on your region. A source chosen in the list applies to that session only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista se abre con esta fuente; «Automático» la elige según tu región. La fuente elegida en la lista solo afecta a esa sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste s'ouvre avec cette source ; « Automatique » la choisit selon votre région. Une source choisie dans la liste ne vaut que pour la session en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'elenco si apre con questa fonte; «Automatico» la sceglie in base alla tua regione. La fonte scelta nell'elenco vale solo per quella sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストはこの情報源で開きます。「自動」では地域に応じて選ばれます。リストで選んだ情報源はそのセッションのみ有効です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список открывается с этим источником; «Автоматически» выбирает его по вашему региону. Источник, выбранный в списке, действует только для текущего сеанса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama açıldığında liste bu kaynakla gelir; otomatik seçimde bölgene göre belirlenir. Listedeki kaynak yalnızca o oturum için geçerlidir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λίστα ανοίγει με αυτή την πηγή· το «Αυτόματο» την επιλέγει ανάλογα με την περιοχή σου. Πηγή που επιλέγεται στη λίστα ισχύει μόνο για εκείνη τη χρήση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista abre com esta fonte; “Automático” escolhe conforme sua região. Uma fonte escolhida na lista vale só para aquela sessão."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar dibuka dengan sumber ini; “Otomatis” memilihnya sesuai wilayahmu. Sumber yang dipilih di daftar hanya berlaku untuk sesi itu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록은 이 출처로 열립니다. ‘자동’은 지역에 맞춰 고릅니다. 목록에서 고른 출처는 그 세션에만 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表默认使用此来源；“自动”会根据你所在地区选择。在列表中选的来源仅对本次使用有效。"
          }
        }
      }
    },
