    "places.felt.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzaktaki güçlü depremler de, bu yerde hissedilecekse bildirilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distant strong quakes are alerted too, if they'll be felt at this place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch starke, ferne Beben, wenn sie hier spürbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También sismos fuertes lejanos si se sentirán en este lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séismes forts et lointains aussi, s'ils seront ressentis ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche i terremoti forti e lontani, se saranno avvertiti qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠くの強い地震でも、この場所で揺れを感じるなら通知します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильные далёкие толчки тоже, если они будут здесь ощутимы."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرسَل أيضًا تنبيهات للزلازل القوية البعيدة إن كانت ستُحَس هنا."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και για ισχυρούς μακρινούς σεισμούς, αν θα γίνουν αισθητοί εδώ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também terremotos fortes distantes, se forem sentidos neste lugar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gempa kuat yang jauh juga diberitahukan jika akan terasa di tempat ini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼 곳의 강한 지진도 이곳에서 느껴진다면 알립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远处的强震若在此处有震感也会提醒。"
          }
        }
      }
    },
