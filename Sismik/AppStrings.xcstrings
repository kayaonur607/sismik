    "ob3.sources.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı depremi birden çok ajans yayımlarsa kayıtlar birleşir: deprem listede ve haritada bir kez, bölgenin resmî ajansının verisiyle görünür."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When several agencies report the same quake, their records merge: it appears once in the list and on the map, with the regional agency's data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden mehrere Dienste dasselbe Beben, werden die Einträge zusammengeführt: Es erscheint einmal in Liste und Karte, mit den Daten der regionalen Behörde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si varias agencias publican el mismo sismo, los registros se unen: aparece una sola vez en la lista y el mapa, con los datos de la agencia regional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand plusieurs agences publient le même séisme, leurs données fusionnent : il apparaît une seule fois dans la liste et sur la carte, avec les données de l'agence régionale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se più agenzie pubblicano lo stesso terremoto, i dati si uniscono: compare una sola volta in lista e sulla mappa, con i dati dell'agenzia regionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ地震を複数の機関が発表すると記録は統合され、リストと地図に地域の公式機関のデータで1回だけ表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если одно землетрясение публикуют несколько агентств, записи объединяются: оно показывается в списке и на карте один раз, с данными регионального агентства."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تنشر عدة وكالات الزلزال نفسه تُدمج السجلات: يظهر مرة واحدة في القائمة وعلى الخريطة ببيانات الوكالة الإقليمية."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν πολλοί φορείς αναφέρουν τον ίδιο σεισμό, οι εγγραφές ενώνονται: εμφανίζεται μία φορά σε λίστα και χάρτη, με τα δεδομένα του περιφερειακού φορέα."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando várias agências publicam o mesmo terremoto, os registros se unem: ele aparece uma vez na lista e no mapa, com os dados da agência regional."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika beberapa lembaga melaporkan gempa yang sama, datanya digabung: gempa tampil sekali di daftar dan peta, dengan data lembaga regional."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 기관이 같은 지진을 발표하면 기록이 합쳐져, 목록과 지도에 지역 공식 기관의 데이터로 한 번만 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多家机构发布同一地震时记录会合并：它在列表和地图上只出现一次，并采用当地官方机构的数据。"
          }
        }
      }
    },
    "ob3.sources.filter.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm kaynakları ya da tek bir ajansı seç; seçimin bir sonraki açılışta hatırlanır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick all sources or a single agency; your choice is remembered next time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle alle Quellen oder einen einzelnen Dienst; deine Auswahl bleibt gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige todas las fuentes o una sola agencia; tu elección se recuerda la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis toutes les sources ou une seule agence ; ton choix est mémorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tutte le fonti o una sola agenzia; la scelta viene ricordata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての情報源か1つの機関を選べます。選択は次回も保持されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите все источники или одно агентство — выбор сохранится."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كل المصادر أو وكالة واحدة؛ يُحفظ اختيارك للمرة القادمة."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε όλες τις πηγές ή έναν φορέα· η επιλογή σου θυμάται την επόμενη φορά."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha todas as fontes ou uma só agência; sua escolha fica salva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih semua sumber atau satu lembaga; pilihanmu diingat di lain waktu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 출처 또는 한 기관을 고르세요. 선택은 다음에도 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择全部来源或单一机构，下次打开时会记住你的选择。"
          }
        }
      }
    },
