    },
    "intro.welcome.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعرض الزلازل واعثر على نقاط التجمع القريبة وأدوات الطوارئ في مكان واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkunde Erdbeben, finde Sammelplätze in der Nähe und greife auf Notfallwerkzeuge zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore earthquakes, find nearby assembly areas and keep emergency tools close at hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta terremotos, encuentra puntos de reunión cercanos y accede a herramientas de emergencia."
