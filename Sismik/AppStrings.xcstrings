          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarize current %@ seismic activity with scientific parameters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuma la actividad sísmica actual en %@ con parámetros científicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumez l'activité sismique actuelle en %@ avec des paramètres scientifiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riepiloga l'attività sismica attuale in %@ con parametri scientifici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の現在の地震活動を科学的パラメータで要約します。"
