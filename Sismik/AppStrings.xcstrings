    "Takip edilen ana depremin olası artçıları sunucudan bildirilecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم الإخطار بالهزات الارتدادية المحتملة للزلزال الرئيسي المتتبع من الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mögliche Nachbeben des verfolgten Hauptbebens werden vom Server gemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possible aftershocks of the tracked event will be delivered by the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las posibles réplicas del terremoto principal seguido se notificarán desde el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les répliques possibles du séisme principal suivi seront notifiées depuis le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le possibili repliche del terremoto principale monitorato verranno notificate dal server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追跡中の本震の予想される余震がサーバーから通知されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О возможных афтершоках отслеживаемого главного землетрясения будет сообщено с сервера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takip edilen ana depremin olası artçıları sunucudan bildirilecek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιθανοί μετασεισμοί του συμβάντος που παρακολουθείς θα αποστέλλονται από τον διακομιστή."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possíveis réplicas do evento acompanhado serão enviadas pelo servidor."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemungkinan gempa susulan dari kejadian yang dipantau akan dikirim oleh server."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적 중인 이벤트의 여진은 서버가 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所追踪事件的可能余震将由服务器推送。"
          }
        }
      }
    },
