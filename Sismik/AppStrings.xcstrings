          }
        }
      }
    },
    "firstaid.hub.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النزيف، الإنعاش، الكسور، الانضغاط؛ دون إنترنت"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blutungen, Herzdruckmassage, Brüche, Quetschungen; offline"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleeding, CPR, fractures, crush injuries; works offline"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemorragias, RCP, fracturas, aplastamiento; sin conexión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hémorragies, RCP, fractures, écrasement ; hors ligne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emorragie, RCP, fratture, schiacciamento; offline"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出血・心肺蘇生・骨折・挫滅、オフラインで使用可"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кровотечение, СЛР, переломы, сдавление; без интернета"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanama, kalp masajı, kırık, ezilme; internetsiz"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αιμορραγία, ΚΑΡΠΑ, κατάγματα, συνθλίψεις· λειτουργεί χωρίς σύνδεση"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangramento, RCP, fraturas, esmagamento; funciona offline"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdarahan, RJP, patah tulang, cedera terjepit; berfungsi offline"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출혈, 심폐소생술, 골절, 압궤 손상 · 오프라인 사용 가능"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出血、心肺复苏、骨折、挤压伤；可离线使用"
          }
        }
      }
    },
    "firstaid.shock.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدّده على ظهره؛ وإن لم تكن الساقان والوركان مصابة فارفع الساقين نحو 30 سم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Rücken legen; bei unverletzten Beinen und Hüfte die Beine etwa 30 cm anheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay them on their back; if the legs and hips are uninjured, raise the legs about 30 cm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túmbala boca arriba; si piernas y cadera no están heridas, eleva las piernas unos 30 cm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allongez la personne sur le dos ; si jambes et hanches sont indemnes, surélevez les jambes d'environ 30 cm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stendila sulla schiena; se gambe e bacino non sono feriti, solleva le gambe di circa 30 cm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あお向けに寝かせ、脚や腰にけががなければ脚を30 cmほど上げる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уложите на спину; если ноги и таз не травмированы, приподнимите ноги примерно на 30 см."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırtüstü yatır; bacak ya da kalçada yaralanma yoksa bacaklarını 30 cm kadar kaldır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξάπλωσέ τον ανάσκελα· αν πόδια και λεκάνη δεν έχουν τραυματιστεί, σήκωσε τα πόδια περίπου 30 cm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deite a pessoa de costas; se pernas e quadril não estiverem feridos, eleve as pernas cerca de 30 cm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baringkan telentang; jika kaki dan panggul tidak cedera, angkat kaki sekitar 30 cm."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "똑바로 눕히고, 다리와 골반에 부상이 없으면 다리를 약 30 cm 올리세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使其仰卧；若腿部和髋部未受伤，将双腿抬高约 30 厘米。"
          }
        }
      }
    },
    "firstaid.shock.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غطِّه وافرش شيئًا تحته للحفاظ على حرارة جسمه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zudecken und etwas unterlegen, um die Körperwärme zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cover them and put something underneath to keep them warm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrígala y pon algo debajo para mantener el calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couvrez la personne et isolez-la du sol pour la garder au chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coprila e metti qualcosa sotto per mantenerla al caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を覆い、下にも何か敷いて体温を保つ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укройте и подстелите что-нибудь снизу, чтобы сохранить тепло."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üstünü ört, altına da bir şey ser; vücut ısısını koru."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σκέπασέ τον και βάλε κάτι από κάτω για να κρατηθεί ζεστός."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubra a pessoa e coloque algo embaixo para mantê-la aquecida."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selimuti dan beri alas di bawahnya agar tetap hangat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덮어 주고 아래에도 무언가를 깔아 체온을 유지하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给其盖好并在身下垫东西保暖。"
          }
        }
      }
    },
    "firstaid.shock.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تعطه طعامًا أو شرابًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu essen oder zu trinken geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't give food or drink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No le des comida ni bebida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne donnez ni à boire ni à manger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non dare cibo né bevande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飲食物は与えない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не давайте еду и питьё."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yiyecek ya da içecek verme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη δίνεις φαγητό ή νερό."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dê comida nem bebida."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan beri makan atau minum."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식이나 물을 주지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要给予食物或饮水。"
          }
        }
      }
    },
    "firstaid.shock.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راقب التنفس والوعي باستمرار، واتصل بالطوارئ وابقَ بجانبه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmung und Bewusstsein laufend prüfen, Notruf wählen und bei der Person bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep checking breathing and consciousness, call emergency services and stay with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila respiración y consciencia, llama a emergencias y no te separes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez respiration et conscience, appelez les secours et restez auprès de la personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla di continuo respiro e coscienza, chiama i soccorsi e resta accanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸と意識を見守り続け、救急に通報してそばを離れない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постоянно следите за дыханием и сознанием, вызовите скорую и не уходите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soluğu ve bilinci sürekli izle, 112'yi ara ve yanından ayrılma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγχε συνεχώς αναπνοή και συνείδηση, κάλεσε βοήθεια και μείνε δίπλα του."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue verificando respiração e consciência, ligue para a emergência e fique com a pessoa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terus periksa napas dan kesadaran, hubungi layanan darurat, dan tetap di sampingnya."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡과 의식을 계속 확인하고, 긴급 서비스에 연락한 뒤 곁에 머무세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续观察呼吸和意识，拨打急救电话并守在身边。"
          }
        }
      }
    },
    "firstaid.shock.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلد شاحب بارد متعرق؛ ونبض سريع وضعيف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blasse, kalte, schweißige Haut; schneller, schwacher Puls."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pale, cold, sweaty skin; fast, weak pulse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piel pálida, fría y sudorosa; pulso rápido y débil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peau pâle, froide et moite ; pouls rapide et faible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelle pallida, fredda e sudata; polso rapido e debole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "青白く冷たい汗ばんだ肌、速くて弱い脈。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бледная, холодная, влажная кожа; частый слабый пульс."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soluk, soğuk ve terli cilt; hızlı ve zayıf nabız."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χλωμό, κρύο, ιδρωμένο δέρμα· γρήγορος, αδύναμος σφυγμός."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pele pálida, fria e suada; pulso rápido e fraco."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulit pucat, dingin, berkeringat; nadi cepat dan lemah."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창백하고 차갑고 땀에 젖은 피부, 빠르고 약한 맥박."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮肤苍白、湿冷；脉搏快而弱。"
          }
        }
      }
    },
