    "notice.location.body.ask" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınındaki depremleri, uzaklığını ve hissedebileceğin depremleri gösterebilmemiz için konumuna izin ver."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location so we can show quakes near you, how far away they are and the ones you might feel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standort, damit wir Beben in deiner Nähe, ihre Entfernung und spürbare Beben zeigen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la ubicación para mostrarte los sismos cercanos, su distancia y los que podrías sentir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise la position pour voir les séismes proches, leur distance et ceux que tu pourrais ressentir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti la posizione per vedere i terremoti vicini, la loro distanza e quelli che potresti sentire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報を許可すると、近くの地震や距離、揺れを感じそうな地震を表示できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к геопозиции, чтобы видеть землетрясения рядом, расстояние до них и те, что вы можете ощутить."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالموقع لنعرض لك الزلازل القريبة ومسافتها والزلازل التي قد تشعر بها."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε την τοποθεσία για να βλέπεις σεισμούς κοντά σου, την απόστασή τους και όσους μπορεί να νιώσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a localização para ver terremotos perto de você, a distância e os que você pode sentir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan lokasi agar kami bisa menampilkan gempa di dekatmu, jaraknya, dan gempa yang mungkin kamu rasakan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 허용하면 주변 지진, 거리, 느낄 수 있는 지진을 보여 드려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许位置权限，即可查看附近地震、距离以及你可能感受到的地震。"
          }
        }
      }
    },
    "notice.location.body.denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum izni kapalı olduğu için yakınındaki depremleri ve uzaklığını gösteremiyoruz. Ayarlar'dan açabilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is off, so we can't show quakes near you or how far away they are. You can turn it on in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort ist aus, daher können wir Beben in deiner Nähe und ihre Entfernung nicht zeigen. Du kannst ihn in den Einstellungen aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación está desactivada, así que no podemos mostrar sismos cercanos ni su distancia. Puedes activarla en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position est désactivée : impossible d'afficher les séismes proches et leur distance. Active-la dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione è disattivata, quindi non possiamo mostrare i terremoti vicini né la distanza. Puoi attivarla in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報がオフのため、近くの地震や距離を表示できません。設定からオンにできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция выключена, поэтому мы не можем показать землетрясения рядом и расстояние до них. Включите её в Настройках."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع متوقف، لذا لا يمكننا عرض الزلازل القريبة ومسافتها. يمكنك تفعيله من الإعدادات."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοποθεσία είναι ανενεργή, οπότε δεν μπορούμε να δείξουμε σεισμούς κοντά σου και την απόστασή τους. Ενεργοποίησέ τη στις Ρυθμίσεις."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização está desativada, então não podemos mostrar terremotos perto de você nem a distância. Ative em Ajustes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi nonaktif, jadi kami tidak bisa menampilkan gempa di dekatmu dan jaraknya. Kamu bisa mengaktifkannya di Pengaturan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치가 꺼져 있어 주변 지진과 거리를 보여 드릴 수 없어요. 설정에서 켤 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置权限已关闭，无法显示附近地震及距离。可在设置中开启。"
          }
        }
      }
    },
