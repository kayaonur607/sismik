    "remote.update.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sürümde deprem bilgilerini ya da bildirimleri etkileyen bir sorun var. Doğru ve zamanında bilgi alman için yeni sürümü yükle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version has an issue that affects earthquake data or alerts. Install the new version to get accurate, timely information."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version hat ein Problem, das Erdbebendaten oder Warnungen betrifft. Installiere die neue Version für genaue, rechtzeitige Infos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión tiene un problema que afecta a los datos de sismos o a las alertas. Instala la nueva versión para recibir información precisa y a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version a un problème qui touche les données sismiques ou les alertes. Installe la nouvelle version pour des infos exactes et à temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione ha un problema che riguarda i dati sui terremoti o gli avvisi. Installa la nuova versione per informazioni precise e tempestive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンには地震情報や通知に影響する問題があります。正確でタイムリーな情報を受け取るため、新しいバージョンをインストールしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой версии есть проблема, влияющая на данные о землетрясениях или уведомления. Установите новую версию, чтобы получать точную информацию вовремя."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد في هذا الإصدار خلل يؤثر في بيانات الزلازل أو التنبيهات. ثبّت الإصدار الجديد لتحصل على معلومات دقيقة وفي وقتها."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η έκδοση έχει πρόβλημα που επηρεάζει τα δεδομένα σεισμών ή τις ειδοποιήσεις. Εγκατάστησε τη νέα έκδοση για ακριβή και έγκαιρη ενημέρωση."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão tem um problema que afeta os dados de terremotos ou os alertas. Instale a nova versão para receber informações precisas e no tempo certo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi ini memiliki masalah yang memengaruhi data gempa atau peringatan. Pasang versi baru agar mendapat informasi yang akurat dan tepat waktu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전에는 지진 정보나 알림에 영향을 주는 문제가 있습니다. 정확하고 제때 정보를 받으려면 새 버전을 설치하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本存在影响地震数据或提醒的问题。请安装新版本，以获得准确及时的信息。"
          }
        }
      }
    },
