    "permissions.critical.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المواقع المحددة، يرن الهاتف حتى في الوضع الصامت عند حدوث زلازل تتجاوز القوة التي حددتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den ausgewählten Orten klingelt das Telefon auch im Lautlos-Modus bei Erdbeben über der festgelegten Stärke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your selected locations, your phone rings even in silent mode for earthquakes above your set magnitude."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las ubicaciones seleccionadas, el teléfono sonará incluso en modo silencioso para sismos superiores a la magnitud establecida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les lieux sélectionnés, le téléphone sonne même en mode silencieux pour les séismes supérieurs à la magnitude définie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle posizioni selezionate, il telefono suona anche in modalità silenziosa per i terremoti superiori alla magnitudo impostata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した場所で設定した規模を超える地震が発生した場合、マナーモード中でもスマートフォンが鳴ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В выбранных местах телефон будет звонить даже в бесшумном режиме при землетрясениях выше заданной магнитуды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin yerlerde, belirlediğin büyüklüğün üstündeki depremlerde telefon sessizdeyken de çalar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις τοποθεσίες που επιλέγεις, το τηλέφωνο χτυπά ακόμη και στη σίγαση για σεισμούς πάνω από το μέγεθος που όρισες."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos lugares escolhidos, seu telefone toca mesmo no silencioso para terremotos acima da magnitude definida."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di lokasi pilihanmu, ponsel tetap berbunyi meski senyap untuk gempa di atas magnitudo yang kamu tetapkan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 장소에서 정한 규모 이상의 지진이 나면 무음 모드에서도 휴대폰이 울립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你选择的地点，超过设定震级的地震即使在静音模式下也会响铃。"
          }
        }
      }
    },
