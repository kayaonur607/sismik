    "intro.assembly.filter.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقل بين منطقة التجمع، المستشفى، المركز الصحي، الصيدلية والسوبرماركت باستخدام الشرائح العلوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle mit den oberen Chips zwischen Sammelplatz, Krankenhaus, Gesundheitszentrum, Apotheke und Supermarkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the chips at the top to switch between assembly areas, hospitals, clinics, pharmacies and stores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia entre punto de encuentro, hospital, centro de salud, farmacia y supermercado usando los chips superiores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez d'une zone de regroupement, un hôpital, un centre de santé, une pharmacie à un supermarché grâce aux puces supérieures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa da punto di raccolta, ospedale, centro medico, farmacia e supermercato utilizzando i chip in alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上部のチップを使って、避難場所、病院、診療所、薬局、スーパーを切り替えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайтесь между точкой сбора, больницей, поликлиникой, аптекой и магазином с помощью чипов вверху."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üstteki çiplerle toplanma alanı, hastane, sağlık ocağı, eczane ve market arasında geçiş yap."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποίησε τα κουμπιά επάνω για εναλλαγή μεταξύ χώρων συγκέντρωσης, νοσοκομείων, ιατρείων, φαρμακείων και καταστημάτων."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use os botões no topo para alternar entre pontos de encontro, hospitais, clínicas, farmácias e lojas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan tombol di atas untuk beralih antara titik kumpul, rumah sakit, klinik, apotek, dan toko."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위쪽 버튼으로 대피 장소, 병원, 의원, 약국, 상점을 전환하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用顶部按钮在集合点、医院、诊所、药店和商店之间切换。"
          }
        }
      }
    },
