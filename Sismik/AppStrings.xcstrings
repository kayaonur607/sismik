    "%@ güncel sismik etkinliği bilimsel parametrelerle özetle." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلخيص النشاط الزلزالي الحالي في %@ بالمعايير العلمية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
