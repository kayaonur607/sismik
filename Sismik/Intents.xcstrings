    "intent.latest.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you the most recent earthquake above a magnitude and the largest of the last 24 hours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli bir büyüklüğün üzerindeki en son depremi ve son 24 saatin en büyüğünü söyler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt das letzte Erdbeben über einer bestimmten Magnitude und das stärkste der letzten 24 Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te indica el terremoto más reciente por encima de una magnitud y el mayor de las últimas 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique le séisme le plus récent au-delà d'une magnitude donnée et le plus fort des dernières 24 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il terremoto più recente sopra una certa magnitudo e il più forte delle ultime 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したマグニチュード以上の最新の地震と、過去24時間で最大の地震を知らせます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает о последнем землетрясении выше заданной магнитуды и о самом сильном за последние 24 часа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بأحدث زلزال تتجاوز قوته حدًا معينًا وأقوى زلزال خلال آخر 24 ساعة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σας ενημερώνει για τον πιο πρόσφατο σεισμό πάνω από ένα μέγεθος και τον ισχυρότερο του τελευταίου 24ώρου."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa o terremoto mais recente acima de uma magnitude e o maior das últimas 24 horas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu gempa terbaru di atas magnitudo tertentu dan gempa terbesar dalam 24 jam terakhir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 규모 이상의 최근 지진과 지난 24시간 동안 가장 큰 지진을 알려줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你高于指定震级的最新地震，以及过去 24 小时内最大的地震。"
          }
        }
      }
    },
