    "intent.emergency.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Sismik on the emergency screen: 112 call, whistle, flashlight and location sharing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sismik'i acil durum ekranında açar: 112 araması, düdük, fener ve konum paylaşımı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Sismik im Notfallbildschirm: Notruf, Pfeife, Taschenlampe und Standortfreigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Sismik en la pantalla de emergencia: llamada de emergencia, silbato, linterna y compartir ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Sismik sur l'écran d'urgence : appel d'urgence, sifflet, lampe torche et partage de position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Sismik nella schermata di emergenza: chiamata di emergenza, fischietto, torcia e condivisione della posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sismikを緊急画面で開きます：緊急通報、ホイッスル、ライト、位置情報の共有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Sismik на экране экстренной помощи: экстренный вызов, свисток, фонарик и отправка геопозиции."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Sismik على شاشة الطوارئ: اتصال الطوارئ والصافرة والمصباح ومشاركة الموقع."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει το Sismik στην οθόνη έκτακτης ανάγκης: κλήση έκτακτης ανάγκης, σφυρίχτρα, φακός και κοινοποίηση τοποθεσίας."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Sismik na tela de emergência: chamada de emergência, apito, lanterna e compartilhamento de localização."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Sismik di layar darurat: panggilan darurat, peluit, senter, dan berbagi lokasi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sismik을 긴급 화면으로 엽니다: 긴급 전화, 호루라기, 손전등, 위치 공유."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在紧急页面打开 Sismik：紧急呼叫、哨子、手电筒和位置共享。"
          }
        }
      }
    },
